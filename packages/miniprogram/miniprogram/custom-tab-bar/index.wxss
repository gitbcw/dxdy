.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 28rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: transparent;
  box-sizing: border-box;
}

.tabbar {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 8rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 44rpx rgba(32, 74, 58, 0.16);
  backdrop-filter: blur(18rpx);
  box-sizing: border-box;
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 0;
  height: 86rpx;
  padding: 10rpx 8rpx;
  border-radius: 999rpx;
  color: #7d8782;
  font-size: 22rpx;
  box-sizing: border-box;
}

.tab-item.active {
  color: #176f56;
  font-weight: 800;
  background: #eef8f3;
}

.tab-item.active::before {
  display: none;
}

.tab-label {
  line-height: 1;
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  opacity: 0.62;
}

.tab-item.active .tab-icon {
  opacity: 1;
}
