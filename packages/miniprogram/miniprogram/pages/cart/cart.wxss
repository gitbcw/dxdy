/* cart.wxss - 大熊动医华南医学检验实验室 - Cart Page */
/*Design: Clinical Precision meets Warm Professionalism*/

.cart-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  padding-bottom: 248rpx;
  box-sizing: border-box;
}

/* ============ 顶部导航 ============ */
.cart-header {
  background: transparent;
  padding: 34rpx 28rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: none;
  position: sticky;
  top: 0;
  z-index: 100;
}

.cart-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #17231f;
  letter-spacing: 0;
}

.cart-count {
  font-size: 24rpx;
  color: #7d8782;
  margin-left: 16rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: #176f56;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 10rpx 24rpx rgba(32, 98, 76, 0.08);
  transition: all 0.2s ease;
}

.clear-btn:active {
  background: rgba(220, 53, 69, 0.1);
  color: var(--color-error);
}

/* ============ 购物车列表 ============ */
.cart-list {
  padding: 20rpx 28rpx;
}

.cart-item {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  gap: 16rpx;
  transition: all 0.2s ease;
  border: 1rpx solid #edf1ee;
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
  position: relative;
}

.cart-item:active {
  transform: scale(0.99);
}

/* 商品图片 */
.item-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #eef8f3;
  overflow: hidden;
}

.image-placeholder {
  width: 48rpx;
  height: 48rpx;
  position: relative;
}

.placeholder-hexagon {
  width: 100%;
  height: 100%;
  border: 2rpx solid var(--color-primary);
  border-radius: 6rpx;
  transform: rotate(45deg);
  opacity: 0.3;
}

/* 商品信息 */
.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #17231f;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-product-image {
  width: 100%;
  height: 100%;
}

.item-spec {
  font-size: 22rpx;
  color: #7d8782;
  margin-top: 6rpx;
}

/* 数量和价格 */
.item-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 12rpx;
}

.item-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-current {
  font-size: 30rpx;
  font-weight: 700;
  color: #d85b3d;
}

.price-current::before {
  content: '¥';
  font-size: 22rpx;
  font-weight: 600;
}

.price-unit {
  font-size: 20rpx;
  color: #7d8782;
  margin-left: 4rpx;
}

/* 数量控制器 */
.quantity-control {
  display: flex;
  align-items: center;
  gap: 0;
  background: #eef8f3;
  border-radius: 999rpx;
  padding: 4rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #176f56;
  background: #ffffff;
  border-radius: 50%;
  transition: all 0.15s ease;
}

.qty-btn:active {
  transform: scale(0.92);
  background: #176f56;
}

.qty-btn:active image {
  filter: brightness(10);
}

.qty-icon {
  font-size: 28rpx;
  font-weight: 700;
  color: #176f56;
  line-height: 1;
}

.qty-value {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #17231f;
}

/* 删除按钮 */
.item-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-tertiary);
  background: #f3f5f4;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.item-remove:active {
  background: rgba(220, 53, 69, 0.1);
  color: var(--color-error);
}

.remove-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: #7d8782;
  line-height: 1;
}

/* ============ 底部结算栏 ============ */
.cart-footer {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 142rpx);
  left: 28rpx;
  right: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  padding: 18rpx 24rpx;
  box-shadow: 0 16rpx 44rpx rgba(32, 74, 58, 0.16);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 999rpx;
  backdrop-filter: blur(18rpx);
}

.footer-left {
  display: flex;
  flex-direction: column;
}

.total-label {
  font-size: 24rpx;
  color: #7d8782;
}

.total-amount {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.total-symbol {
  font-size: 26rpx;
  font-weight: 600;
  color: #7d8782;
}

.total-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #d85b3d;
}

.footer-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.settlement-btn {
  background: linear-gradient(180deg, #37d39a 0%, #16a374 100%);
  color: #ffffff;
  padding: 22rpx 48rpx;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 800;
  letter-spacing: 0;
  box-shadow: 0 12rpx 30rpx rgba(22, 120, 86, 0.22);
  transition: all 0.2s ease;
}

.settlement-btn:active {
  transform: scale(0.97);
}

/* ============ 空购物车 ============ */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 40rpx 28rpx 0;
  padding: 150rpx 0;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.empty-icon-box {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
  position: relative;
}

.empty-icon-shape {
  width: 100%;
  height: 100%;
  border: 3rpx solid #d8ebe2;
  border-radius: 28rpx;
  transform: rotate(45deg);
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #17231f;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #7d8782;
  margin-bottom: 48rpx;
}

.shop-btn {
  background: linear-gradient(180deg, #37d39a 0%, #16a374 100%);
  color: #ffffff;
  padding: 24rpx 64rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0;
  box-shadow: 0 12rpx 30rpx rgba(22, 120, 86, 0.22);
  transition: all 0.2s ease;
}

.shop-btn:active {
  transform: scale(0.97);
}

/* ============ 动画 ============ */
.cart-header {
  animation: fadeIn 0.3s ease;
}

.cart-item {
  animation: fadeInUp 0.4s ease backwards;
}

.cart-item:nth-child(1) { animation-delay: 0.05s; }
.cart-item:nth-child(2) { animation-delay: 0.1s; }
.cart-item:nth-child(3) { animation-delay: 0.15s; }
.cart-item:nth-child(4) { animation-delay: 0.2s; }
.cart-item:nth-child(5) { animation-delay: 0.25s; }
