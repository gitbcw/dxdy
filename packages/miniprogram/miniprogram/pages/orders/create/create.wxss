.page {
  min-height: 100vh;
  padding-bottom: 148rpx;
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  box-sizing: border-box;
}

.content {
  padding: 18rpx 22rpx;
}

.goods-card,
.card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.goods-card {
  display: flex;
  gap: 18rpx;
}

.goods-img {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 150rpx;
  height: 150rpx;
  border-radius: 20rpx;
  color: #176f56;
  font-size: 24rpx;
  font-weight: 900;
  background: #eef8f3;
  overflow: hidden;
}

.goods-img image {
  width: 100%;
  height: 100%;
}

.cart-thumb {
  width: 74rpx;
  height: 74rpx;
  margin-right: 14rpx;
  border-radius: 14rpx;
  background: #eef8f3;
}

.goods-main {
  flex: 1;
  min-width: 0;
}

.goods-name {
  display: block;
  color: #17231f;
  font-size: 28rpx;
  line-height: 1.38;
  font-weight: 900;
}

.goods-meta {
  display: block;
  margin-top: 8rpx;
  color: #7d8983;
  font-size: 22rpx;
}

.goods-price,
.cart-price,
.orange {
  color: #ff5a00;
  font-weight: 900;
}

.goods-price {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #17231f;
  font-size: 28rpx;
  font-weight: 900;
}

.cart-item {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 6rpx 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef2ef;
}

.cart-item:last-child {
  border-bottom: 0;
}

.cart-name {
  color: #17231f;
  font-size: 25rpx;
  font-weight: 800;
}

.cart-meta {
  color: #7d8983;
  font-size: 21rpx;
}

.cart-price {
  grid-row: span 2;
  align-self: center;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 80rpx;
  border-bottom: 1rpx solid #eef2ef;
}

.row:last-child {
  border-bottom: 0;
}

.row-label {
  flex-shrink: 0;
  color: #17231f;
  font-size: 25rpx;
  font-weight: 800;
}

.row-value {
  color: #68746e;
  font-size: 24rpx;
  text-align: right;
}

.row-input {
  flex: 1;
  min-width: 0;
  color: #17231f;
  font-size: 24rpx;
  text-align: right;
}

.quantity {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.qty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: #176f56;
  font-size: 26rpx;
  font-weight: 900;
  background: #eef8f3;
}

.num {
  color: #17231f;
  font-size: 28rpx;
  font-weight: 900;
}

.address-card {
  padding: 20rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 20rpx;
  background: #fbfefd;
}

.address-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.address-name {
  color: #17231f;
  font-size: 25rpx;
  font-weight: 900;
}

.address-phone {
  color: #66736d;
  font-size: 23rpx;
}

.address-action {
  margin-left: auto;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  color: #176f56;
  font-size: 19rpx;
  font-weight: 800;
  background: #eef8f3;
}

.address-text {
  margin-top: 12rpx;
  color: #344139;
  font-size: 23rpx;
  line-height: 1.5;
}

.voucher-notice {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #eef8f3;
}

.voucher-title {
  display: block;
  color: #176f56;
  font-size: 26rpx;
  font-weight: 900;
}

.voucher-desc {
  display: block;
  margin-top: 8rpx;
  color: #5f6d66;
  font-size: 23rpx;
  line-height: 1.5;
}

.booking-box {
  margin-top: 16rpx;
  padding-top: 10rpx;
}

.urgent-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #eef8f3;
}

.urgent-title {
  display: block;
  color: #176f56;
  font-size: 24rpx;
  font-weight: 900;
}

.urgent-desc {
  display: block;
  margin-top: 6rpx;
  color: #5e8068;
  font-size: 21rpx;
}

.fee-detail {
  color: #d85b3d;
  font-size: 20rpx;
}

.remark-input {
  flex: 1;
  min-width: 0;
  color: #17231f;
  font-size: 23rpx;
  text-align: right;
}

.pay-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.pay-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx;
  border: 1rpx solid #eef2ef;
  border-radius: 16rpx;
  color: #6e7973;
  font-size: 23rpx;
  background: #fbfefd;
}

.pay-item.active {
  color: #176f56;
  border-color: #cfe8dc;
  background: #eef8f3;
}

.rule-box {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  color: #6d7872;
  font-size: 22rpx;
  line-height: 1.5;
  background: #fbfefd;
}

.footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -14rpx 34rpx rgba(32, 98, 76, 0.08);
}

.footer-label {
  display: block;
  color: #7d8983;
  font-size: 22rpx;
}

.total {
  display: block;
  margin-top: 4rpx;
  color: #ff5a00;
  font-size: 36rpx;
  font-weight: 900;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 300rpx;
  min-height: 84rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: linear-gradient(180deg, #ff8a1f 0%, #ff5a00 100%);
}
