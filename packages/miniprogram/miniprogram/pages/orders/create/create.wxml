<view class="page">
  <view wx:if="{{product || isFromCart}}" class="content">
    <view wx:if="{{product}}" class="goods-card">
      <view class="goods-img">{{isBloodProduct ? '血包' : '商品'}}</view>
      <view class="goods-main">
        <text class="goods-name">{{product.name}}</text>
        <text class="goods-meta">{{specText}}</text>
        <text class="goods-price">¥{{unitPrice}}</text>
      </view>
    </view>

    <view wx:if="{{isFromCart}}" class="card">
      <view class="section-title">购物车结算</view>
      <view wx:for="{{cartItems}}" wx:key="id" class="cart-item">
        <text class="cart-name">{{item.name}}</text>
        <text class="cart-meta">{{item.specText}} ×{{item.quantity}}</text>
        <text class="cart-price">¥{{item.lineTotal}}</text>
      </view>
    </view>

    <view wx:if="{{product}}" class="card">
      <view class="row">
        <text class="row-label">规格</text>
        <text class="row-value">{{specText}} ></text>
      </view>
      <view class="row">
        <text class="row-label">购买数量</text>
        <view class="quantity">
          <view class="qty-btn" data-delta="{{-1}}" bindtap="onQuantityChange">−</view>
          <text class="num">{{quantity}}</text>
          <view class="qty-btn" data-delta="{{1}}" bindtap="onQuantityChange">＋</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">{{orderType === 'booking' ? '预约与配送' : '收货信息'}}</view>
      <view class="address-card">
        <view class="address-head">
          <text class="address-name">{{addressName}}</text>
          <text class="address-phone">{{addressPhone}}</text>
          <text class="address-action">默认</text>
        </view>
        <picker wx:if="{{addressOptions.length}}" mode="selector" range="{{addressOptions}}" value="{{selectedAddressIndex}}" bindchange="onAddressChange">
          <view class="address-text">{{addressText}} ></view>
        </picker>
        <view wx:else class="address-text">暂无可用地址，请先新增地址</view>
      </view>

      <view wx:if="{{orderType === 'booking'}}" class="booking-box">
        <view class="row">
          <text class="row-label">预约日期</text>
          <picker mode="date" value="{{bookingDate}}" start="{{minBookingDate}}" bindchange="onBookingDateChange">
            <view class="row-value">{{bookingDate}} 📅</view>
          </picker>
        </view>
        <view class="row">
          <text class="row-label">预约时间</text>
          <input class="row-input" data-field="bookingLocation" value="{{bookingLocation}}" bindinput="onBookingInput" />
        </view>
        <view class="urgent-row">
          <view>
            <text class="urgent-title">加急配送</text>
            <text class="urgent-desc">优先调配与配送，最快 1 小时送达</text>
          </view>
          <view class="switch-on"></view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="row">
        <text class="row-label">发票</text>
        <text class="row-value">不开发票 ></text>
      </view>
      <view class="row">
        <text class="row-label">优惠券</text>
        <text class="row-value">已选 1 张，优惠 ¥20.00 ></text>
      </view>
      <view class="row">
        <text class="row-label">运费</text>
        <text class="row-value orange">¥0.00</text>
      </view>
      <view class="row">
        <text class="row-label">订单备注</text>
        <input class="remark-input" placeholder="选填，请先和商家协商一致" value="{{remark}}" bindinput="onRemarkInput" />
      </view>
    </view>

    <view class="card">
      <view class="section-title">支付方式</view>
      <view class="pay-list">
        <view class="pay-item {{payMethod === 'wechat' ? 'active' : ''}}" data-method="wechat" bindtap="onPayMethodChange">
          <text>微信支付</text>
          <text>推荐</text>
        </view>
        <view class="pay-item {{payMethod === 'wallet' ? 'active' : ''}}" data-method="wallet" bindtap="onPayMethodChange">
          <text>钱包余额</text>
          <text>可用余额</text>
        </view>
      </view>
      <view class="rule-box">
        <text>{{policyText}}</text>
      </view>
    </view>
  </view>

  <view class="footer" wx:if="{{product || isFromCart}}">
    <view>
      <text class="footer-label">应付金额</text>
      <text class="total">¥{{total}}</text>
    </view>
    <view class="submit-btn" bindtap="onSubmit">{{primaryButtonText}}</view>
  </view>
</view>
