<view class="page">
  <block wx:if="{{!isDetailMode}}">
    <scroll-view scroll-x class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{activeTab === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTabTap"
      >{{item.label}}</view>
    </scroll-view>

    <view wx:if="{{isEmpty}}" class="empty">暂无订单</view>
    <view wx:else class="order-list">
      <view
        wx:for="{{visibleOrders}}"
        wx:key="id"
        class="order-card"
        data-id="{{item.id}}"
        bindtap="onOrderTap"
      >
        <view class="order-top">
          <text class="order-id">订单号 {{item.id}}</text>
          <text class="order-status">{{item.statusText}}</text>
        </view>
        <view class="goods-row">
        <view class="goods-img">
          <image wx:if="{{item.firstProductImage}}" src="{{item.firstProductImage}}" mode="aspectFit" />
          <text wx:else>{{item.firstProductName ? '商品' : '订单'}}</text>
        </view>
          <view class="goods-main">
            <text class="goods-name">{{item.firstProductName}}</text>
            <text class="goods-spec">{{item.firstProductSpec}} · 共 {{item.itemCount}} 件</text>
            <text wx:if="{{item.priceChanged}}" class="notice">后台已改价，优惠 ¥{{item.savedText}}</text>
          </view>
          <text class="amount">¥{{item.totalText}}</text>
        </view>
        <view wx:if="{{item.returnRecord}}" class="notice amber">{{item.returnStatusText}}</view>
        <view wx:if="{{item.status === 'pending_payment' && item.paymentTimeout}}" class="timeout-tip {{item.paymentTimeout.expired ? 'expired' : ''}}">
          <text>{{item.paymentTimeout.notice}}</text>
        </view>
        <view class="order-actions">
          <view
            wx:if="{{item.status === 'pending_receipt' && item.canQueryLogistics}}"
            class="ghost-btn"
            data-id="{{item.id}}"
            catchtap="onLogisticsFromList"
          >查看物流</view>
          <view wx:if="{{item.status === 'completed' && (!item.returnRecord || item.returnRecord.status === 'rejected')}}" class="ghost-btn" data-id="{{item.id}}" catchtap="onReturnFromList">申请售后</view>
          <view wx:if="{{item.returnRecord && item.returnRecord.status !== 'rejected'}}" class="ghost-btn" data-id="{{item.id}}" catchtap="onReturnFromList">查看售后</view>
          <view wx:if="{{item.canDelete}}" class="danger-btn" data-id="{{item.id}}" catchtap="onDeleteFromList">删除订单</view>
          <view class="orange-btn">查看详情</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="status-card">
      <text class="status-title">{{selectedOrder.statusText}}</text>
      <text class="status-desc">{{selectedOrder.statusDesc}}</text>
    </view>

    <view class="flow-card">
      <view class="flow-line">
        <view wx:for="{{flowSteps}}" wx:key="key" class="flow-step">
          <view class="flow-dot {{item.active ? 'active' : ''}}"></view>
          <text class="flow-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="order-meta">
        <text>订单号</text>
        <text>{{selectedOrder.id}}</text>
      </view>
      <view class="order-meta">
        <text>下单时间</text>
        <text>{{selectedOrder.dateText}}</text>
      </view>
      <view wx:if="{{selectedOrder.booking}}" class="order-meta">
        <text>预约信息</text>
        <text>{{selectedOrder.booking.date}} · {{selectedOrder.booking.location}}</text>
      </view>
      <view wx:if="{{selectedOrder.booking && selectedOrder.booking.bloodBooking}}" class="order-meta">
        <text>用血需求</text>
        <text>{{selectedOrder.booking.speciesLabel}} · {{selectedOrder.booking.bloodType}} · {{selectedOrder.booking.volumeMl}}ml</text>
      </view>
    </view>

    <view class="card">
      <view wx:for="{{selectedOrder.items}}" wx:key="productId" class="detail-goods">
        <view class="goods-img small">
          <image wx:if="{{item.productImage}}" src="{{item.productImage}}" mode="aspectFit" />
          <text wx:else>商品</text>
        </view>
        <view class="goods-main">
          <text class="goods-name">{{item.productName}}</text>
          <text class="goods-spec">{{item.spec}} ×{{item.quantity}}</text>
        </view>
        <text class="amount">¥{{item.totalPrice}}</text>
      </view>
      <view class="amount-row">
        <text>商品金额</text>
        <text>¥{{selectedOrder.originalText}}</text>
      </view>
      <view class="amount-row">
        <text>优惠金额</text>
        <text>-¥{{selectedOrder.savedText}}</text>
      </view>
      <view class="amount-row strong">
        <text>实付款</text>
        <text>¥{{selectedOrder.totalText}}</text>
      </view>
      <view wx:if="{{selectedOrder.payment && selectedOrder.payment.status === 'paid'}}" class="amount-row">
        <text>付款方式</text>
        <text>{{selectedOrder.paymentMethodText}}</text>
      </view>
    </view>

    <view class="card">
      <view class="order-meta">
        <text>收货信息</text>
        <text>{{selectedOrder.shipping.address.full}}</text>
      </view>
      <view class="order-meta" bindtap="{{selectedOrder.canQueryLogistics ? 'onLogisticsTap' : ''}}">
        <text>物流信息</text>
        <text>{{selectedOrder.logisticsText}}{{selectedOrder.canQueryLogistics ? ' >' : ''}}</text>
      </view>
    </view>

    <view wx:if="{{selectedOrder.status === 'pending_payment'}}" class="card">
      <view wx:if="{{selectedOrder.paymentTimeout}}" class="timeout-tip in-detail {{selectedOrder.paymentTimeout.expired ? 'expired' : ''}}">
        <text>{{selectedOrder.paymentTimeout.notice}}</text>
      </view>
      <text class="card-title">支付方式</text>
      <view class="pay-list">
        <view class="pay-item {{selectedPayMethod === 'wechat' ? 'active' : ''}}" data-method="wechat" bindtap="onPayMethodTap">
          <text>微信支付</text>
          <text>推荐</text>
        </view>
        <view class="pay-item {{selectedPayMethod === 'wallet' ? 'active' : ''}}" data-method="wallet" bindtap="onPayMethodTap">
          <text>钱包余额</text>
          <text>余额 ¥{{walletBalanceText}}</text>
        </view>
      </view>
      <view wx:if="{{selectedOrder.type === 'booking'}}" class="voucher-pay">
        <view class="voucher-head">
          <text>卡券抵扣</text>
          <text>{{availableCardVouchers.length ? '请选择一张可用卡券' : '暂无可用卡券'}}</text>
        </view>
        <view wx:if="{{availableCardVouchers.length}}" class="voucher-list">
          <view
            wx:for="{{availableCardVouchers}}"
            wx:key="id"
            class="voucher-item {{selectedCardVoucherId === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onCardVoucherTap"
          >
            <view>
              <text class="voucher-title">{{item.productName}}</text>
              <text class="voucher-no">{{item.cardNo}}</text>
            </view>
            <text class="voucher-amount">-¥{{item.discountText}}</text>
          </view>
        </view>
        <view wx:if="{{selectedCardVoucherId}}" class="voucher-summary">
          <text>已抵扣 ¥{{cardDiscountText}}</text>
          <text>还需支付 ¥{{payableAmountText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{selectedOrder.priceChanged}}" class="card highlight">
      <text class="card-title">后台改价记录</text>
      <view wx:for="{{selectedOrder.pricing.priceLog}}" wx:key="operatedAt" class="price-log">
        <text>{{item.operatorName}} · {{item.operatedAt}}</text>
        <text>¥{{item.originalPrice}} → ¥{{item.modifiedPrice}}</text>
      </view>
      <text class="notice in-card">改价后会通知客户重新确认支付，并重置待支付倒计时。</text>
    </view>

    <view class="card">
      <view class="link-row" bindtap="onReturnEntryTap">
        <text>申请售后</text>
        <text>{{selectedOrder.returnRecord ? selectedOrder.returnStatusText : '可申请' }} ></text>
      </view>
      <view class="link-row" bindtap="onServiceTap">
        <text>联系客服</text>
        <text>></text>
      </view>
    </view>

    <view class="action-bar">
      <view class="back-action" bindtap="onBackToList">返回订单</view>
      <view
        wx:for="{{detailActions}}"
        wx:key="key"
        class="action-btn {{item.primary ? 'primary' : ''}} {{item.danger ? 'danger' : ''}}"
        data-key="{{item.key}}"
        bindtap="onActionTap"
      >{{item.label}}</view>
    </view>
  </block>
</view>
