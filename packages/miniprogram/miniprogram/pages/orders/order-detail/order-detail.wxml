<view class="page">
  <block wx:if="{{!isDetailMode}}">
    <view class="list-header">
      <text class="page-title">订单</text>
      <view class="header-actions">
        <text>⌕</text>
        <text>•••</text>
      </view>
    </view>

    <scroll-view scroll-x class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{activeTab === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTabTap"
      >{{item.label}}</view>
    </scroll-view>

    <view wx:if="{{isEmpty}}" class="empty">暂无订单</view>
    <view wx:else class="order-list">
      <view
        wx:for="{{visibleOrders}}"
        wx:key="id"
        class="order-card"
        data-id="{{item.id}}"
        bindtap="onOrderTap"
      >
        <view class="order-top">
          <text class="order-id">订单号 {{item.id}}</text>
          <text class="order-status">{{item.statusText}}</text>
        </view>
        <view class="goods-row">
        <view class="goods-img">
          <image wx:if="{{item.firstProductImage}}" src="{{item.firstProductImage}}" mode="aspectFit" />
          <text wx:else>{{item.firstProductName ? '商品' : '订单'}}</text>
        </view>
          <view class="goods-main">
            <text class="goods-name">{{item.firstProductName}}</text>
            <text class="goods-spec">{{item.firstProductSpec}} · 共 {{item.itemCount}} 件</text>
            <text wx:if="{{item.priceChanged}}" class="notice">后台已改价，优惠 ¥{{item.savedText}}</text>
          </view>
          <text class="amount">¥{{item.totalText}}</text>
        </view>
        <view wx:if="{{item.returnRecord}}" class="notice amber">{{item.returnStatusText}} · {{item.commissionText}}</view>
        <view class="order-actions">
          <view
            wx:if="{{item.status === 'pending_receipt'}}"
            class="ghost-btn"
            data-id="{{item.id}}"
            catchtap="onLogisticsFromList"
          >查看物流</view>
          <view wx:if="{{item.status === 'completed'}}" class="ghost-btn" data-id="{{item.id}}" catchtap="onReturnFromList">申请售后</view>
          <view class="orange-btn">查看详情</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="status-card">
      <text class="status-title">{{selectedOrder.statusText}}</text>
      <text class="status-desc">{{selectedOrder.statusDesc}}</text>
    </view>

    <view class="flow-card">
      <view class="flow-line">
        <view wx:for="{{flowSteps}}" wx:key="key" class="flow-step">
          <view class="flow-dot {{item.active ? 'active' : ''}}"></view>
          <text class="flow-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="order-meta">
        <text>订单号</text>
        <text>{{selectedOrder.id}}</text>
      </view>
      <view class="order-meta">
        <text>下单时间</text>
        <text>{{selectedOrder.dateText}}</text>
      </view>
      <view wx:if="{{selectedOrder.booking}}" class="order-meta">
        <text>预约信息</text>
        <text>{{selectedOrder.booking.date}} · {{selectedOrder.booking.location}}</text>
      </view>
    </view>

    <view class="card">
      <view wx:for="{{selectedOrder.items}}" wx:key="productId" class="detail-goods">
        <view class="goods-img small">
          <image wx:if="{{item.productImage}}" src="{{item.productImage}}" mode="aspectFit" />
          <text wx:else>商品</text>
        </view>
        <view class="goods-main">
          <text class="goods-name">{{item.productName}}</text>
          <text class="goods-spec">{{item.spec}} ×{{item.quantity}}</text>
        </view>
        <text class="amount">¥{{item.totalPrice}}</text>
      </view>
      <view class="amount-row">
        <text>商品金额</text>
        <text>¥{{selectedOrder.originalText}}</text>
      </view>
      <view class="amount-row">
        <text>优惠金额</text>
        <text>-¥{{selectedOrder.savedText}}</text>
      </view>
      <view class="amount-row strong">
        <text>实付款</text>
        <text>¥{{selectedOrder.totalText}}</text>
      </view>
    </view>

    <view class="card">
      <view class="order-meta">
        <text>收货信息</text>
        <text>{{selectedOrder.shipping.address.full}}</text>
      </view>
      <view class="order-meta" bindtap="onLogisticsTap">
        <text>物流信息</text>
        <text>{{selectedOrder.logisticsText}} ></text>
      </view>
    </view>

    <view wx:if="{{selectedOrder.priceChanged}}" class="card highlight">
      <text class="card-title">后台改价记录</text>
      <view wx:for="{{selectedOrder.pricing.priceLog}}" wx:key="operatedAt" class="price-log">
        <text>{{item.operatorName}} · {{item.operatedAt}}</text>
        <text>¥{{item.originalPrice}} → ¥{{item.modifiedPrice}}</text>
      </view>
      <text class="notice in-card">改价后会通知客户重新确认支付，并重置待支付倒计时。</text>
    </view>

    <view class="card">
      <view class="link-row" bindtap="onTestReportTap">
        <text>电子检测报告</text>
        <text>扫码/输入检测码 ></text>
      </view>
      <view class="link-row" bindtap="onInvoiceTap">
        <text>发票信息</text>
        <text>申请开票 ></text>
      </view>
      <view class="link-row" bindtap="onReturnEntryTap">
        <text>申请售后</text>
        <text>{{selectedOrder.returnRecord ? selectedOrder.returnStatusText : '可申请' }} ></text>
      </view>
      <view class="link-row">
        <text>联系客服</text>
        <text>></text>
      </view>
    </view>

    <view class="action-bar">
      <view class="back-action" bindtap="onBackToList">返回订单</view>
      <view
        wx:for="{{detailActions}}"
        wx:key="key"
        class="action-btn {{item.primary ? 'primary' : ''}}"
        data-key="{{item.key}}"
        bindtap="onActionTap"
      >{{item.label}}</view>
    </view>
  </block>
</view>
