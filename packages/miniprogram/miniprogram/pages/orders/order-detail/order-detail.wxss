.page {
  min-height: 100vh;
  padding: 22rpx;
  padding-bottom: 240rpx;
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  box-sizing: border-box;
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 20;
  box-sizing: border-box;
  width: 100%;
  padding: 8rpx;
  border: 1rpx solid #e7ece9;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 12rpx 30rpx rgba(32, 98, 76, 0.08);
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 58rpx;
  margin-right: 8rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  color: #7d8782;
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.tab.active {
  color: #176f56;
  background: #eef8f3;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}

.order-card,
.card,
.flow-card,
.status-card {
  padding: 22rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.card,
.flow-card,
.status-card {
  margin-bottom: 18rpx;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.order-id {
  flex: 1;
  min-width: 0;
  color: #7d8782;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #ff5a00;
  font-size: 22rpx;
  font-weight: 900;
  background: #fff7ed;
}

.goods-row,
.detail-goods {
  display: flex;
  gap: 18rpx;
}

.detail-goods {
  padding-bottom: 18rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid #eef2ef;
}

.goods-img {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 132rpx;
  height: 132rpx;
  border-radius: 18rpx;
  color: #176f56;
  font-size: 22rpx;
  font-weight: 900;
  background: #eef8f3;
  overflow: hidden;
}

.goods-img image {
  width: 100%;
  height: 100%;
}

.goods-img.small {
  width: 116rpx;
  height: 116rpx;
}

.goods-main {
  flex: 1;
  min-width: 0;
}

.goods-name {
  display: block;
  color: #17231f;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 900;
}

.goods-spec {
  display: block;
  margin-top: 8rpx;
  color: #7d8983;
  font-size: 21rpx;
}

.amount {
  flex-shrink: 0;
  color: #ff5a00;
  font-size: 26rpx;
  font-weight: 900;
}

.notice {
  display: block;
  margin-top: 10rpx;
  color: #176f56;
  font-size: 21rpx;
  line-height: 1.45;
}

.notice.amber {
  padding: 14rpx;
  border-radius: 14rpx;
  color: #d85b3d;
  background: #fff7ed;
}

.notice.in-card {
  margin-top: 16rpx;
}

.timeout-tip {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(216, 91, 61, 0.2);
  border-radius: 16rpx;
  background: #fff7ed;
}

.timeout-tip.in-detail {
  margin-top: 0;
  margin-bottom: 18rpx;
}

.timeout-tip text {
  display: block;
  color: #d85b3d;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 700;
}

.timeout-tip.expired {
  border-color: rgba(229, 72, 77, 0.24);
  background: #fff1f1;
}

.timeout-tip.expired text {
  color: #d92d20;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.ghost-btn,
.orange-btn,
.danger-btn {
  min-width: 150rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
  text-align: center;
}

.ghost-btn {
  color: #176f56;
  border: 1rpx solid rgba(23, 111, 86, 0.24);
  background: #ffffff;
}

.orange-btn {
  color: #ff5a00;
  border: 1rpx solid rgba(255, 106, 0, 0.35);
  background: #ffffff;
}

.danger-btn {
  color: #e5484d;
  border: 1rpx solid rgba(229, 72, 77, 0.32);
  background: #ffffff;
}

.status-card {
  color: #176f56;
  background: #eef8f3;
}

.status-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
}

.status-desc {
  display: block;
  margin-top: 10rpx;
  color: #4d7558;
  font-size: 23rpx;
  line-height: 1.5;
}

.flow-line {
  display: flex;
  justify-content: space-between;
}

.flow-step {
  position: relative;
  flex: 1;
  text-align: center;
}

.flow-step::before {
  content: '';
  position: absolute;
  top: 13rpx;
  right: 0;
  left: 0;
  height: 2rpx;
  background: #dfe6e2;
}

.flow-dot {
  position: relative;
  z-index: 1;
  width: 28rpx;
  height: 28rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
  background: #cfd8d3;
}

.flow-dot.active {
  background: #176f56;
}

.flow-label {
  color: #6d7872;
  font-size: 20rpx;
}

.order-meta,
.amount-row,
.link-row,
.price-log {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef2ef;
}

.order-meta:last-child,
.amount-row:last-child,
.link-row:last-child,
.price-log:last-child {
  border-bottom: 0;
}

.order-meta text:first-child,
.amount-row text:first-child,
.link-row text:first-child {
  flex-shrink: 0;
  color: #7d8983;
  font-size: 23rpx;
}

.order-meta text:last-child,
.amount-row text:last-child,
.link-row text:last-child {
  flex: 1;
  color: #17231f;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: right;
}

.amount-row.strong text {
  color: #17231f;
  font-size: 27rpx;
  font-weight: 900;
}

.amount-row.strong text:last-child {
  color: #ff5a00;
}

.voucher-pay {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2ef;
}

.voucher-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.voucher-head text:first-child {
  color: #17231f;
  font-size: 25rpx;
  font-weight: 900;
}

.voucher-head text:last-child {
  color: #7d8983;
  font-size: 22rpx;
}

.voucher-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.voucher-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #edf2ef;
  border-radius: 18rpx;
  background: #fbfefd;
}

.voucher-item.active {
  border-color: #cfe8dc;
  background: #eef8f3;
}

.voucher-title,
.voucher-no {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.voucher-title {
  max-width: 420rpx;
  color: #17231f;
  font-size: 25rpx;
  font-weight: 900;
}

.voucher-no {
  max-width: 420rpx;
  margin-top: 6rpx;
  color: #7d8983;
  font-size: 21rpx;
}

.voucher-amount {
  flex: 0 0 auto;
  color: #ff5a00;
  font-size: 25rpx;
  font-weight: 900;
}

.voucher-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #fff7ed;
}

.voucher-summary text {
  color: #ff5a00;
  font-size: 24rpx;
  font-weight: 900;
}

.card-title {
  display: block;
  margin-bottom: 10rpx;
  color: #17231f;
  font-size: 27rpx;
  font-weight: 900;
}

.highlight {
  border: 1rpx solid rgba(255, 106, 0, 0.18);
  background: #fffaf6;
}

.pay-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.pay-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid #eef2ef;
  border-radius: 16rpx;
  color: #6e7973;
  font-size: 23rpx;
  background: #fbfefd;
}

.pay-item text {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pay-item text:first-child {
  flex-shrink: 0;
}

.pay-item.active {
  color: #176f56;
  border-color: #cfe8dc;
  background: #eef8f3;
}

.price-log text {
  color: #6d7872;
  font-size: 22rpx;
}

.price-log text:last-child {
  color: #ff5a00;
  font-weight: 900;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -14rpx 34rpx rgba(32, 98, 76, 0.08);
}

.back-action,
.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-height: 80rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.back-action,
.action-btn {
  color: #176f56;
  border: 1rpx solid rgba(23, 111, 86, 0.24);
  background: #ffffff;
}

.action-btn.primary {
  color: #ffffff;
  border-color: transparent;
  background: linear-gradient(180deg, #ff8a1f 0%, #ff5a00 100%);
}

.action-btn.danger {
  color: #e5484d;
  border-color: rgba(229, 72, 77, 0.32);
  background: #ffffff;
}

.empty {
  margin-top: 40rpx;
  padding: 120rpx 0;
  border: 1rpx solid #edf1ee;
  border-radius: 26rpx;
  color: #97a39d;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.06);
}
