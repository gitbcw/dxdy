.page {
  min-height: 100vh;
  padding: 22rpx;
  padding-bottom: 240rpx;
  background: #f6f7f6;
  box-sizing: border-box;
}

.tabs {
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  margin-right: 26rpx;
  color: #68746e;
  font-size: 24rpx;
  font-weight: 700;
}

.tab.active {
  color: #139445;
  border-bottom: 5rpx solid #18a34a;
}

.order-list {
  margin-top: 16rpx;
}

.order-card,
.card,
.flow-card,
.status-card {
  margin-bottom: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 45, 32, 0.05);
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.order-id {
  color: #717d77;
  font-size: 22rpx;
}

.order-status {
  flex-shrink: 0;
  color: #ff5a00;
  font-size: 22rpx;
  font-weight: 900;
}

.goods-row,
.detail-goods {
  display: flex;
  gap: 18rpx;
}

.goods-img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border-radius: 14rpx;
  color: #139445;
  font-size: 22rpx;
  font-weight: 900;
  background: #f0f7f2;
  overflow: hidden;
}

.goods-img image {
  width: 100%;
  height: 100%;
}

.goods-img.small {
  width: 116rpx;
  height: 116rpx;
}

.goods-main {
  flex: 1;
  min-width: 0;
}

.goods-name {
  display: block;
  color: #17231f;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 900;
}

.goods-spec {
  display: block;
  margin-top: 8rpx;
  color: #7d8983;
  font-size: 21rpx;
}

.amount {
  flex-shrink: 0;
  color: #ff5a00;
  font-size: 26rpx;
  font-weight: 900;
}

.notice {
  display: block;
  margin-top: 10rpx;
  color: #139445;
  font-size: 21rpx;
  line-height: 1.45;
}

.notice.amber {
  padding: 14rpx;
  border-radius: 12rpx;
  color: #ff5a00;
  background: #fff2e8;
}

.notice.in-card {
  margin-top: 16rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
}

.ghost-btn,
.orange-btn,
.danger-btn {
  min-width: 150rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
  text-align: center;
}

.ghost-btn {
  color: #139445;
  border: 1rpx solid rgba(22, 163, 74, 0.35);
  background: #ffffff;
}

.orange-btn {
  color: #ff5a00;
  border: 1rpx solid rgba(255, 106, 0, 0.35);
  background: #ffffff;
}

.danger-btn {
  color: #e5484d;
  border: 1rpx solid rgba(229, 72, 77, 0.32);
  background: #ffffff;
}

.status-card {
  color: #139445;
  background: #eaf8ef;
}

.status-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
}

.status-desc {
  display: block;
  margin-top: 10rpx;
  color: #4d7558;
  font-size: 23rpx;
  line-height: 1.5;
}

.flow-line {
  display: flex;
  justify-content: space-between;
}

.flow-step {
  flex: 1;
  position: relative;
  text-align: center;
}

.flow-step::before {
  content: '';
  position: absolute;
  top: 13rpx;
  left: 0;
  right: 0;
  height: 2rpx;
  background: #dfe6e2;
}

.flow-dot {
  position: relative;
  z-index: 1;
  width: 28rpx;
  height: 28rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
  background: #cfd8d3;
}

.flow-dot.active {
  background: #18a34a;
}

.flow-label {
  color: #6d7872;
  font-size: 20rpx;
}

.order-meta,
.amount-row,
.link-row,
.price-log {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef2ef;
}

.order-meta:last-child,
.amount-row:last-child,
.link-row:last-child,
.price-log:last-child {
  border-bottom: 0;
}

.order-meta text:first-child,
.amount-row text:first-child,
.link-row text:first-child {
  flex-shrink: 0;
  color: #7d8983;
  font-size: 23rpx;
}

.order-meta text:last-child,
.amount-row text:last-child,
.link-row text:last-child {
  flex: 1;
  color: #17231f;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: right;
}

.amount-row.strong text {
  color: #17231f;
  font-size: 27rpx;
  font-weight: 900;
}

.amount-row.strong text:last-child {
  color: #ff5a00;
}

.voucher-pay {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2ef;
}

.voucher-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.voucher-head text:first-child {
  color: #17231f;
  font-size: 25rpx;
  font-weight: 900;
}

.voucher-head text:last-child {
  color: #7d8983;
  font-size: 22rpx;
}

.voucher-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.voucher-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #edf2ef;
  border-radius: 14rpx;
  background: #fafcfb;
}

.voucher-item.active {
  border-color: #ff6a00;
  background: #fff7ed;
}

.voucher-title,
.voucher-no {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.voucher-title {
  max-width: 420rpx;
  color: #17231f;
  font-size: 25rpx;
  font-weight: 900;
}

.voucher-no {
  max-width: 420rpx;
  margin-top: 6rpx;
  color: #7d8983;
  font-size: 21rpx;
}

.voucher-amount {
  flex: 0 0 auto;
  color: #ff5a00;
  font-size: 25rpx;
  font-weight: 900;
}

.voucher-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #fff7ed;
}

.voucher-summary text {
  color: #ff5a00;
  font-size: 24rpx;
  font-weight: 900;
}

.card-title {
  display: block;
  margin-bottom: 10rpx;
  color: #17231f;
  font-size: 27rpx;
  font-weight: 900;
}

.highlight {
  border: 1rpx solid rgba(255, 106, 0, 0.18);
  background: #fffaf6;
}

.pay-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.pay-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid #eef2ef;
  border-radius: 14rpx;
  color: #6e7973;
  font-size: 23rpx;
  background: #f8faf8;
}

.pay-item text {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pay-item text:first-child {
  flex-shrink: 0;
}

.pay-item.active {
  color: #139445;
  border-color: rgba(22, 163, 74, 0.3);
  background: #edf8f0;
}

.price-log text {
  color: #6d7872;
  font-size: 22rpx;
}

.price-log text:last-child {
  color: #ff5a00;
  font-weight: 900;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 14rpx;
  padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(24, 45, 32, 0.08);
}

.back-action,
.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.back-action,
.action-btn {
  color: #139445;
  border: 1rpx solid rgba(22, 163, 74, 0.35);
  background: #ffffff;
}

.action-btn.primary {
  color: #ffffff;
  border-color: transparent;
  background: linear-gradient(180deg, #ff8a1f 0%, #ff5a00 100%);
}

.action-btn.danger {
  color: #e5484d;
  border-color: rgba(229, 72, 77, 0.32);
  background: #ffffff;
}

.empty {
  padding: 160rpx 0;
  color: #8b9994;
  font-size: 26rpx;
  text-align: center;
}
