.page {
  min-height: 100vh;
  padding: 28rpx 22rpx 150rpx;
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  box-sizing: border-box;
}

.balance-card {
  padding: 34rpx 28rpx;
  border: 1rpx solid #dceee7;
  border-radius: 30rpx;
  color: #17231f;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 44rpx rgba(32, 98, 76, 0.12);
}

.balance-label {
  display: block;
  color: #7d8782;
  font-size: 24rpx;
  font-weight: 800;
}

.balance-value {
  display: block;
  margin-top: 8rpx;
  color: #176f56;
  font-size: 58rpx;
  font-weight: 900;
}

.points-card {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.points-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.points-label,
.points-worth-label {
  display: block;
  color: #7d8782;
  font-size: 22rpx;
}

.points-value {
  display: block;
  margin-top: 6rpx;
  color: #17231f;
  font-size: 42rpx;
  font-weight: 900;
}

.points-worth {
  min-width: 180rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid #edf1ee;
}

.points-worth-value {
  display: block;
  margin-top: 6rpx;
  color: #d85b3d;
  font-size: 34rpx;
  font-weight: 900;
}

.points-rule {
  display: block;
  margin-top: 18rpx;
  color: #89948f;
  font-size: 22rpx;
  line-height: 1.5;
}

.section-title {
  margin: 30rpx 4rpx 16rpx;
  color: #17231f;
  font-size: 28rpx;
  font-weight: 900;
}

.tiers {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.tier-card {
  position: relative;
  padding: 28rpx 24rpx;
  border: 2rpx solid #edf1ee;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(32, 98, 76, 0.06);
}

.tier-card.selected {
  border-color: #176f56;
  background: #eef8f3;
}

.tier-main {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.tier-amount {
  color: #17231f;
  font-size: 38rpx;
  font-weight: 900;
}

.tier-bonus {
  color: #d85b3d;
  font-size: 22rpx;
  font-weight: 800;
}

.tier-label {
  display: block;
  margin-top: 8rpx;
  color: #89948f;
  font-size: 20rpx;
}

.tier-check {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  background: #176f56;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -14rpx 34rpx rgba(32, 98, 76, 0.08);
}

.recharge-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: #176f56;
}

.recharge-btn.disabled {
  opacity: 0.5;
}
