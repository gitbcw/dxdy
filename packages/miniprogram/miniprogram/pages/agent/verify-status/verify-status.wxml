<view class="page">
  <view class="status-card {{statusCopy.tone}}">
    <view class="status-icon">{{statusCopy.icon}}</view>
    <text class="status-title">{{statusCopy.title}}</text>
    <text class="status-desc">{{statusCopy.desc}}</text>
  </view>

  <view wx:if="{{status !== 'none'}}" class="info-card">
    <view class="info-row">
      <text class="info-label">联系人</text>
      <text class="info-value">{{info.contactName || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">联系电话</text>
      <text class="info-value">{{info.contactPhone || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">提交时间</text>
      <text class="info-value">{{info.submittedAt || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">身份证号码</text>
      <text class="info-value">{{info.idNumber || '-'}}</text>
    </view>
    <view class="material-row">
      <text class="info-label">身份证照片</text>
      <view class="id-card-images">
        <view class="id-card-image">
          <image wx:if="{{info.idCardFront}}" src="{{info.idCardFront}}" mode="aspectFill" />
          <text wx:else>未上传正面</text>
        </view>
        <view class="id-card-image">
          <image wx:if="{{info.idCardBack}}" src="{{info.idCardBack}}" mode="aspectFill" />
          <text wx:else>未上传反面</text>
        </view>
      </view>
    </view>
  </view>

  <view class="timeline">
    <view class="step active">
      <text>提交资料</text>
      <text>填写身份信息、上传身份证照片和渠道资源</text>
    </view>
    <view class="step {{status === 'pending_review' || status === 'approved' || status === 'rejected' ? 'active' : ''}}">
      <text>平台审核</text>
      <text>核对身份材料、客户资源和业务能力</text>
    </view>
    <view class="step {{status === 'approved' ? 'active' : ''}}">
      <text>开通代理商</text>
      <text>获得推广码、客户管理和提成中心</text>
    </view>
  </view>

  <view wx:if="{{status === 'approved'}}" class="action-grid">
    <view class="ghost-btn" bindtap="onPromoteTap">推广工具</view>
    <view class="primary-btn" bindtap="onCommissionTap">提成中心</view>
  </view>
  <view wx:elif="{{status === 'pending_review'}}" class="single-action ghost-btn" bindtap="onBackTap">返回</view>
  <view wx:else class="single-action primary-btn" bindtap="onApplyTap">{{status === 'rejected' ? '重新提交' : '提交申请'}}</view>
</view>
