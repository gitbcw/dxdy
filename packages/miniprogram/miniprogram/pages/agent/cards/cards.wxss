.page { padding: 0 0 env(safe-area-inset-bottom); }

.filter-bar {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.filter-item {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  background: #f5f5f5;
  color: #666;
}
.filter-item.active { background: #1890ff; color: #fff; }

.summary { padding: 16rpx 32rpx; font-size: 24rpx; color: #999; }

.card-list { padding: 16rpx 24rpx; }

.card-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.card-item.status-voided { opacity: 0.6; }

.card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.card-no { font-size: 24rpx; color: #999; font-family: monospace; }
.card-status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.status-ungifted { background: #fff7e6; color: #d48806; }
.status-gifted { background: #e6f7ff; color: #0958d9; }
.status-claimed { background: #f6ffed; color: #389e0d; }
.status-redeemed { background: #f9f0ff; color: #531dab; }
.status-voided { background: #f0f0f0; color: #999; }

.card-body { margin-bottom: 8rpx; }
.card-product { display: block; font-size: 30rpx; font-weight: 500; color: #333; margin-bottom: 4rpx; }
.card-meta { display: block; font-size: 24rpx; color: #999; }

.card-footer { padding-top: 8rpx; border-top: 1rpx solid #f5f5f5; }
.card-holder { font-size: 24rpx; color: #666; }

.card-actions { display: flex; justify-content: flex-end; margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid #f5f5f5; }
.btn-gift {
  padding: 8rpx 32rpx;
  background: #1890ff;
  color: #fff;
  font-size: 26rpx;
  border-radius: 8rpx;
}

.empty { text-align: center; padding: 80rpx 0; color: #ccc; font-size: 28rpx; }

/* 首页风格统一覆盖 */
.page {
  min-height: 100vh;
  padding: 34rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 46%, #ffffff 100%);
  box-sizing: border-box;
}

.hero,
.card-item,
.empty {
  border: 1rpx solid #edf3ef;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.hero {
  padding: 30rpx;
  color: #17352b;
  background: linear-gradient(135deg, #f7fdf9 0%, #e9f8f1 100%);
}

.eyebrow {
  display: block;
  color: #176f56;
  font-size: 23rpx;
  font-weight: 900;
}

.title {
  display: block;
  margin-top: 10rpx;
  color: #17231f;
  font-size: 40rpx;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  color: #68776f;
  font-size: 24rpx;
  line-height: 1.6;
}

.filter-bar {
  margin: 20rpx 0 14rpx;
  padding: 0;
  border-bottom: 0;
  background: transparent;
}

.filter-item {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #edf4f3;
  color: #627678;
}

.filter-item.active {
  color: #ffffff;
  font-weight: 900;
  background: #176f56;
}

.summary {
  margin-top: 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid #edf3ef;
  border-radius: 24rpx;
  color: #68776f;
  background: rgba(255, 255, 255, 0.9);
}

.card-list {
  padding: 16rpx 0 0;
}

.card-product {
  color: #17231f;
  font-weight: 900;
}

.card-meta,
.card-holder,
.card-no {
  color: #68776f;
}

.card-status,
.btn-gift {
  border-radius: 999rpx;
  font-weight: 900;
}

.btn-gift {
  background: #176f56;
}
