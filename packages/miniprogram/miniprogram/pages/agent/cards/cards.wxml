<view class="page">
  <view class="hero">
    <text class="eyebrow">代理商专属</text>
    <text class="title">我的卡券</text>
    <text class="subtitle">查看已购买卡券、赠送状态和客户认领情况。</text>
  </view>

  <scroll-view scroll-x class="filter-bar">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="filter-item {{activeFilter === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onFilterTap"
    >{{item.label}}</view>
  </scroll-view>

  <view class="summary">{{summaryText}}</view>

  <view class="card-list">
    <view wx:for="{{visibleCards}}" wx:key="id" class="card-item status-{{item.status}}" bindtap="onCardTap" data-id="{{item.id}}">
      <view class="card-header">
        <text class="card-no">{{item.cardNo}}</text>
        <text class="card-status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="card-body">
        <text class="card-product">{{item.productName}}</text>
        <text class="card-meta">抵扣金额：¥{{item.amountText}}</text>
      </view>
      <view wx:if="{{item.currentHolderName}}" class="card-footer">
        <text class="card-holder">持有人：{{item.currentHolderName}}</text>
      </view>
      <view wx:if="{{item.status === 'ungifted'}}" class="card-actions">
        <view class="btn-gift" catchtap="onGiftTap" data-id="{{item.id}}">赠送</view>
      </view>
    </view>

    <view wx:if="{{visibleCards.length === 0}}" class="empty">
      <text>暂无卡券</text>
    </view>
  </view>
</view>
