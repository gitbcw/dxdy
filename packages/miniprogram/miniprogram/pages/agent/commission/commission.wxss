/* commission.wxss - 业务员佣金页 */

.commission-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-header {
  padding: 28rpx 4rpx 18rpx;
  animation: fadeIn 0.3s ease;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.summary-card {
  padding: 24rpx 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: var(--shadow-sm);
}

.summary-card.green {
  background: #edf9f1;
  border-color: #ccefd6;
}

.summary-card.blue {
  background: #eef5ff;
  border-color: #d6e8ff;
}

.summary-card.orange {
  background: #fff4e8;
  border-color: #ffd9b8;
}

.summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: var(--text-primary);
  line-height: 1.2;
}

.summary-card.orange .summary-value {
  color: var(--color-accent);
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 700;
}

/* ============ 底部按钮 ============ */
.btn-wrap {
  margin: 34rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  animation: fadeInUp 0.35s ease 0.22s backwards;
}

.btn-withdraw {
  width: 100%;
  padding: 28rpx 0;
  background: linear-gradient(180deg, #ff8a1f 0%, #ff5a00 100%);
  color: var(--text-inverse);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  border: none;
  transition: all 0.2s ease;
}

.btn-withdraw:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-lg);
}

.btn-withdraw.btn-disabled {
  background: var(--bg-section);
  color: var(--text-tertiary);
  box-shadow: none;
}

.withdraw-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ============ 提成明细列表 ============ */
.records-section {
  margin: 0 0 24rpx;
  animation: fadeInUp 0.35s ease 0.28s backwards;
}

.section-header {
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-records {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 64rpx 24rpx;
  text-align: center;
  border: 1rpx solid var(--border-color);
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.record-item {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--border-color);
}

.record-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-source {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.record-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.record-date {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.record-right {
  flex-shrink: 0;
  margin-left: 24rpx;
}

.record-amount {
  font-size: 34rpx;
  font-weight: 700;
}

.record-amount.positive {
  color: var(--color-primary);
}

.record-amount.negative {
  color: #DC3545;
}

/* 首页风格统一覆盖 */
.commission-page {
  padding: 34rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 48%, #ffffff 100%);
}

.page-header,
.summary-card,
.empty-records,
.record-item {
  border: 1rpx solid #edf3ef;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.page-header {
  margin-bottom: 22rpx;
  padding: 34rpx 30rpx;
  background: linear-gradient(135deg, rgba(226, 248, 237, 0.98) 0%, rgba(255, 255, 255, 0.98) 62%, rgba(255, 245, 229, 0.98) 100%);
}

.page-title {
  color: #10291f;
}

.page-subtitle,
.summary-label,
.record-desc,
.record-date,
.empty-text,
.withdraw-hint {
  color: #68776f;
}

.summary-grid {
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.summary-card,
.summary-card.green,
.summary-card.blue,
.summary-card.orange {
  border-color: #edf3ef;
  background: rgba(255, 255, 255, 0.96);
}

.summary-value,
.summary-card.orange .summary-value,
.record-amount.positive {
  color: #176f56;
}

.section-header {
  margin-bottom: 18rpx;
}

.section-title,
.record-source {
  color: #10291f;
  font-weight: 900;
}

.record-item {
  margin-bottom: 18rpx;
}

.btn-withdraw {
  border-radius: 999rpx;
  background: linear-gradient(180deg, #f1a24a 0%, #dc6a2c 100%);
  box-shadow: 0 16rpx 32rpx rgba(216, 91, 61, 0.18);
}

.btn-withdraw.btn-disabled {
  color: #9aa7a0;
  background: #eef3f0;
}
