<view class="commission-page">
  <view class="page-header">
    <text class="page-title">提成中心</text>
    <text class="page-subtitle">查看订单提成、冻结金额和可提现余额</text>
  </view>

  <view class="summary-grid">
    <view class="summary-card green">
      <text class="summary-label">累计提成</text>
      <text class="summary-value">¥{{summary.total}}</text>
    </view>
    <view class="summary-card blue">
      <text class="summary-label">冻结中</text>
      <text class="summary-value">¥{{summary.pending}}</text>
    </view>
    <view class="summary-card orange">
      <text class="summary-label">可提现</text>
      <text class="summary-value">¥{{summary.withdrawable}}</text>
    </view>
    <view class="summary-card">
      <text class="summary-label">已提现</text>
      <text class="summary-value">¥{{summary.withdrawn}}</text>
    </view>
  </view>

  <!-- 提成明细列表 -->
  <view class="records-section">
    <view class="section-header">
      <text class="section-title">提成明细</text>
    </view>
    <view wx:if="{{records.length === 0}}" class="empty-records">
      <text class="empty-text">暂无提成记录</text>
    </view>
    <view wx:for="{{records}}" wx:key="id" class="record-item">
      <view class="record-left">
        <text class="record-source">{{item.sourceLabel}} · {{item.statusLabel}}</text>
        <text class="record-desc">{{item.description}}</text>
        <text class="record-date">{{item.createdAt}}</text>
      </view>
      <view class="record-right">
        <text class="record-amount {{item.amountClass}}">{{item.amountText}}</text>
      </view>
    </view>
  </view>

  <view class="btn-wrap">
    <button
      class="btn-withdraw {{canWithdraw ? '' : 'btn-disabled'}}"
      disabled="{{!canWithdraw}}"
      bindtap="onWithdraw"
    >申请提现</button>
    <text class="withdraw-hint" wx:if="{{!canWithdraw}}">可提现金额需满100元</text>
  </view>
</view>
