.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f6f7f6;
  box-sizing: border-box;
}

.balance-card,
.card {
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 45, 32, 0.05);
}

.balance-card {
  padding: 34rpx 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #159447 0%, #18a34a 54%, #ff8a1f 100%);
}

.balance-label {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  opacity: 0.9;
}

.balance-value {
  display: block;
  margin-top: 10rpx;
  font-size: 58rpx;
  font-weight: 900;
}

.balance-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 23rpx;
  opacity: 0.9;
}

.card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  color: #17231f;
  font-size: 29rpx;
  font-weight: 900;
}

.card-action {
  color: #139445;
  font-size: 24rpx;
  font-weight: 900;
}

.bank-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: #17231f;
}

.bank-name,
.bank-no,
.bank-holder {
  display: block;
}

.bank-name {
  font-size: 28rpx;
  font-weight: 900;
}

.bank-no {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.bank-holder {
  margin-top: 14rpx;
  font-size: 23rpx;
  opacity: 0.8;
}

.bank-card-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 22rpx;
}

.delete-bank {
  padding: 10rpx 0 4rpx;
  color: #ffb4a6;
  font-size: 24rpx;
  font-weight: 900;
}

.empty-bank,
.empty-record {
  padding: 36rpx 0 12rpx;
  color: #7b8781;
  font-size: 24rpx;
  text-align: center;
}

.bank-form {
  margin-top: 20rpx;
  border-top: 1rpx solid #edf0ee;
}

.bank-warning {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #ffd2a8;
  border-radius: 14rpx;
  background: #fff7ed;
}

.bank-warning-title,
.bank-warning-desc {
  display: block;
}

.bank-warning-title {
  color: #c2410c;
  font-size: 24rpx;
  font-weight: 900;
}

.bank-warning-desc {
  margin-top: 8rpx;
  color: #9a3412;
  font-size: 22rpx;
  line-height: 1.45;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf0ee;
}

.field-label {
  flex-shrink: 0;
  color: #17231f;
  font-size: 25rpx;
  font-weight: 900;
}

.field-input {
  flex: 1;
  min-width: 0;
  color: #17231f;
  font-size: 25rpx;
  text-align: right;
}

.save-btn,
.primary-btn {
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
  background: #ff7a1a;
}

.save-btn {
  margin-top: 20rpx;
  background: #18a34a;
}

.amount-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf0ee;
}

.money-symbol {
  color: #17231f;
  font-size: 42rpx;
  font-weight: 900;
}

.amount-input {
  flex: 1;
  min-width: 0;
  color: #17231f;
  font-size: 42rpx;
  font-weight: 900;
}

.hint {
  display: block;
  margin: 18rpx 0 22rpx;
  color: #7b8781;
  font-size: 23rpx;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #edf0ee;
}

.record-row:first-of-type {
  border-top: 0;
}

.record-amount {
  display: block;
  color: #17231f;
  font-size: 28rpx;
  font-weight: 900;
}

.record-meta {
  display: block;
  margin-top: 8rpx;
  color: #7b8781;
  font-size: 22rpx;
}

.status {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #69756f;
  font-size: 22rpx;
  font-weight: 900;
  background: #edf1ee;
}

.status.pending_review {
  color: #b46b00;
  background: #fff4dc;
}

.status.approved,
.status.paid {
  color: #139445;
  background: #e8f8ee;
}

.status.rejected {
  color: #ef4444;
  background: #fff1ed;
}

/* 首页风格统一覆盖 */
.page {
  padding: 34rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 48%, #ffffff 100%);
}

.balance-card,
.card {
  border: 1rpx solid #edf3ef;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.balance-card {
  padding: 36rpx 30rpx;
  color: #10291f;
  background: linear-gradient(135deg, rgba(226, 248, 237, 0.98) 0%, rgba(255, 255, 255, 0.98) 62%, rgba(255, 245, 229, 0.98) 100%);
}

.balance-label {
  color: #176f56;
}

.balance-value {
  color: #10291f;
}

.balance-row {
  color: #68776f;
}

.card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.card-title,
.field-label,
.money-symbol,
.amount-input,
.record-amount {
  color: #10291f;
}

.card-action {
  color: #176f56;
}

.bank-card {
  border-radius: 24rpx;
  background: linear-gradient(135deg, #176f56 0%, #1e8b68 100%);
  box-shadow: 0 14rpx 30rpx rgba(23, 111, 86, 0.2);
}

.bank-warning {
  border-color: #f5d3bd;
  border-radius: 20rpx;
  background: #fff7f1;
}

.field-row,
.amount-box,
.record-row {
  border-color: #edf3ef;
}

.empty-bank,
.empty-record,
.hint,
.record-meta {
  color: #68776f;
}

.save-btn,
.primary-btn {
  border-radius: 999rpx;
}

.save-btn {
  background: #176f56;
  box-shadow: 0 12rpx 26rpx rgba(23, 111, 86, 0.16);
}

.primary-btn {
  background: linear-gradient(180deg, #f1a24a 0%, #dc6a2c 100%);
  box-shadow: 0 14rpx 30rpx rgba(216, 91, 61, 0.18);
}

.status.approved,
.status.paid {
  color: #176f56;
  background: #e9f7ef;
}
