<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{customer}}">
    <view class="profile-card">
      <view class="avatar">{{customer.nickname ? customer.nickname[0] : '客'}}</view>
      <view class="profile-main">
        <text class="name">{{customer.nickname || customer.phone}}</text>
        <view class="tag-row">
          <text class="tag">{{typeText}}</text>
          <text class="tag muted">{{verifyText}}</text>
        </view>
      </view>
    </view>

    <view class="stat-grid">
      <view class="stat-card">
        <text class="stat-value">{{stats.orderCount}}</text>
        <text class="stat-label">累计订单</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">¥{{stats.totalAmountText}}</text>
        <text class="stat-label">累计成交</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">¥{{stats.monthAmountText}}</text>
        <text class="stat-label">本月成交</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">¥{{stats.commissionAmountText}}</text>
        <text class="stat-label">贡献提成</text>
      </view>
    </view>

    <view class="info-card">
      <view class="info-row">
        <text class="info-label">手机号</text>
        <text class="info-value">{{phoneText || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">绑定时间</text>
        <text class="info-value">{{customer.boundAt || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">售后次数</text>
        <text class="info-value">{{stats.afterSaleCount}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{trendBars.length > 0}}">
      <view class="section-head">
        <text class="section-title">成交趋势</text>
        <text class="section-more">近 {{trendBars.length}} 单</text>
      </view>
      <view class="trend-chart">
        <view wx:for="{{trendBars}}" wx:key="id" class="trend-item">
          <view class="bar-wrap">
            <view class="bar" style="height: {{item.height}}rpx;"></view>
          </view>
          <text class="bar-amount">¥{{item.amountText}}</text>
          <text class="bar-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">最近订单</text>
        <text class="section-more" bindtap="onOrdersTap">查看全部 ></text>
      </view>
      <view wx:if="{{recentOrders.length === 0}}" class="empty">暂无订单</view>
      <view wx:else>
        <view wx:for="{{recentOrders}}" wx:key="id" class="order-card">
          <view>
            <text class="order-no">{{item.orderNo}}</text>
            <text class="order-meta">{{item.createdAt}} · {{item.statusText}}</text>
          </view>
          <text class="order-amount">¥{{item.amountText}}</text>
        </view>
      </view>
    </view>

    <view class="action-grid">
      <view class="ghost-btn" bindtap="onCallTap">联系客户</view>
      <view class="primary-btn" bindtap="onOrdersTap">客户订单</view>
    </view>
  </view>
</view>
