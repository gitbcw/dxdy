<view class="page">
  <view class="visual-card">
    <image src="{{promotionImage}}" mode="aspectFill" />
  </view>

  <view class="profile-card">
    <view class="avatar">代</view>
    <view class="profile-main">
      <text class="name">{{agentName}}</text>
      <text class="role">大熊动医 · 代理商</text>
    </view>
    <view class="id-pill">ID: {{promoCode}}</view>
  </view>

  <view class="qrcode-card">
    <text class="card-title">我的专属推广码</text>
    <image wx:if="{{qrcodeUrl}}" class="qrcode-img" src="{{qrcodeUrl}}" mode="aspectFit" />
    <view wx:else class="qrcode-img qrcode-loading">{{loading ? '二维码生成中' : '二维码暂不可用'}}</view>
    <text class="qrcode-hint">扫描二维码，客户即可成为我的推广关系</text>
    <view class="stats-row">
      <view class="stat">
        <text class="stat-label">扫码访问</text>
        <text class="stat-value">{{stats.scanVisits}}</text>
      </view>
      <view class="stat">
        <text class="stat-label">注册客户</text>
        <text class="stat-value">{{stats.registeredCustomers}}</text>
      </view>
      <view class="stat">
        <text class="stat-label">下单客户</text>
        <text class="stat-value">{{stats.orderedCustomers}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-actions">
    <view class="ghost-btn" bindtap="onSaveQrcode">保存二维码</view>
    <button class="share-btn" open-type="share">分享给微信好友</button>
  </view>
</view>
