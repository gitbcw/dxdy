.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f6f7f6;
  box-sizing: border-box;
}

.hero,
.summary-card,
.order-card,
.empty-state {
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 45, 32, 0.05);
}

.hero {
  padding: 30rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0f7a3e 0%, #18a34a 58%, #ff8a1f 100%);
}

.eyebrow {
  display: block;
  font-size: 23rpx;
  font-weight: 900;
  opacity: 0.88;
}

.title {
  display: block;
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  opacity: 0.9;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.summary-card {
  padding: 22rpx 14rpx;
}

.summary-value {
  display: block;
  color: #139445;
  font-size: 30rpx;
  font-weight: 900;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  color: #69756f;
  font-size: 22rpx;
}

.tabs {
  margin: 20rpx 0 14rpx;
  white-space: nowrap;
}

.tab {
  display: inline-block;
  margin-right: 14rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  color: #627678;
  font-size: 24rpx;
  background: #edf4f3;
}

.tab.active {
  color: #ffffff;
  font-weight: 900;
  background: #18a34a;
}

.empty-state {
  padding: 72rpx 24rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #17231f;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  color: #7b8781;
  font-size: 24rpx;
}

.order-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.order-head,
.customer-row,
.goods-row {
  display: flex;
  align-items: center;
}

.order-head {
  justify-content: space-between;
  gap: 18rpx;
}

.order-no {
  display: block;
  color: #17231f;
  font-size: 28rpx;
  font-weight: 900;
}

.order-date {
  display: block;
  margin-top: 6rpx;
  color: #7b8781;
  font-size: 22rpx;
}

.status {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #139445;
  font-size: 22rpx;
  font-weight: 900;
  background: #e8f8ee;
}

.customer-row {
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #f7faf8;
}

.customer-name {
  color: #17231f;
  font-size: 25rpx;
  font-weight: 900;
}

.customer-type {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #139445;
  font-size: 20rpx;
  font-weight: 800;
  background: #e8f8ee;
}

.arrow {
  margin-left: auto;
  color: #8a958f;
  font-size: 28rpx;
}

.goods-row {
  gap: 18rpx;
  margin-top: 18rpx;
}

.goods-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 14rpx;
  color: #139445;
  font-size: 28rpx;
  font-weight: 900;
  background: #edf7ef;
}

.goods-main {
  flex: 1;
  min-width: 0;
}

.goods-name {
  display: block;
  color: #17231f;
  font-size: 25rpx;
  font-weight: 900;
}

.goods-meta {
  display: block;
  margin-top: 8rpx;
  color: #6d7872;
  font-size: 22rpx;
  line-height: 1.45;
}

.return-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #ef5b2a;
  font-size: 20rpx;
  font-weight: 900;
  background: #fff1ed;
}

.amount {
  flex-shrink: 0;
  color: #ff6a00;
  font-size: 28rpx;
  font-weight: 900;
}
