<view class="page">
  <view class="hero">
    <text class="eyebrow">代理商订单</text>
    <text class="title">客户订单跟进</text>
    <text class="subtitle">查看绑定客户订单、支付状态和预计提成。</text>
  </view>

  <view class="summary-grid">
    <view wx:for="{{summaryCards}}" wx:key="label" class="summary-card">
      <text class="summary-value">{{item.value}}</text>
      <text class="summary-label">{{item.label}}</text>
    </view>
  </view>

  <scroll-view scroll-x class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{isEmpty}}" class="empty-state">
    <text class="empty-title">暂无订单</text>
    <text class="empty-desc">当前筛选下没有客户订单</text>
  </view>

  <view wx:else class="order-list">
    <view wx:for="{{visibleOrders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="onOrderTap">
      <view class="order-head">
        <view>
          <text class="order-no">{{item.orderNo || item.id}}</text>
          <text class="order-date">{{item.dateText}}</text>
        </view>
        <text class="status">{{item.statusText}}</text>
      </view>

      <view class="customer-row" data-id="{{item.customerId}}" catchtap="onCustomerTap">
        <text class="customer-name">{{item.customerName}}</text>
        <text class="customer-type">{{item.customerTypeText}}</text>
        <text class="arrow">›</text>
      </view>

      <view class="goods-row">
        <view class="goods-icon">单</view>
        <view class="goods-main">
          <text class="goods-name">{{item.itemText}}</text>
          <text class="goods-meta">共 {{item.itemCount}} 件 · {{item.commissionText}}</text>
          <text wx:if="{{item.returnText}}" class="return-tag">{{item.returnText}}</text>
        </view>
        <text class="amount">¥{{item.amountText}}</text>
      </view>
    </view>
  </view>
</view>
