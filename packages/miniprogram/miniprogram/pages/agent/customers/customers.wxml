<view class="page">
  <view class="hero">
    <text class="hero-eyebrow">代理商客户工作台</text>
    <text class="hero-title">客户管理</text>
    <text class="hero-subtitle">跟进绑定客户、采购贡献和售后风险。</text>
  </view>

  <view class="summary-grid">
    <view wx:for="{{summaryCards}}" wx:key="label" class="summary-card">
      <text class="summary-value">{{item.value}}</text>
      <text class="summary-label">{{item.label}}</text>
      <text class="summary-desc">{{item.desc}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">重点关注</text>
      <text class="section-more"></text>
    </view>
    <view class="focus-list">
      <view wx:if="{{focusCustomers.length === 0}}" class="focus-empty">
        <text class="focus-empty-title">暂无重点关注客户</text>
        <text class="focus-empty-desc">点击客户卡片右上角星标后会显示在这里</text>
      </view>
      <view wx:for="{{focusCustomers}}" wx:key="id" class="focus-card" data-id="{{item.id}}" bindtap="onCustomerTap">
        <view class="focus-top">
          <text class="focus-badge">{{item.priorityTag}}</text>
          <text class="focus-amount">¥{{item.amountText}}</text>
        </view>
        <text class="focus-name">{{item.nickname}}</text>
        <text class="focus-desc">{{item.priorityText}}</text>
        <text class="focus-meta">下单 {{item.orderCount}} 次 · 售后 {{item.exchangeCount}} 次</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-x class="filters">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="filter-pill {{activeFilter === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onFilterTap"
    >
      {{item.label}} {{item.count}}
    </view>
  </scroll-view>

  <view wx:if="{{visibleCustomers.length === 0}}" class="empty-state">
    <text class="empty-title">暂无客户</text>
    <text class="empty-desc">当前筛选下没有绑定客户</text>
  </view>

  <view wx:else class="customer-list">
    <block wx:for="{{visibleCustomers}}" wx:key="id">
      <view class="customer-card" data-id="{{item.id}}" bindtap="onCustomerTap">
        <button
          class="focus-toggle {{item.isFocused ? 'active' : ''}}"
          plain
          hover-class="focus-toggle-hover"
          data-id="{{item.id}}"
          catchtap="onFocusToggle"
          aria-label="{{item.isFocused ? '取消重点关注' : '设为重点关注'}}"
        >
          <text class="focus-toggle-icon">{{item.isFocused ? '★' : '☆'}}</text>
        </button>
        <view class="avatar">
          <text class="avatar-text">{{item.avatarText}}</text>
        </view>

        <view class="info">
          <view class="name-row">
            <text class="name">{{item.nickname}}</text>
            <text class="type-tag tag-institution">医院</text>
          </view>

          <view class="stats-row">
            <text class="stat-text">下单 {{item.orderCount}} 次</text>
            <text class="stat-divider"></text>
            <text class="stat-text">累计 ¥{{item.amountText}}</text>
          </view>

          <text class="priority-text">{{item.priorityText}}</text>
          <text class="meta-text">绑定 {{item.boundAtText}} · 最近 {{item.lastOrderText}}</text>

          <view class="exchange-row" wx:if="{{item.exchangeCount > 0}}">
            <text class="exchange-tag">售后 {{item.exchangeCount}} 次</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
