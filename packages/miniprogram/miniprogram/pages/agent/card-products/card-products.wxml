<view class="page">
  <view class="hero">
    <text class="eyebrow">代理商专属</text>
    <text class="title">购买卡券</text>
    <text class="subtitle">购买后可在“我的卡券”中赠送给机构客户，客户认领后兑换血包商品。</text>
  </view>

  <view wx:if="{{cards.length === 0 && !loading}}" class="empty-state">
    <text class="empty-title">暂无可购买卡券</text>
    <text class="empty-desc">请稍后再来查看后台新增的未赠送卡券</text>
  </view>

  <view wx:else class="product-list">
    <view
      wx:for="{{cards}}"
      wx:key="id"
      class="product-card"
      data-id="{{item.id}}"
    >
      <view class="product-img">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFit" />
        <text wx:else>卡券</text>
      </view>
      <view class="product-main">
        <view class="name-row">
          <text class="product-name">{{item.name}}</text>
          <text class="status-tag">未赠送</text>
        </view>
        <text class="product-spec">{{item.specText}}</text>
        <view class="tag-row">
          <text class="tag green">卡券库存</text>
          <text class="tag">{{item.redeemText}}</text>
        </view>
        <view class="bottom-row">
          <view class="price-box">
            <text class="price">¥{{item.priceText}}</text>
            <text class="deduction">抵扣 ¥{{item.deductionText}}</text>
          </view>
          <view class="buy-btn" data-id="{{item.id}}" catchtap="onBuyTap">
            {{purchasingId === item.id ? '购买中' : '购买'}}
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
