<view class="page">
  <view class="hero">
    <text class="eyebrow">代理商专属</text>
    <text class="title">购买卡券</text>
    <text class="subtitle">购买后可在“我的卡券”中赠送给机构客户，客户认领后兑换血包商品。</text>
  </view>

  <view wx:if="{{products.length === 0 && !loading}}" class="empty-state">
    <text class="empty-title">暂无可购买卡券</text>
    <text class="empty-desc">请稍后再来查看上架的血包卡券商品</text>
  </view>

  <view wx:else class="product-list">
    <view
      wx:for="{{products}}"
      wx:key="id"
      class="product-card"
      data-id="{{item.id}}"
      bindtap="onProductTap"
    >
      <view class="product-img">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFit" />
        <text wx:else>卡券</text>
      </view>
      <view class="product-main">
        <view class="name-row">
          <text class="product-name">{{item.name}}</text>
          <text class="status-tag">上架中</text>
        </view>
        <text class="product-spec">{{item.specText}}</text>
        <view class="tag-row">
          <text class="tag green">血包兑换</text>
          <text class="tag">{{item.redeemText}}</text>
        </view>
        <view class="bottom-row">
          <text class="price">¥{{item.priceText}}</text>
          <text class="stock">{{item.stockText}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
