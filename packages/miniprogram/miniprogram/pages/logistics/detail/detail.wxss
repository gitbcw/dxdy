.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f8f7;
  box-sizing: border-box;
}

.status-card,
.info-card,
.track-card {
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(30, 44, 40, 0.06);
}

.status-card {
  position: relative;
  min-height: 210rpx;
  padding: 32rpx;
  background: #ecf8ef;
  overflow: hidden;
}

.status-main {
  position: relative;
  z-index: 1;
  max-width: 390rpx;
  flex: 1;
  min-width: 0;
}

.status-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.status-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(236, 248, 239, 0.98) 0%, rgba(236, 248, 239, 0.80) 44%, rgba(236, 248, 239, 0.06) 100%);
}

.status {
  display: block;
  color: #18a44a;
  font-size: 40rpx;
  font-weight: 900;
}

.desc,
.track-time,
.track-desc {
  display: block;
  margin-top: 6rpx;
  color: #7d8782;
  font-size: 23rpx;
}

.info-card,
.track-card {
  margin-top: 18rpx;
  padding: 12rpx 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0ee;
  color: #6b7670;
  font-size: 24rpx;
}

.row text:last-child {
  flex: 1;
  min-width: 0;
  color: #17201b;
  font-weight: 800;
  text-align: right;
  word-break: break-all;
}

.track {
  position: relative;
  padding: 18rpx 0 22rpx 48rpx;
}

.track::before {
  content: '';
  position: absolute;
  z-index: 1;
  left: 4rpx;
  top: 28rpx;
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #cfd7d2;
  box-shadow: 0 0 0 1rpx #cfd7d2;
}

.track.active::before {
  background: #18a44a;
  box-shadow: 0 0 0 1rpx #18a44a;
}

.track-line {
  position: absolute;
  left: 15rpx;
  top: 52rpx;
  bottom: -20rpx;
  width: 2rpx;
  background: #dfe7e2;
}

.track-title {
  display: block;
  color: #17201b;
  font-size: 26rpx;
  font-weight: 900;
}

.empty {
  padding: 120rpx 0;
  color: #7d8782;
  font-size: 26rpx;
  text-align: center;
}
