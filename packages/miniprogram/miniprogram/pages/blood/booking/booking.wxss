.page {
  min-height: 100vh;
  padding: 24rpx;
  background:
    radial-gradient(circle at 0% 0%, rgba(10, 110, 124, 0.12), transparent 34%),
    linear-gradient(180deg, #f3fbfa 0%, #ffffff 100%);
  box-sizing: border-box;
}

.hero-card,
.matcher-card,
.rules-card,
.tips-card,
.product-card,
.empty-card {
  border-radius: 18rpx;
  box-shadow: 0 16rpx 42rpx rgba(23, 61, 64, 0.08);
}

.hero-card {
  padding: 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #064068 0%, #0a6e7c 58%, #159c88 100%);
}

.hero-brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hero-logo {
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 18rpx;
  background: #ffffff;
}

.hero-tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #083d45;
  font-size: 22rpx;
  font-weight: 800;
  background: #dff7ed;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.82);
}

.content {
  margin-top: 20rpx;
}

.tips-card,
.matcher-card,
.rules-card,
.product-card,
.empty-card {
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.94);
}

.matcher-card,
.rules-card {
  margin-bottom: 20rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-head.compact {
  margin-bottom: 18rpx;
}

.section-kicker {
  display: block;
  color: #0a6e7c;
  font-size: 22rpx;
  font-weight: 900;
}

.section-title {
  display: block;
  margin-top: 6rpx;
  color: #173236;
  font-size: 30rpx;
  font-weight: 900;
}

.species-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #eef7f6;
}

.species-tab {
  flex: 1;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 12rpx;
  color: #64787b;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}

.species-tab.active {
  color: #ffffff;
  background: #0a6e7c;
}

.picker-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.picker-box {
  min-height: 116rpx;
  padding: 20rpx;
  border: 1rpx solid #dfeceb;
  border-radius: 16rpx;
  background: #fbfefd;
  box-sizing: border-box;
}

.picker-label {
  display: block;
  color: #7a8a8d;
  font-size: 21rpx;
}

.picker-value {
  display: block;
  margin-top: 12rpx;
  color: #173236;
  font-size: 26rpx;
  font-weight: 900;
  word-break: break-all;
}

.result-box {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 16rpx;
}

.result-box.safe {
  color: #075f35;
  background: #e8f8ee;
}

.result-box.warn {
  color: #8a5400;
  background: #fff5db;
}

.result-box.danger {
  color: #9f1d22;
  background: #fff0f0;
}

.result-title {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
}

.result-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
}

.guide-summary {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf2f0;
}

.guide-title,
.guide-desc,
.guide-rule,
.guide-note {
  display: block;
}

.guide-title {
  color: #173236;
  font-size: 26rpx;
  font-weight: 900;
}

.guide-desc,
.guide-note {
  margin-top: 10rpx;
  color: #617276;
  font-size: 23rpx;
  line-height: 1.55;
}

.guide-rule {
  margin-top: 12rpx;
  color: #0a6e7c;
  font-size: 24rpx;
  line-height: 1.55;
  font-weight: 800;
}

.rule-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #edf2f0;
}

.rule-item:first-of-type {
  border-top: 0;
}

.rule-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.rule-type {
  color: #173236;
  font-size: 27rpx;
  font-weight: 900;
}

.rule-tag {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #0a6e7c;
  font-size: 20rpx;
  font-weight: 900;
  background: #e8f6f4;
}

.rule-text,
.rule-risk,
.rule-note {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.rule-text {
  color: #4d6265;
}

.rule-risk {
  color: #9f1d22;
}

.rule-note {
  color: #738487;
}

.tips-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tip-label {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #0a6e7c, #159888);
}

.tip-text {
  flex: 1;
  color: #173236;
  font-size: 24rpx;
  line-height: 1.55;
}

.safety-line {
  display: flex;
  gap: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #edf2f0;
}

.safety-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: #0a6e7c;
}

.safety-text {
  flex: 1;
  color: #5f7073;
  font-size: 23rpx;
  line-height: 1.6;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.product-section-head {
  margin-top: 4rpx;
}

.product-section-desc {
  display: block;
  margin-top: 8rpx;
  color: #6f8183;
  font-size: 23rpx;
  line-height: 1.5;
}

.recommend-summary {
  display: block;
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #0a6e7c;
  font-size: 23rpx;
  line-height: 1.5;
  font-weight: 800;
  background: #e8f6f4;
}

.product-head,
.product-foot {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.product-name {
  display: block;
  color: #173236;
  font-size: 30rpx;
  font-weight: 900;
}

.product-spec {
  display: block;
  margin-top: 10rpx;
  color: #6f8183;
  font-size: 22rpx;
}

.product-price {
  flex-shrink: 0;
  color: #b77800;
  font-size: 30rpx;
  font-weight: 900;
}

.match-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.blood-chip,
.match-chip {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 900;
}

.blood-chip {
  color: #0a6e7c;
  background: #e8f6f4;
}

.match-chip.safe {
  color: #075f35;
  background: #e8f8ee;
}

.match-chip.warn {
  color: #8a5400;
  background: #fff5db;
}

.match-chip.danger {
  color: #9f1d22;
  background: #fff0f0;
}

.match-desc {
  display: block;
  margin-top: 12rpx;
  color: #52666a;
  font-size: 23rpx;
  line-height: 1.55;
}

.product-desc {
  display: block;
  margin-top: 18rpx;
  color: #5f7073;
  font-size: 24rpx;
  line-height: 1.6;
}

.product-foot {
  align-items: center;
  margin-top: 20rpx;
}

.product-stock {
  color: #7a8a8d;
  font-size: 22rpx;
}

.empty-card {
  margin-top: 20rpx;
}

.empty-title {
  display: block;
  color: #173236;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  color: #6f8183;
  font-size: 24rpx;
  line-height: 1.6;
}

.primary-btn,
.ghost-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  min-width: 200rpx;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #063e46, #0a6e7c);
}

.ghost-btn {
  color: #0a6e7c;
  background: #eef7f6;
}

.primary-btn.small {
  margin-top: 0;
  min-width: 0;
  height: 68rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}
