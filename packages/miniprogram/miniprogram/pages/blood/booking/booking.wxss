.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 260rpx;
  background:
    radial-gradient(circle at 0% 0%, rgba(158, 35, 44, 0.1), transparent 34%),
    linear-gradient(180deg, #fff7f5 0%, #ffffff 100%);
  box-sizing: border-box;
}

.hero-card,
.form-card,
.tips-card,
.empty-card {
  border-radius: 24rpx;
  box-shadow: 0 16rpx 42rpx rgba(76, 34, 32, 0.08);
}

.hero-card {
  padding: 34rpx 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #6f1d23 0%, #a6343d 58%, #d66b55 100%);
}

.hero-tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #7a1d25;
  font-size: 22rpx;
  font-weight: 800;
  background: #ffe4dc;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  line-height: 1.65;
}

.content {
  margin-top: 20rpx;
}

.form-card,
.tips-card,
.empty-card {
  margin-top: 20rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.96);
}

.tips-card {
  margin-bottom: 80rpx;
}

.card-title {
  display: block;
  margin-bottom: 22rpx;
  color: #251819;
  font-size: 30rpx;
  font-weight: 900;
}

.species-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.species-card {
  min-height: 160rpx;
  padding: 22rpx;
  border: 2rpx solid #f0dfdc;
  border-radius: 20rpx;
  background: #fffaf9;
  box-sizing: border-box;
}

.species-card.active {
  border-color: #a6343d;
  background: #fff0ec;
}

.species-name {
  display: block;
  color: #251819;
  font-size: 30rpx;
  font-weight: 900;
}

.species-hint {
  display: block;
  margin-top: 12rpx;
  color: #7d6764;
  font-size: 22rpx;
  line-height: 1.45;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 88rpx;
  border-bottom: 1rpx solid #f1e6e4;
}

.field:last-child {
  border-bottom: 0;
}

.field.vertical {
  align-items: stretch;
  flex-direction: column;
  gap: 14rpx;
  padding: 24rpx 0 0;
}

.field-label {
  flex-shrink: 0;
  color: #4c3b39;
  font-size: 26rpx;
  font-weight: 800;
}

.picker-value,
.field-input {
  flex: 1;
  color: #251819;
  font-size: 26rpx;
  text-align: right;
}

.input-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  gap: 10rpx;
}

.input-unit {
  color: #7d6764;
  font-size: 24rpx;
}

.address-card {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 2rpx solid #f0dfdc;
  border-radius: 18rpx;
  background: #fffaf9;
}

.address-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.address-name {
  color: #251819;
  font-size: 28rpx;
  font-weight: 900;
}

.address-phone {
  margin-left: 16rpx;
  color: #7d6764;
  font-size: 24rpx;
  font-weight: 700;
}

.address-action {
  flex-shrink: 0;
  color: #a6343d;
  font-size: 24rpx;
  font-weight: 900;
}

.address-text {
  display: block;
  margin-top: 14rpx;
  color: #5c4947;
  font-size: 24rpx;
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.urgent-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1e6e4;
}

.urgent-switch {
  position: relative;
  flex-shrink: 0;
  width: 92rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: #e8e4e2;
  transition: background 0.16s ease;
}

.urgent-switch.active {
  background: #a6343d;
}

.urgent-switch-dot {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(76, 34, 32, 0.18);
  transition: transform 0.16s ease;
}

.urgent-switch.active .urgent-switch-dot {
  transform: translateX(38rpx);
}

.urgent-title,
.urgent-desc {
  display: block;
}

.urgent-title {
  color: #251819;
  font-size: 26rpx;
  font-weight: 900;
}

.urgent-desc {
  margin-top: 8rpx;
  color: #8b7774;
  font-size: 22rpx;
  line-height: 1.35;
}

.remark-card {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fff7f5;
}

.remark-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.remark-action {
  flex-shrink: 0;
  color: #a6343d;
  font-size: 24rpx;
  font-weight: 900;
}

.remark-preview {
  display: block;
  margin-top: 14rpx;
  min-height: 44rpx;
  color: #5c4947;
  font-size: 24rpx;
  line-height: 1.5;
}

.remark-preview.placeholder {
  color: #b7a7a4;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 14rpx;
}

.tip-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #a6343d;
}

.tip-text {
  flex: 1;
  color: #5c4947;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-title {
  display: block;
  color: #251819;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  color: #7d6764;
  font-size: 24rpx;
  line-height: 1.6;
}

.primary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  min-width: 200rpx;
  height: 78rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  background: #a6343d;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 126rpx;
  padding: 18rpx 24rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -10rpx 34rpx rgba(76, 34, 32, 0.08);
  box-sizing: border-box;
}

.submit-copy {
  min-width: 0;
  flex: 1;
}

.submit-title,
.submit-desc {
  display: block;
}

.submit-title {
  color: #251819;
  font-size: 26rpx;
  font-weight: 900;
}

.submit-desc {
  margin-top: 6rpx;
  color: #8b7774;
  font-size: 21rpx;
  line-height: 1.35;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.submit-btn {
  flex-shrink: 0;
  min-width: 210rpx;
  height: 78rpx;
  margin: 0;
  padding: 0 30rpx;
  border: 0;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 78rpx;
  background: linear-gradient(135deg, #7a1d25, #c54d42);
}

.submit-btn::after {
  border: 0;
}
