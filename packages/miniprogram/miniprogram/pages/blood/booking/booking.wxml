<view class="page">
  <view class="hero-card">
    <text class="hero-tag">门店用血预约</text>
    <text class="hero-title">犬/猫血预约</text>
    <text class="hero-desc">选择动物类型、血型和需求血量，提交后由客服确认库存、配血和配送安排。</text>
  </view>

  <view wx:if="{{!isInstitution && !isPersonalInvite}}" class="empty-card">
    <text class="empty-title">请通过医院二维码进入</text>
    <text class="empty-desc">个人客户需扫描医院客户提供的当天有效预约二维码后提交预约。</text>
  </view>

  <view wx:elif="{{isInstitution && !isVerified}}" class="empty-card">
    <text class="empty-title">完成门店认证后可预约</text>
    <text class="empty-desc">认证通过后即可提交犬/猫用血预约需求。</text>
    <view class="primary-btn" bindtap="onGoVerify">去认证</view>
  </view>

  <view wx:elif="{{inviteError}}" class="empty-card">
    <text class="empty-title">预约二维码不可用</text>
    <text class="empty-desc">{{inviteError}}</text>
  </view>

  <view wx:else class="content">
    <view wx:if="{{isInstitution && isVerified}}" class="share-card" bindtap="onShareConsumerTap">
      <view class="share-icon">码</view>
      <view class="share-copy">
        <text class="share-title">分享消费者预约</text>
        <text class="share-desc">生成预约二维码，个人客户扫码后可直接提交用血预约。</text>
      </view>
      <text class="share-action">去分享 ></text>
    </view>

    <view class="form-card">
      <text class="card-title">用血信息</text>
      <view class="species-grid">
        <view
          wx:for="{{speciesOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          class="species-card {{species === item.value ? 'active' : ''}}"
          bindtap="onSpeciesTap"
        >
          <text class="species-name">{{item.label}}</text>
          <text class="species-hint">{{item.hint}}</text>
        </view>
      </view>

      <view class="field">
        <text class="field-label">血型</text>
        <picker mode="selector" range="{{bloodTypes}}" value="{{bloodTypeIndex}}" bindchange="onBloodTypeChange">
          <view class="picker-value">{{bloodTypes[bloodTypeIndex]}} ></view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">需要血量</text>
        <picker mode="selector" range="{{volumeOptions}}" value="{{volumeIndex}}" bindchange="onVolumeChange">
          <view class="picker-value">{{volumeMl}} ml ></view>
        </picker>
      </view>
      <view class="price-row">
        <text class="price-label">{{priceMode === 'retail' ? '预约零售价' : '预约门店价'}}</text>
        <text class="price-value">¥{{bookingAmountText}}</text>
      </view>
      <view wx:if="{{isPersonalInvite && invite}}" class="invite-note">
        <text>由 {{invite.hospitalName}} 提供预约入口</text>
      </view>
    </view>

    <view class="form-card">
      <text class="card-title">预约信息</text>
      <view class="field">
        <text class="field-label">预约日期</text>
        <picker mode="date" value="{{bookingDate}}" start="{{minBookingDate}}" bindchange="onDateChange">
          <view class="picker-value">{{bookingDate}} ></view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">预约小时</text>
        <picker mode="selector" range="{{bookingHours}}" value="{{bookingHourIndex}}" bindchange="onHourChange">
          <view class="picker-value">{{bookingHours[bookingHourIndex]}} ></view>
        </picker>
      </view>
      <view class="address-card" bindtap="onAddressTap">
        <view class="address-head">
          <view>
            <text class="address-name">{{contactName || '请选择收货人'}}</text>
            <text wx:if="{{contactPhone}}" class="address-phone">{{contactPhone}}</text>
          </view>
          <text class="address-action">{{selectedAddress ? '更换' : '选择'}}</text>
        </view>
        <text class="address-text">{{addressText}} ></text>
      </view>
      <view class="urgent-row" bindtap="onUrgentToggle">
        <view>
          <text class="urgent-title">加急预约</text>
          <text class="urgent-desc">开启后客服会优先确认库存、配血与配送</text>
        </view>
        <view class="urgent-switch {{isUrgent ? 'active' : ''}}" aria-role="switch" aria-checked="{{isUrgent}}">
          <view class="urgent-switch-dot"></view>
        </view>
      </view>
      <view class="remark-card" bindtap="onRemarkTap">
        <view class="remark-head">
          <text class="field-label">备注</text>
          <text class="remark-action">{{remark ? '修改' : '填写'}}</text>
        </view>
        <text class="remark-preview {{remark ? '' : 'placeholder'}}">{{remark || '可填写受血动物情况、期望配送时间等'}}</text>
      </view>
    </view>

    <view class="tips-card">
      <text class="card-title">配血提示</text>
      <view wx:for="{{safetyTips}}" wx:key="*this" class="tip-item">
        <text class="tip-dot"></text>
        <text class="tip-text">{{item}}</text>
      </view>
    </view>

    <view class="submit-bar">
      <view class="submit-copy">
        <text class="submit-title">提交预约后等待确认</text>
        <text class="submit-desc">实际供血以客服确认和交叉配血结果为准</text>
      </view>
      <button class="submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">提交预约</button>
    </view>
  </view>
  <floating-actions showCart="{{false}}" />
</view>
