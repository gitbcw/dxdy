<view class="page">
  <view class="hero-card">
    <view class="hero-brand">
      <image class="hero-logo" src="{{brandLogo}}" mode="aspectFill" />
      <text class="hero-tag">机构预约</text>
    </view>
    <text class="hero-title">预约用血与血型匹配</text>
    <text class="hero-desc">结合犬猫输血血型规则，在预约前完成受血/供血匹配预判、临床风险确认和安全清单核对。</text>
  </view>

  <view class="content">
    <view class="matcher-card">
      <view class="section-head">
        <view>
          <text class="section-kicker">血型匹配助手</text>
          <text class="section-title">先确认风险，再预约血制品</text>
        </view>
      </view>

      <view class="species-tabs">
        <view
          wx:for="{{speciesTabs}}"
          wx:key="key"
          class="species-tab {{selectedSpecies === item.key ? 'active' : ''}}"
          data-species="{{item.key}}"
          bindtap="onSpeciesTap"
        >
          {{item.label}}
        </view>
      </view>

      <view class="picker-grid">
        <picker mode="selector" range="{{bloodTypeOptions}}" bindchange="onRecipientChange">
          <view class="picker-box">
            <text class="picker-label">受血方血型</text>
            <text class="picker-value">{{recipientType}}</text>
          </view>
        </picker>
        <picker mode="selector" range="{{bloodTypeOptions}}" bindchange="onDonorChange">
          <view class="picker-box">
            <text class="picker-label">供血方血型</text>
            <text class="picker-value">{{donorType}}</text>
          </view>
        </picker>
      </view>

      <view class="result-box {{compatibility.status}}">
        <text class="result-title">{{compatibility.title}}</text>
        <text class="result-desc">{{compatibility.desc}}</text>
      </view>

      <view class="guide-summary">
        <text class="guide-title">{{guide.label}}输血核心规则</text>
        <text class="guide-desc">{{guide.subtitle}}</text>
        <text class="guide-rule">{{guide.primaryRule}}</text>
        <text class="guide-note">{{guide.universalNote}}</text>
      </view>
    </view>

    <view class="rules-card">
      <view class="section-head compact">
        <text class="section-title">血型临床注意事项</text>
      </view>
      <view wx:for="{{guide.rules}}" wx:key="type" class="rule-item">
        <view class="rule-head">
          <text class="rule-type">{{item.type}}</text>
          <text class="rule-tag">{{item.tag}}</text>
        </view>
        <text class="rule-text">{{item.matching}}</text>
        <text class="rule-risk">{{item.risk}}</text>
        <text class="rule-note">{{item.attention}}</text>
      </view>
    </view>

    <view class="tips-card">
      <view class="tip-item" wx:for="{{guide.mustDo}}" wx:key="*this">
        <text class="tip-label">{{index + 1}}</text>
        <text class="tip-text">{{item}}</text>
      </view>
      <view class="safety-line" wx:for="{{commonSafety}}" wx:key="*this">
        <text class="safety-dot"></text>
        <text class="safety-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!isInstitution}}" class="empty-card">
    <text class="empty-title">当前仅机构客户可预约用血</text>
    <text class="empty-desc">请切换到机构客户身份后查看预约用血相关商品。</text>
    <view class="ghost-btn" bindtap="onGoCatalog">查看商品分类</view>
  </view>

  <view wx:elif="{{!isVerified}}" class="empty-card">
    <text class="empty-title">完成机构认证后可预约用血</text>
    <text class="empty-desc">认证通过后会展示可预约血制品及机构价格。</text>
    <view class="primary-btn" bindtap="onGoVerify">去认证</view>
  </view>

  <view wx:elif="{{isEmpty}}" class="empty-card">
    <text class="empty-title">当前暂无可预约血制品</text>
    <text class="empty-desc">可稍后再看，或前往分类页查看其他商品。</text>
    <view class="ghost-btn" bindtap="onGoCatalog">查看商品分类</view>
  </view>

  <view wx:else class="content booking-products">
    <view class="product-section-head">
      <text class="section-title">可预约血制品</text>
      <text class="product-section-desc">提交预约后由客服结合血型、库存和冷链时效确认。</text>
      <text class="recommend-summary">{{recommendationSummary}}</text>
    </view>
    <view class="list">
      <view wx:for="{{products}}" wx:key="id" class="product-card">
        <view class="product-head">
          <view>
            <text class="product-name">{{item.name}}</text>
            <text class="product-spec">{{item.specText}}</text>
          </view>
          <text class="product-price">¥{{item.priceText}}</text>
        </view>
        <view class="match-chip-row">
          <text class="blood-chip">血型 {{item.productBloodType}}</text>
          <text class="match-chip {{item.matchStatus}}">{{item.matchTitle}}</text>
        </view>
        <text class="match-desc">{{item.matchDesc}}</text>
        <text class="product-desc">{{item.description}}</text>
        <view class="product-foot">
          <text class="product-stock">{{item.stockText}}</text>
          <view class="primary-btn small" data-id="{{item.id}}" bindtap="onBookTap">立即预约</view>
        </view>
      </view>
    </view>
  </view>
  <floating-actions showCart="{{true}}" />
</view>
