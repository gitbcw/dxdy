<view class="page">
  <view class="brand-panel">
    <view class="brand-row">
      <view class="logo-mark">
        <image class="logo-icon" src="{{logoIcon}}" mode="aspectFit" />
      </view>
      <view>
        <text class="brand-name">大熊动医</text>
        <text class="brand-sub">创建你的账号</text>
      </view>
    </view>
  </view>

  <view class="form-card">
    <text class="title">账号注册</text>
    <text class="subtitle">先创建基础账号，医院客户和代理商注册后再补充认证资料</text>

    <view class="role-grid">
      <view
        wx:for="{{roleOptions}}"
        wx:key="key"
        class="role-item {{registerType === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onRoleTap"
      >
        <text class="role-title">{{item.title}}</text>
        <text class="role-desc">{{item.desc}}</text>
      </view>
    </view>

    <view class="field-row first">
      <image class="field-icon" src="{{phoneIcon}}" mode="aspectFit" />
      <input class="field-input" placeholder="手机号" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="field-row">
      <image class="field-icon" src="{{shieldIcon}}" mode="aspectFit" />
      <input class="field-input" placeholder="密码，至少 6 位" password value="{{password}}" data-field="password" bindinput="onInput" />
    </view>
    <view class="field-row">
      <image class="field-icon" src="{{shieldIcon}}" mode="aspectFit" />
      <input class="field-input" placeholder="确认密码" password value="{{confirmPassword}}" data-field="confirmPassword" bindinput="onInput" />
    </view>
    <view class="field-row">
      <view class="field-icon placeholder-icon"></view>
      <input class="field-input" placeholder="昵称或姓名（可选）" value="{{nickname}}" data-field="nickname" bindinput="onInput" />
    </view>

    <button class="submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">注册</button>
    <view class="login-link" bindtap="onLoginTap">已有账号，返回登录</view>
  </view>
</view>
