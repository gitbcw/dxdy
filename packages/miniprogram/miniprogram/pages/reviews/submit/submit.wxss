.page {
  min-height: 100vh;
  padding: 22rpx;
  padding-bottom: 140rpx;
  background: #f6f7f6;
  box-sizing: border-box;
}

.product-card {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  background: #f0f2f0;
}

.product-name {
  color: #17231f;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.rating-section,
.content-section {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.section-label {
  display: block;
  color: #17231f;
  font-size: 26rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.stars {
  display: flex;
  gap: 16rpx;
}

.star {
  font-size: 48rpx;
  color: #d4d8d5;
  transition: color 0.2s;
}

.star.active {
  color: #f59e0b;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e8ebe8;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  margin-top: 8rpx;
  color: #a2aaa6;
  font-size: 20rpx;
}

.submit-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(24, 45, 32, 0.08);
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  background: linear-gradient(180deg, #139445, #0f7f39);
}

.submit-btn.disabled {
  opacity: 0.5;
}
