.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f8f7;
  box-sizing: border-box;
}

.hero-card,
.card,
.conclusion,
.report-visual {
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(30, 44, 40, 0.06);
}

.report-visual {
  position: relative;
  min-height: 204rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
}

.report-visual image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.report-visual::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(238, 250, 242, 0.98) 0%, rgba(238, 250, 242, 0.78) 44%, rgba(238, 250, 242, 0.08) 100%);
}

.report-visual-copy {
  position: relative;
  z-index: 1;
  max-width: 390rpx;
  padding: 30rpx;
}

.report-visual-copy text:first-child {
  display: block;
  color: #147d3a;
  font-size: 34rpx;
  font-weight: 900;
}

.report-visual-copy text:last-child {
  display: block;
  margin-top: 10rpx;
  color: #52735c;
  font-size: 23rpx;
  line-height: 1.5;
}

.hero-card {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
}

.bag {
  flex-shrink: 0;
  width: 118rpx;
  height: 118rpx;
  border-radius: 28rpx;
  background: #eaf8ee;
}

.meta {
  flex: 1;
  min-width: 0;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
  color: #69736e;
  font-size: 23rpx;
}

.row text:last-child {
  flex: 1;
  min-width: 0;
  color: #17201b;
  font-weight: 800;
  text-align: right;
  word-break: break-all;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 18rpx;
}

.card {
  padding: 22rpx;
}

.card-title {
  display: block;
  margin-bottom: 14rpx;
  color: #17201b;
  font-size: 27rpx;
  font-weight: 900;
}

.check-row,
.cold-row {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 10rpx;
  color: #18a44a;
  background: #eaf8ee;
  font-size: 22rpx;
  font-weight: 800;
}

.check-row {
  display: flex;
  justify-content: space-between;
}

.conclusion {
  margin-top: 18rpx;
  padding: 22rpx;
  color: #27733d;
  background: #ecf8ef;
  font-size: 24rpx;
  line-height: 1.6;
}

.submit {
  margin-top: 24rpx;
}

.empty {
  padding: 120rpx 0;
  color: #7d8782;
  font-size: 26rpx;
  text-align: center;
}
