<view class="page">
  <view class="scan-card">
    <image class="scan-hero" src="{{traceabilityImage}}" mode="aspectFill" />
    <view class="scan-copy">
      <text class="scan-title">扫描血包标签二维码</text>
      <text class="scan-desc">快速查询血包检验与运输信息</text>
    </view>
    <view class="scan-btn" bindtap="onScan">扫码查询</view>
  </view>

  <view class="input-card">
    <text class="label">或输入血包编号 / 检测码</text>
    <input placeholder="请输入血包编号或检验码" value="{{code}}" bindinput="onInput" />
    <view class="query-btn {{querying ? 'disabled' : ''}}" bindtap="onQuery">{{querying ? '查询中...' : '立即查询'}}</view>
  </view>

  <view wx:if="{{history.length}}" class="history-card">
    <view class="section-head">
      <text>查询记录</text>
      <text>全部 ›</text>
    </view>
    <view wx:for="{{history}}" wx:key="code" class="history-row" data-code="{{item.code}}" bindtap="onHistoryTap">
      <view class="doc-icon">报</view>
      <view>
        <text class="history-code">血包编号：{{item.code}}</text>
        <text class="history-time">查询时间：{{item.time}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="hint">本查询仅用于大熊动医血包产品的检验信息追溯，请确保血包标签完整可识别。</view>
</view>
