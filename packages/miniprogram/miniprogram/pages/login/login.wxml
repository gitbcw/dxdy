<view class="page" catchtouchmove="noop">
  <view wx:if="{{checkingSession}}" class="session-check">
    <view class="session-logo">
      <image class="session-logo-icon" src="{{logoIcon}}" mode="aspectFit" />
    </view>
    <text class="session-text">正在进入...</text>
  </view>

  <block wx:else>
    <image class="login-bg" src="{{loginBackgroundImage}}" mode="aspectFill" />
    <view class="login-shade"></view>

    <view class="login-content">
      <view class="brand-logo-panel">
        <image class="brand-logo-image" src="{{brandLogo}}" mode="aspectFit" />
      </view>

      <view class="brand-panel">
        <image class="brand-hero-image" src="{{loginHeroImage}}" mode="aspectFill" />
      </view>

      <view class="form">
        <view class="field-row">
          <image class="field-icon" src="{{phoneIcon}}" mode="aspectFit" />
          <input class="field-input" placeholder="请输入手机号码" placeholder-class="field-placeholder" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
        </view>

        <view class="field-row">
          <image class="field-icon" src="{{shieldIcon}}" mode="aspectFit" />
          <input class="field-input" placeholder="请输入密码" placeholder-class="field-placeholder" password value="{{password}}" bindinput="onPasswordInput" />
        </view>

        <view class="form-links">
          <view class="secondary-action" bindtap="onRegisterTap">注册</view>
          <view class="secondary-action" bindtap="onForgotPasswordTap">忘记密码</view>
        </view>
      </view>

      <view class="submit-orbit" bindtap="onSubmit">
        <view class="submit-btn">登录</view>
      </view>
    </view>
  </block>
</view>
