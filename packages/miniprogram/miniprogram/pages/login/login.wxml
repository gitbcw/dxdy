<view class="page">
  <view class="brand-hero">
    <view class="brand-row">
      <view class="logo-mark">
        <image class="logo-icon" src="{{logoIcon}}" mode="aspectFit" />
      </view>
      <view>
        <text class="brand-name">大熊动医</text>
        <text class="brand-sub">DaXiong Vet</text>
      </view>
    </view>
    <view class="hero-visual">
      <image class="hero-image" src="{{loginHeroImage}}" mode="widthFix" />
    </view>
  </view>

  <view class="form dx-card">
    <text class="title">欢迎来到大熊动医</text>
    <text class="subtitle">客户采购、代理推广与制单履约统一入口</text>

    <view class="segmented">
      <view class="segment {{!isRegister ? 'active' : ''}}" bindtap="showLogin">登录</view>
      <view class="segment {{isRegister ? 'active' : ''}}" bindtap="showRegister">注册</view>
    </view>

    <view class="field-row">
      <image class="field-icon" src="{{phoneIcon}}" mode="aspectFit" />
      <input class="field-input" placeholder="请输入手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view wx:if="{{isRegister}}" class="field-row">
      <image class="field-icon" src="{{userIcon}}" mode="aspectFit" />
      <input class="field-input" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>
    <view wx:if="{{!isRegister}}" class="field-row">
      <image class="field-icon" src="{{shieldIcon}}" mode="aspectFit" />
      <input class="field-input" placeholder="请输入验证码" maxlength="6" />
      <view class="code-btn">获取验证码</view>
    </view>

    <view class="agreement">
      <view class="radio-dot"></view>
      <text>我已阅读并同意</text>
      <text class="link">《用户协议》</text>
      <text>和</text>
      <text class="link">《隐私政策》</text>
    </view>

    <view class="submit-btn dx-orange-btn" bindtap="onSubmit">{{isRegister ? '立即注册' : '立即登录'}}</view>
    <view class="switch-line">
      <text>{{isRegister ? '已有账号？' : '还没有账号？'}}</text>
      <text class="switch" bindtap="toggleMode">{{isRegister ? '立即登录' : '立即注册'}}</text>
    </view>

    <view class="divider"><text>其他登录方式</text></view>
    <image class="wechat-login" src="{{wechatIcon}}" mode="aspectFit" />

    <view class="demo-box">
      <view class="demo-head" bindtap="toggleDemoAccounts">
        <text class="demo-title">演示账号</text>
        <text class="demo-toggle">{{showDemoAccounts ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{showDemoAccounts}}" class="demo-list">
        <view wx:for="{{demoAccounts}}" wx:key="phone" class="demo-item" data-phone="{{item.phone}}" bindtap="useDemoAccount">
          <text class="demo-label">{{item.label}}</text>
          <text class="demo-phone">{{item.phone}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
