<view class="page">
  <view wx:if="{{checkingSession}}" class="session-check">
    <view class="session-logo">
      <image class="session-logo-icon" src="{{logoIcon}}" mode="aspectFit" />
    </view>
    <text class="session-text">正在进入...</text>
  </view>

  <block wx:else>
  <view class="brand-hero">
    <view class="brand-row">
      <view class="logo-mark">
        <image class="logo-icon" src="{{logoIcon}}" mode="aspectFit" />
      </view>
      <view>
        <text class="brand-name">大熊动医</text>
        <text class="brand-sub">DaXiong Vet</text>
      </view>
    </view>
    <view class="hero-visual">
      <image class="hero-image" src="{{loginHeroImage}}" mode="widthFix" />
    </view>
  </view>

  <view class="form dx-card">
    <text class="title">绑定手机号</text>
    <text class="subtitle">用于订单通知、售后联系和账号安全验证</text>

    <view class="field-row">
      <image class="field-icon" src="{{phoneIcon}}" mode="aspectFit" />
      <input class="field-input" placeholder="请输入手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="agreement">
      <view class="radio-dot"></view>
      <text>我已阅读并同意</text>
      <text class="link">《用户协议》</text>
      <text>和</text>
      <text class="link">《隐私政策》</text>
    </view>

    <view class="submit-btn dx-orange-btn" bindtap="onSubmit">完成绑定</view>

    <view wx:if="{{demoLoginEnabled}}" class="demo-box">
      <view class="demo-head" bindtap="toggleDemoAccounts">
        <text class="demo-title">演示账号</text>
        <text class="demo-toggle">{{showDemoAccounts ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{showDemoAccounts}}" class="demo-list">
        <view wx:for="{{demoAccounts}}" wx:key="phone" class="demo-item" data-phone="{{item.phone}}" bindtap="useDemoAccount">
          <text class="demo-label">{{item.label}}</text>
          <text class="demo-phone">{{item.phone}}</text>
        </view>
      </view>
    </view>
  </view>
  </block>
</view>
