.page {
  min-height: 100vh;
  padding: 64rpx 40rpx 48rpx;
  background: linear-gradient(180deg, #f7fbf8 0%, #f6f7f6 100%);
  box-sizing: border-box;
}

.session-check {
  min-height: calc(100vh - 112rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.session-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #e7f7ec;
}

.session-logo-icon {
  width: 52rpx;
  height: 52rpx;
}

.session-text {
  color: #6b7771;
  font-size: 24rpx;
  font-weight: 700;
}

.brand-hero {
  position: relative;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.logo-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border: 1rpx solid rgba(22, 163, 74, 0.22);
  border-radius: 18rpx;
  background: #e7f7ec;
}

.logo-icon {
  width: 42rpx;
  height: 42rpx;
}

.brand-name {
  display: block;
  color: #163322;
  font-size: 34rpx;
  font-weight: 900;
}

.brand-sub {
  display: block;
  margin-top: 4rpx;
  color: #18a34a;
  font-size: 18rpx;
  font-weight: 700;
}

.hero-visual {
  position: relative;
  margin-top: 28rpx;
  height: 286rpx;
  border-radius: 28rpx;
  background: #edf7f0;
  box-shadow: 0 14rpx 34rpx rgba(23, 48, 32, 0.10);
  overflow: hidden;
}

.hero-image {
  width: 100%;
}

.form {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 28rpx;
}

.title {
  display: block;
  color: #16251e;
  font-size: 31rpx;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  color: #6b7771;
  font-size: 22rpx;
}

.segmented {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0;
  margin-top: 38rpx;
  padding: 6rpx;
  border: 1rpx solid #e8eee9;
  border-radius: 16rpx;
  background: #f7f8f7;
}

.segment {
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 12rpx;
  color: #69756f;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.segment.active {
  color: #139445;
  background: #dff4e6;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 92rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.field-icon {
  width: 42rpx;
  height: 42rpx;
}

.field-input {
  flex: 1;
  min-width: 0;
  color: #1d2a23;
  font-size: 26rpx;
}

.code-btn {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 8rpx;
  color: #169847;
  font-size: 22rpx;
  font-weight: 700;
  background: #ecf8ef;
}

.agreement {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 28rpx;
  color: #8a958f;
  font-size: 22rpx;
}

.radio-dot {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid #d5ded8;
  border-radius: 50%;
}

.link {
  color: #149447;
  font-weight: 700;
}

.submit-btn {
  margin-top: 30rpx;
}

.switch-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 26rpx;
  color: #8a958f;
  font-size: 24rpx;
}

.switch {
  color: #139445;
  font-weight: 800;
}

.divider {
  position: relative;
  margin: 42rpx 0 24rpx;
  text-align: center;
}

.divider::before {
  content: '';
  position: absolute;
  top: 50%;
  right: 0;
  left: 0;
  height: 1rpx;
  background: #edf1ee;
}

.divider text {
  position: relative;
  z-index: 1;
  padding: 0 24rpx;
  color: #9ca6a1;
  font-size: 22rpx;
  background: #ffffff;
}

.wechat-login {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #18a34a;
}

.demo-box {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #edf1ee;
}

.demo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.demo-title {
  display: block;
  color: #16251e;
  font-size: 24rpx;
  font-weight: 800;
}

.demo-toggle {
  color: #149447;
  font-size: 22rpx;
  font-weight: 800;
}

.demo-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.demo-item {
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f8faf8;
}

.demo-label {
  display: block;
  color: #24342c;
  font-size: 22rpx;
  font-weight: 800;
}

.demo-phone {
  display: block;
  margin-top: 8rpx;
  color: #9aa39f;
  font-size: 19rpx;
}
