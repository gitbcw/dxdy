.page {
  min-height: 100vh;
  background: #ffffff;
  padding: 48rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 64rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6b7280;
}

.form {
  margin-bottom: 48rpx;
}

.input-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.label {
  width: 140rpx;
  font-size: 30rpx;
  color: #374151;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #1f2937;
  height: 48rpx;
  line-height: 48rpx;
}

.code-input {
  flex: 1;
  margin-right: 16rpx;
}

.code-btn {
  width: 200rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #0a6e7c;
  color: #fff;
  font-size: 26rpx;
  flex-shrink: 0;
}

.code-btn.disabled {
  background: #d1d5db;
}

.submit-btn {
  height: 96rpx;
  line-height: 96rpx;
  background: #0a6e7c;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.submit-btn.disabled {
  background: #9ca3af;
}

.footer {
  text-align: center;
}

.link {
  font-size: 28rpx;
  color: #0a6e7c;
}
