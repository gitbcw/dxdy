<view class="page">
  <view class="header">
    <text class="title">找回密码</text>
    <text class="subtitle">验证手机号后重置登录密码</text>
  </view>

  <view class="form">
    <view class="input-row">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="input-row">
      <text class="label">验证码</text>
      <input
        class="input code-input"
        type="number"
        maxlength="6"
        placeholder="请输入验证码"
        value="{{code}}"
        bindinput="onCodeInput"
      />
      <view
        class="code-btn {{canSendCode ? '' : 'disabled'}}"
        bindtap="onSendCode"
      >
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </view>
    </view>

    <view class="input-row">
      <text class="label">新密码</text>
      <input
        class="input"
        password
        maxlength="20"
        placeholder="请设置新密码（至少6位）"
        value="{{newPassword}}"
        bindinput="onNewPasswordInput"
      />
    </view>

    <view class="input-row">
      <text class="label">确认密码</text>
      <input
        class="input"
        password
        maxlength="20"
        placeholder="请再次输入新密码"
        value="{{confirmPassword}}"
        bindinput="onConfirmPasswordInput"
      />
    </view>
  </view>

  <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">重置密码</view>

  <view class="footer">
    <text class="link" bindtap="onBackLogin">返回登录</text>
  </view>
</view>
