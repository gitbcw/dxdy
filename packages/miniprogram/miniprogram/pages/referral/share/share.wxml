<view class="page">
  <view class="hero-card">
    <text class="hero-title">推荐好友注册</text>
    <text class="hero-desc">好友首单完成后，您可获得积分奖励</text>
  </view>

  <view class="code-card">
    <text class="code-label">您的推荐码</text>
    <text class="code-value">{{referralCode || '加载中...'}}</text>
    <view class="copy-btn" bindtap="onCopyCode">复制推荐码</view>
  </view>

  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-value">{{referredCount}}</text>
      <text class="stat-label">已推荐</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{referredCount * 500}}</text>
      <text class="stat-label">获得积分</text>
    </view>
  </view>

  <view class="share-section">
    <text class="share-hint">点击下方按钮分享给好友</text>
    <button class="share-btn" open-type="share">分享给好友</button>
  </view>
</view>
