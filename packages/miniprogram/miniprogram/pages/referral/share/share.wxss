.page {
  min-height: 100vh;
  background: #f6f7f6;
  padding: 22rpx;
  box-sizing: border-box;
}

.hero-card {
  padding: 36rpx 26rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #139445, #0f7f39);
  color: #ffffff;
}

.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.code-card {
  margin-top: 22rpx;
  padding: 32rpx 26rpx;
  border-radius: 22rpx;
  background: #ffffff;
  text-align: center;
}

.code-label {
  display: block;
  color: #89948f;
  font-size: 24rpx;
}

.code-value {
  display: block;
  margin: 18rpx 0;
  color: #139445;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
}

.copy-btn {
  display: inline-flex;
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #139445, #0f7f39);
}

.stats-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.stat-item {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.stat-value {
  display: block;
  color: #17231f;
  font-size: 40rpx;
  font-weight: 900;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
  color: #89948f;
  font-size: 22rpx;
}

.share-section {
  margin-top: 36rpx;
  text-align: center;
}

.share-hint {
  display: block;
  color: #89948f;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  background: linear-gradient(180deg, #ff8a1f, #ff5a00);
}
