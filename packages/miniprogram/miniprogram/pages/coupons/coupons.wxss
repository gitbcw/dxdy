.page { min-height: 100vh; background: #f5f5f5; }

.tabs { display: flex; background: #fff; border-bottom: 1rpx solid #eee; }
.tab {
  flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #999;
  border-bottom: 4rpx solid transparent;
}
.tab.active { color: #1890ff; border-bottom-color: #1890ff; font-weight: 600; }

.coupon-list { padding: 24rpx; }

.coupon-card {
  display: flex; background: #fff; border-radius: 16rpx; margin-bottom: 24rpx;
  overflow: hidden; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.coupon-card.used, .coupon-card.expired { opacity: 0.5; }

.coupon-left {
  width: 200rpx; display: flex; flex-direction: column; align-items: center;
  justify-content: center; background: linear-gradient(135deg, #ff6b35, #ff4757);
  padding: 32rpx 16rpx; color: #fff;
}
.coupon-card.used .coupon-left,
.coupon-card.expired .coupon-left { background: linear-gradient(135deg, #ccc, #999); }

.coupon-value { font-size: 48rpx; font-weight: 700; }
.coupon-condition { font-size: 20rpx; margin-top: 8rpx; opacity: 0.9; }

.coupon-right { flex: 1; padding: 24rpx; display: flex; flex-direction: column; justify-content: center; }
.coupon-name { font-size: 28rpx; font-weight: 600; color: #333; }
.coupon-scope { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.coupon-expire { font-size: 20rpx; color: #ccc; margin-top: 8rpx; }

.empty { text-align: center; padding: 120rpx 0; color: #999; font-size: 28rpx; }
