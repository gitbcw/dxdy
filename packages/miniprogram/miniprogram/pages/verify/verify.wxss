.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f8f7;
  box-sizing: border-box;
}

.top-tip {
  margin-bottom: 18rpx;
  padding: 16rpx 22rpx;
  border-radius: 12rpx;
  color: #159646;
  background: #eaf8ee;
  font-size: 24rpx;
  font-weight: 800;
}

.form-title {
  display: block;
  color: #17201b;
  font-size: 36rpx;
  font-weight: 900;
}

.form-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #7b8781;
  font-size: 24rpx;
}

.form-card,
.status-card {
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(28, 42, 38, 0.06);
  overflow: hidden;
}

.field-row,
.upload-row,
.status-info,
.material-row {
  padding: 24rpx;
  border-bottom: 1rpx solid #edf0ee;
}

.field-row,
.status-info,
.material-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.field-label {
  flex-shrink: 0;
  color: #17201b;
  font-size: 26rpx;
  font-weight: 800;
}

.field-input {
  flex: 1;
  min-width: 0;
  color: #17201b;
  font-size: 26rpx;
  text-align: right;
}

.upload-area {
  margin-top: 18rpx;
  height: 154rpx;
  border-radius: 12rpx;
  background: #f4f6f5;
  border: 1rpx solid #e6ebe8;
  overflow: hidden;
}

.upload-area.small {
  height: 130rpx;
}

.license-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #929b96;
}

.upload-icon {
  color: #4b5450;
  font-size: 24rpx;
  font-weight: 800;
}

.upload-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.submit-btn {
  margin-top: 28rpx;
}

.reject-notice {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #ffd1bd;
  border-radius: 12rpx;
  background: #fff6f0;
}

.reject-label {
  display: block;
  color: #ff5a1f;
  font-size: 24rpx;
  font-weight: 900;
}

.reject-reason {
  display: block;
  margin-top: 8rpx;
  color: #88533d;
  font-size: 23rpx;
}

.status-card {
  padding: 26rpx;
}

.status-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.status-icon {
  width: 78rpx;
  height: 78rpx;
  border-radius: 18rpx;
}

.pending {
  background: #fff4e8;
}

.approved {
  background: #eaf8ee;
}

.status-title {
  display: block;
  color: #17201b;
  font-size: 31rpx;
  font-weight: 900;
}

.status-desc {
  display: block;
  margin-top: 6rpx;
  color: #7b8781;
  font-size: 23rpx;
}

.material-row {
  margin-top: 22rpx;
  border-radius: 12rpx;
  background: #f9fbfa;
}

.material-row text:last-child,
.info-value {
  color: #18a44a;
  font-weight: 800;
}

.timeline {
  margin: 22rpx 0;
}

.step {
  position: relative;
  padding: 0 0 24rpx 34rpx;
  color: #8e9893;
}

.step::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #cfd7d2;
}

.step.active::before {
  background: #18a44a;
}

.step text:first-child {
  display: block;
  color: #17201b;
  font-size: 25rpx;
  font-weight: 900;
}

.step text:last-child {
  display: block;
  margin-top: 5rpx;
  font-size: 22rpx;
}

.info-label,
.material-row text:first-child {
  color: #6f7a75;
  font-size: 24rpx;
}

.back-btn {
  margin-top: 24rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  color: #18a44a;
  border: 1rpx solid #9bddb0;
  text-align: center;
  font-size: 27rpx;
  font-weight: 900;
}
