.page {
  min-height: 100vh;
  padding: 28rpx;
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  box-sizing: border-box;
}

.top-tip {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  color: #176f56;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 12rpx 30rpx rgba(32, 98, 76, 0.08);
  font-size: 24rpx;
  font-weight: 800;
}

.form-title {
  display: block;
  color: #17231f;
  font-size: 38rpx;
  font-weight: 900;
}

.form-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #7d8782;
  font-size: 24rpx;
  line-height: 1.5;
}

.form-card,
.status-card {
  margin-top: 22rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
  overflow: hidden;
}

.field-row,
.upload-row,
.status-info,
.material-row {
  padding: 24rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.field-row,
.status-info,
.material-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.field-label {
  flex-shrink: 0;
  color: #17231f;
  font-size: 26rpx;
  font-weight: 800;
}

.field-input {
  flex: 1;
  min-width: 0;
  color: #17231f;
  font-size: 26rpx;
  text-align: right;
}

.upload-area {
  margin-top: 18rpx;
  height: 164rpx;
  border: 1rpx dashed #cfe8dc;
  border-radius: 20rpx;
  background: #fbfefd;
  overflow: hidden;
}

.upload-area.small {
  height: 138rpx;
}

.license-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  height: 100%;
  color: #97a39d;
}

.upload-icon {
  color: #176f56;
  font-size: 24rpx;
  font-weight: 900;
}

.upload-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  margin-top: 30rpx;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: #176f56;
}

.reject-notice {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(216, 91, 61, 0.18);
  border-radius: 20rpx;
  background: #fff5f2;
}

.reject-label {
  display: block;
  color: #d85b3d;
  font-size: 24rpx;
  font-weight: 900;
}

.reject-reason {
  display: block;
  margin-top: 8rpx;
  color: #88533d;
  font-size: 23rpx;
}

.status-card {
  padding: 28rpx;
}

.status-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.status-icon {
  width: 78rpx;
  height: 78rpx;
  border-radius: 20rpx;
}

.pending {
  background: #fff7ed;
}

.approved {
  background: #eef8f3;
}

.status-title {
  display: block;
  color: #17231f;
  font-size: 31rpx;
  font-weight: 900;
}

.status-desc {
  display: block;
  margin-top: 6rpx;
  color: #7d8782;
  font-size: 23rpx;
  line-height: 1.5;
}

.material-row {
  margin-top: 22rpx;
  border: 0;
  border-radius: 18rpx;
  background: #fbfefd;
}

.material-row text:last-child,
.info-value {
  color: #176f56;
  font-weight: 800;
}

.timeline {
  margin: 22rpx 0;
}

.step {
  position: relative;
  padding: 0 0 24rpx 34rpx;
  color: #97a39d;
}

.step::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 4rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #cfd8d3;
}

.step.active::before {
  background: #176f56;
}

.step text:first-child {
  display: block;
  color: #17231f;
  font-size: 25rpx;
  font-weight: 900;
}

.step text:last-child {
  display: block;
  margin-top: 5rpx;
  font-size: 22rpx;
}

.info-label,
.material-row text:first-child {
  color: #6f7a75;
  font-size: 24rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  margin-top: 24rpx;
  border: 1rpx solid #cfe8dc;
  border-radius: 18rpx;
  color: #176f56;
  font-size: 27rpx;
  font-weight: 900;
  background: #ffffff;
}
