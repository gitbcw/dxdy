<view class="page">
  <view wx:if="{{currentRole !== 'salesperson'}}" class="topbar">
    <view>
      <text class="top-title">{{displayName}}</text>
    </view>
    <view class="identity-tag {{identityTagClass}}">{{identityTag}}</view>
  </view>

  <view wx:if="{{showSearchBar}}" class="search-bar">
    <image class="search-icon" src="{{searchIcon}}" mode="aspectFit" />
    <input
      class="search-input"
      placeholder="{{searchPlaceholder}}、品牌、关键词"
      value="{{searchKeyword}}"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
    <view wx:if="{{searchKeyword}}" class="search-clear" catchtap="onSearchClear">×</view>
  </view>
  <view wx:if="{{showSearchBar && searchSuggestions.length > 0}}" class="suggestion-panel">
    <view
      wx:for="{{searchSuggestions}}"
      wx:key="id"
      class="suggestion-item"
      data-id="{{item.id}}"
      bindtap="onSearchSuggestionTap"
    >
      <text class="suggestion-title">{{item.title}}</text>
      <text class="suggestion-desc">{{item.desc}}</text>
    </view>
  </view>

  <view wx:if="{{heroTitlePrimary}}" class="hero-card {{heroClass}}">
    <image class="hero-bg-image" src="{{homeBannerImage}}" mode="aspectFill" />
    <view class="hero-copy">
      <text class="hero-title">{{heroTitlePrimary}}</text>
      <text class="hero-title">{{heroTitleSecondary}}</text>
      <text class="hero-pill">{{heroPill}}</text>
    </view>
  </view>

  <view wx:if="{{banner}}" class="cert-banner {{banner.status}}" bindtap="onBannerAction">
    <image class="cert-icon" src="{{certIcon}}" mode="aspectFit" />
    <view class="cert-copy">
      <text class="cert-title">{{banner.text}}</text>
      <text wx:if="{{banner.rejectReason}}" class="cert-reason">驳回原因：{{banner.rejectReason}}</text>
    </view>
    <view wx:if="{{banner.actionText}}" class="cert-action">{{banner.actionText}}</view>
  </view>

  <view class="quick-grid">
    <view
      wx:for="{{quickActions}}"
      wx:key="title"
      class="quick-item"
      data-action="{{item.action}}"
      bindtap="onQuickActionTap"
    >
      <image class="quick-icon" src="{{item.iconSrc}}" mode="aspectFit" />
      <text class="quick-title">{{item.title}}</text>
    </view>
  </view>

  <view wx:if="{{taskCards.length > 0 && currentRole !== 'customer_personal' && currentRole !== 'customer_institution'}}" class="section">
    <view wx:if="{{currentRole !== 'salesperson'}}" class="section-head">
      <text class="section-title">待办提醒</text>
      <text class="section-more">及时处理</text>
    </view>
    <view
      wx:for="{{taskCards}}"
      wx:key="title"
      class="task-card"
      data-action="{{item.action}}"
      bindtap="onTaskTap"
    >
      <view>
        <text class="task-badge">{{item.badge}}</text>
        <text class="task-title">{{item.title}}</text>
        <text class="task-desc">{{item.desc}}</text>
      </view>
      <view class="task-action">{{item.actionText}}</view>
    </view>
  </view>

  <view wx:if="{{boardItems.length > 0}}" class="section">
    <view class="section-head">
      <text class="section-title">{{boardTitle}}</text>
      <text class="section-more" bindtap="onBoardMoreTap">{{boardMoreText}} ></text>
    </view>
    <scroll-view wx:if="{{boardLayout !== 'queue'}}" scroll-x class="product-scroll">
      <view
        wx:for="{{boardItems}}"
        wx:key="id"
        class="product-card"
        data-idx="{{index}}"
        bindtap="onBoardItemTap"
      >
        <view class="product-img">
          <image wx:if="{{item.imageUrl}}" class="product-card-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <text wx:else>{{item.badge}}</text>
        </view>
        <text class="product-name">{{item.title}}</text>
        <text class="product-spec">{{item.desc}}</text>
        <view class="product-bottom">
          <text class="product-price">{{item.meta}}</text>
          <view wx:if="{{item.type === 'product'}}" class="cart-btn" data-idx="{{index}}" catchtap="onBoardCartTap">＋</view>
          <text wx:elif="{{item.actionText}}" class="board-action">{{item.actionText}}</text>
        </view>
      </view>
    </scroll-view>
    <view wx:else class="queue-list">
      <view
        wx:for="{{boardItems}}"
        wx:key="id"
        class="queue-card"
        data-idx="{{index}}"
        bindtap="onBoardItemTap"
      >
        <view>
          <text class="task-badge">{{item.badge}}</text>
          <text class="queue-title">{{item.title}}</text>
          <text class="queue-desc">{{item.desc}}</text>
          <text class="queue-meta">{{item.meta}}</text>
        </view>
        <text class="queue-action">{{item.actionText}}</text>
      </view>
    </view>
  </view>

  <product-action-sheet
    wx:if="{{actionSheetVisible}}"
    visible="{{actionSheetVisible}}"
    product="{{actionSheetProduct}}"
    isInstitution="{{isInstitution}}"
    bind:close="onActionSheetClose"
    bind:addcart="onActionSheetAddCart"
    bind:buynow="onActionSheetBuyNow"
  />
  <floating-actions id="floatingActions" showCart="{{currentRole !== 'salesperson' && currentRole !== 'clerk'}}" showService="{{true}}" />
</view>
