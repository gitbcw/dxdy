.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 248rpx;
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 8rpx 4rpx 0;
}

.topbar-name {
  flex: 1;
  min-width: 0;
}

.top-title {
  display: block;
  color: #17231f;
  font-size: 36rpx;
  font-weight: 900;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  width: 368rpx;
  max-width: 54vw;
  height: 76rpx;
  margin-left: auto;
  padding: 0 22rpx;
  border: 1rpx solid #e7ece9;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 12rpx 30rpx rgba(32, 98, 76, 0.08);
  box-sizing: border-box;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #17231f;
  font-size: 25rpx;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #7d8782;
  font-size: 28rpx;
  background: #f3f5f4;
}

.suggestion-panel {
  margin-top: 10rpx;
  border: 1rpx solid #e7ece9;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(32, 98, 76, 0.1);
  overflow: hidden;
}

.suggestion-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.suggestion-item:last-child {
  border-bottom: 0;
}

.suggestion-title {
  flex: 1;
  min-width: 0;
  color: #17231f;
  font-size: 24rpx;
  font-weight: 800;
}

.suggestion-desc {
  max-width: 220rpx;
  color: #7d8782;
  font-size: 21rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-card {
  position: relative;
  min-height: 248rpx;
  margin-top: 24rpx;
  padding: 34rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 44rpx rgba(32, 98, 76, 0.12);
}

.hero-bg-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(245, 253, 249, 0.98), rgba(245, 253, 249, 0.78), rgba(245, 253, 249, 0.14));
}

.hero-copy {
  position: relative;
  z-index: 1;
}

.hero-title {
  display: block;
  color: #17352b;
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 900;
}

.hero-pill {
  display: inline-flex;
  margin-top: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #176f56;
  font-size: 22rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.78);
}

.cert-banner {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(240, 223, 195, 0.9);
  border-radius: 24rpx;
  background: rgba(255, 250, 242, 0.92);
  box-shadow: 0 12rpx 30rpx rgba(72, 61, 37, 0.06);
}

.cert-banner.rejected {
  border-color: #f2c8be;
  background: #fff5f2;
}

.cert-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.cert-copy {
  flex: 1;
  min-width: 0;
}

.cert-title {
  display: block;
  color: #324039;
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 800;
}

.cert-reason {
  display: block;
  margin-top: 6rpx;
  color: #d85b3d;
  font-size: 21rpx;
}

.cert-action {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #176f56;
  font-size: 22rpx;
  font-weight: 800;
  background: #ffffff;
}

.scan-invite-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(23, 111, 86, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.1);
}

.scan-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #e9f8f1 0%, #dff6eb 100%);
}

.scan-icon {
  color: #176f56;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 900;
}

.scan-copy {
  flex: 1;
  min-width: 0;
}

.scan-title {
  display: block;
  color: #17231f;
  font-size: 27rpx;
  line-height: 1.3;
  font-weight: 900;
}

.scan-desc {
  display: block;
  margin-top: 6rpx;
  color: #7d8782;
  font-size: 21rpx;
  line-height: 1.35;
}

.scan-action {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 800;
  background: #176f56;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 12rpx;
  margin-top: 26rpx;
  padding: 26rpx 16rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.1);
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.quick-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #eef8f3;
}

.quick-copy {
  min-width: 0;
  text-align: center;
}

.quick-title {
  color: #26332d;
  font-size: 22rpx;
  font-weight: 800;
}

.quick-desc {
  display: block;
  margin-top: 4rpx;
  color: #83918b;
  font-size: 19rpx;
  line-height: 1.25;
}

.quick-grid.role-salesperson {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(23, 111, 86, 0.08);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 46rpx rgba(32, 98, 76, 0.1);
}

.quick-grid.role-salesperson .quick-item {
  position: relative;
  flex-direction: row;
  justify-content: flex-start;
  min-height: 116rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid #edf3ef;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fbfefd 0%, #f6fbf8 100%);
  box-sizing: border-box;
  box-shadow: 0 8rpx 22rpx rgba(32, 98, 76, 0.05);
}

.quick-grid.role-salesperson .quick-item::after {
  content: '';
  position: absolute;
  top: 22rpx;
  right: 18rpx;
  width: 10rpx;
  height: 10rpx;
  border-top: 3rpx solid #b7c7bf;
  border-right: 3rpx solid #b7c7bf;
  transform: rotate(45deg);
}

.quick-grid.role-salesperson .quick-icon {
  flex-shrink: 0;
  width: 70rpx;
  height: 70rpx;
  border-radius: 24rpx;
  background: #e9f8f1;
  box-shadow: inset 0 0 0 1rpx rgba(23, 111, 86, 0.08);
}

.quick-grid.role-salesperson .quick-copy {
  flex: 1;
  padding-right: 18rpx;
  text-align: left;
}

.quick-grid.role-salesperson .quick-title {
  display: block;
  color: #17231f;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 900;
}

.quick-grid.role-salesperson .quick-desc {
  margin-top: 8rpx;
  color: #7a8a82;
  font-size: 20rpx;
}

.section {
  margin-top: 30rpx;
  padding: 26rpx 22rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: #17231f;
  font-size: 31rpx;
  font-weight: 900;
}

.section-more {
  color: #7d8782;
  font-size: 22rpx;
}

.task-card,
.queue-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 22rpx;
  background: #fbfefd;
}

.task-card:last-child {
  margin-bottom: 0;
}

.task-badge {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #176f56;
  font-size: 20rpx;
  font-weight: 800;
  background: #eef8f3;
}

.task-title,
.queue-title {
  display: block;
  margin-top: 10rpx;
  color: #17231f;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 900;
}

.task-desc,
.queue-desc,
.queue-meta {
  display: block;
  margin-top: 6rpx;
  color: #7d8782;
  font-size: 21rpx;
}

.task-action,
.queue-action {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  background: #176f56;
}

.product-scroll {
  white-space: nowrap;
}

.product-card {
  display: inline-flex;
  flex-direction: column;
  width: 212rpx;
  min-height: 318rpx;
  margin-right: 16rpx;
  padding: 0 0 14rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 22rpx;
  background: #fbfefd;
  vertical-align: top;
  white-space: normal;
  box-sizing: border-box;
  overflow: hidden;
}

.product-img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 212rpx;
  border-radius: 0;
  color: #176f56;
  font-size: 22rpx;
  font-weight: 800;
  background: #eef8f3;
  overflow: hidden;
}

.product-card-image {
  width: 100%;
  height: 100%;
}

.product-name {
  display: block;
  width: calc(100% - 28rpx);
  max-width: calc(100% - 28rpx);
  min-width: 0;
  margin: 12rpx 14rpx 0;
  color: #17231f;
  font-size: 23rpx;
  line-height: 32rpx;
  height: 32rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-spec {
  display: block;
  margin: 8rpx 14rpx 0;
  color: #7d8782;
  font-size: 20rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: auto;
  padding: 8rpx 14rpx 0;
}

.product-price {
  flex: 1;
  min-width: 0;
  color: #d85b3d;
  font-size: 20rpx;
  font-weight: 900;
}

.cart-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #176f56;
  font-size: 24rpx;
  line-height: 42rpx;
  font-weight: 900;
  text-align: center;
  background: #dff6eb;
}

.board-action {
  color: #176f56;
  font-size: 22rpx;
  font-weight: 800;
}

.queue-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.article-section {
  margin-top: 30rpx;
}

.article-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.article-card {
  min-width: 0;
  border: 1rpx solid #edf1ee;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(32, 98, 76, 0.08);
  overflow: hidden;
}

.article-cover-wrap {
  position: relative;
  width: 100%;
  height: 220rpx;
  background: #eef8f3;
  overflow: hidden;
}

.article-cover {
  width: 100%;
  height: 100%;
}

.article-tag {
  position: absolute;
  top: 0;
  left: 0;
  min-width: 96rpx;
  max-width: 180rpx;
  padding: 8rpx 18rpx;
  border-bottom-right-radius: 18rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 900;
  text-align: center;
  background: #f3b056;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.article-copy {
  min-height: 128rpx;
  padding: 16rpx 18rpx 18rpx;
}

.article-title {
  display: -webkit-box;
  color: #17231f;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.article-subtitle {
  display: -webkit-box;
  margin-top: 8rpx;
  color: #7d8782;
  font-size: 21rpx;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.article-fade-in {
  opacity: 0;
  transform: translateY(30rpx);
  animation: articleFadeIn 0.6s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}

@keyframes articleFadeIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.article-load-sentinel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 0 16rpx;
}

.article-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.article-loading-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #0a6e7c;
  opacity: 0.4;
  animation: articleLoadingDot 1.2s ease-in-out infinite;
}

.article-loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.article-loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes articleLoadingDot {
  0%, 100% {
    opacity: 0.4;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.2);
  }
}

.article-loading-text {
  color: #7d8782;
  font-size: 22rpx;
}

.home-footer {
  padding: 34rpx 0 18rpx;
  text-align: center;
  color: #97a39d;
}

.footer-company {
  display: block;
  font-size: 21rpx;
  line-height: 1.5;
  font-weight: 700;
}

.footer-icp {
  display: block;
  margin-top: 8rpx;
  font-size: 19rpx;
  line-height: 1.4;
}
