.page {
  min-height: 100vh;
  padding: 22rpx 22rpx 54rpx;
  background: #f6f7f6;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.top-title {
  display: block;
  color: #17231f;
  font-size: 34rpx;
  font-weight: 900;
}

.top-sub {
  display: block;
  margin-top: 6rpx;
  color: #7f8a84;
  font-size: 22rpx;
}

.identity-tag {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.identity-tag.verified,
.identity-tag.staff {
  color: #139445;
  background: #e6f7ec;
}

.identity-tag.default {
  color: #69756f;
  background: #edf1ee;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 66rpx;
  margin-top: 20rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e6ebe7;
  border-radius: 999rpx;
  background: #ffffff;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #1d2a23;
  font-size: 24rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 50%;
  color: #8a958f;
  font-size: 30rpx;
  text-align: center;
  background: #f0f3f1;
}

.hero-card {
  position: relative;
  min-height: 214rpx;
  margin-top: 18rpx;
  padding: 34rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #dff4e5 0%, #f3fbf5 100%);
}

.hero-bg-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(229, 249, 235, 0.96) 0%, rgba(229, 249, 235, 0.72) 42%, rgba(229, 249, 235, 0.08) 100%);
}

.hero-copy {
  position: relative;
  z-index: 1;
}

.hero-title {
  display: block;
  color: #075c2b;
  font-size: 38rpx;
  line-height: 1.28;
  font-weight: 900;
}

.hero-pill {
  display: inline-flex;
  margin-top: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  background: #18a34a;
}

.hero-pets {
  position: absolute;
  right: 30rpx;
  bottom: 24rpx;
  width: 220rpx;
  height: 150rpx;
}

.pet-circle {
  position: absolute;
  border-radius: 50%;
  box-shadow: 0 14rpx 30rpx rgba(23, 48, 32, 0.10);
}

.pet-circle.dog {
  right: 76rpx;
  bottom: 22rpx;
  width: 118rpx;
  height: 118rpx;
  background: #e9b05c;
}

.pet-circle.cat {
  right: 0;
  bottom: 6rpx;
  width: 86rpx;
  height: 86rpx;
  background: #d7dbd8;
}

.cert-banner {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(22, 163, 74, 0.18);
  border-radius: 18rpx;
  background: #fffaf1;
}

.cert-banner.pending {
  background: #fff8e6;
}

.cert-banner.rejected {
  background: #fff1ed;
  border-color: rgba(255, 106, 0, 0.22);
}

.cert-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #fff7ec;
}

.cert-copy {
  flex: 1;
  min-width: 0;
}

.cert-title {
  display: block;
  color: #324039;
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 800;
}

.cert-reason {
  display: block;
  margin-top: 6rpx;
  color: #ef5b2a;
  font-size: 21rpx;
}

.cert-action {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border: 1rpx solid rgba(22, 163, 74, 0.35);
  border-radius: 999rpx;
  color: #139445;
  font-size: 22rpx;
  font-weight: 800;
  background: #ffffff;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx 12rpx;
  margin-top: 24rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.quick-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #e8f8ee;
}

.quick-title {
  color: #28362f;
  font-size: 22rpx;
  font-weight: 700;
}

.section {
  margin-top: 30rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: #17231f;
  font-size: 30rpx;
  font-weight: 900;
}

.section-more {
  color: #89948f;
  font-size: 22rpx;
}

.task-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(22, 163, 74, 0.12);
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 45, 32, 0.05);
}

.task-badge {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #139445;
  font-size: 20rpx;
  font-weight: 800;
  background: #e8f8ee;
}

.task-title {
  display: block;
  margin-top: 10rpx;
  color: #17231f;
  font-size: 26rpx;
  font-weight: 800;
}

.task-desc {
  display: block;
  margin-top: 6rpx;
  color: #7d8983;
  font-size: 21rpx;
}

.task-action {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  background: #ff6a00;
}

.product-scroll {
  white-space: nowrap;
}

.product-card {
  display: inline-flex;
  flex-direction: column;
  width: 206rpx;
  min-height: 250rpx;
  margin-right: 18rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 45, 32, 0.06);
  vertical-align: top;
  white-space: normal;
}

.product-img {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 116rpx;
  border-radius: 14rpx;
  color: #139445;
  font-size: 22rpx;
  font-weight: 800;
  background: #edf7ef;
  overflow: hidden;
}

.product-img image {
  width: 100%;
  height: 100%;
}

.product-name {
  display: block;
  margin-top: 14rpx;
  color: #17231f;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 800;
}

.product-spec {
  display: block;
  margin-top: 8rpx;
  color: #89948f;
  font-size: 20rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: auto;
  padding-top: 16rpx;
}

.product-price {
  flex: 1;
  min-width: 0;
  color: #ff5a00;
  font-size: 20rpx;
  font-weight: 900;
}

.cart-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  background: #ff7a00;
}

.board-action {
  color: #139445;
  font-size: 22rpx;
  font-weight: 800;
}
