.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 248rpx;
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  box-sizing: border-box;
}

.catalog-swiper {
  width: 100%;
  height: 246rpx;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.1);
  overflow: hidden;
}

.catalog-banner-img {
  display: block;
  width: 100%;
  height: 100%;
  background: #eef8f3;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e7ece9;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 12rpx 30rpx rgba(32, 98, 76, 0.08);
  box-sizing: border-box;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #17231f;
  font-size: 25rpx;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #7d8782;
  font-size: 28rpx;
  background: #f3f5f4;
}

.suggestion-panel {
  margin-top: 10rpx;
  border: 1rpx solid #e7ece9;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(32, 98, 76, 0.1);
  overflow: hidden;
}

.suggestion-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.suggestion-item:last-child {
  border-bottom: 0;
}

.suggestion-title {
  flex: 1;
  min-width: 0;
  color: #17231f;
  font-size: 24rpx;
  font-weight: 800;
}

.suggestion-desc {
  max-width: 220rpx;
  color: #7d8782;
  font-size: 21rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.catalog-layout {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 22rpx;
}

.category-sidebar {
  flex-shrink: 0;
  width: 150rpx;
  max-height: calc(100vh - 240rpx - env(safe-area-inset-bottom));
  padding: 14rpx 0;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 14rpx 34rpx rgba(32, 98, 76, 0.08);
  overflow: hidden;
}

.side-category {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 78rpx;
  margin: 4rpx 10rpx;
  padding: 14rpx 12rpx 14rpx 16rpx;
  border-radius: 18rpx;
  color: #5f6d66;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 30rpx;
  box-sizing: border-box;
}

.side-category text {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.side-category.active {
  color: #176f56;
  background: #eef8f3;
}

.side-category.active::before {
  content: '';
  position: absolute;
  top: 20rpx;
  bottom: 20rpx;
  left: 0;
  width: 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #176f56;
}

.catalog-content {
  flex: 1;
  min-width: 0;
  padding: 18rpx 14rpx 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.sort-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2rpx;
}

.sort-item {
  color: #68746e;
  font-size: 22rpx;
}

.sort-item.active {
  color: #17231f;
  font-weight: 900;
}

.filter-sort {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.filter-sort image {
  width: 26rpx;
  height: 26rpx;
}

.quick-filters {
  margin-top: 18rpx;
  white-space: nowrap;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  margin-right: 10rpx;
  padding: 0 18rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 999rpx;
  color: #69756f;
  font-size: 21rpx;
  font-weight: 800;
  background: #ffffff;
}

.filter-pill.active {
  color: #176f56;
  border-color: #d8ebe2;
  background: #eef8f3;
}

.product-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.product-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 0 0 14rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 22rpx;
  background: #fbfefd;
  box-sizing: border-box;
  overflow: hidden;
}

.product-card.warn {
  border-color: #f0d8bf;
}

.product-img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 214rpx;
  border-radius: 0;
  color: #176f56;
  font-size: 24rpx;
  font-weight: 900;
  background: #eef8f3;
  overflow: hidden;
}

.product-img image {
  width: 100%;
  height: 100%;
}

.product-img text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.product-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 12rpx 12rpx 0;
}

.product-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8rpx;
}

.product-name {
  flex: 1;
  min-height: 32rpx;
  height: 32rpx;
  color: #17231f;
  font-size: 23rpx;
  line-height: 32rpx;
  font-weight: 900;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lock {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
}

.product-sales {
  display: block;
  color: #7e8984;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-sales {
  flex-shrink: 0;
  font-size: 19rpx;
  line-height: 1.35;
}

.sales-tag-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  min-width: 0;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.tag {
  padding: 4rpx 8rpx;
  border-radius: 7rpx;
  color: #176f56;
  font-size: 18rpx;
  font-weight: 800;
  background: #eef8f3;
}

.tag.red {
  color: #c95c3c;
  background: #fff4ef;
}

.tag.promo {
  color: #ffffff;
  background: #d85b3d;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: auto;
  padding-top: 8rpx;
}

.price-group {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 2rpx;
}

.price {
  color: #d85b3d;
  font-size: 25rpx;
  font-weight: 900;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.original-price {
  color: #a2aaa6;
  font-size: 18rpx;
  text-decoration: line-through;
}

.cart-plus-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #dff6eb;
}

.cart-plus-icon {
  width: 28rpx;
  height: 28rpx;
}

.empty {
  grid-column: 1 / -1;
  padding: 150rpx 0;
  color: #8b9994;
  font-size: 26rpx;
  text-align: center;
}
