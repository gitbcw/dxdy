.page {
  min-height: 100vh;
  padding: 22rpx;
  background: #f6f7f6;
  box-sizing: border-box;
}

.page-title {
  color: #17231f;
  font-size: 34rpx;
  font-weight: 900;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 66rpx;
  margin-top: 20rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e6ebe7;
  border-radius: 999rpx;
  background: #ffffff;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #1d2a23;
  font-size: 24rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 50%;
  color: #8a958f;
  font-size: 30rpx;
  text-align: center;
  background: #f0f3f1;
}

.category-tabs,
.quick-filters {
  margin-top: 18rpx;
  white-space: nowrap;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  margin-right: 24rpx;
  color: #68746e;
  font-size: 24rpx;
  font-weight: 700;
}

.category-tab.active {
  color: #139445;
  border-bottom: 5rpx solid #18a34a;
}

.sort-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 0 2rpx;
}

.sort-item {
  color: #68746e;
  font-size: 23rpx;
}

.filter-sort {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.filter-sort image {
  width: 26rpx;
  height: 26rpx;
}

.sort-item.active {
  color: #17231f;
  font-weight: 800;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  margin-right: 14rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #69756f;
  font-size: 22rpx;
  font-weight: 700;
  background: #ffffff;
}

.filter-pill.active {
  color: #139445;
  background: #e6f7ec;
}

.product-list {
  margin-top: 18rpx;
}

.product-card {
  display: flex;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 45, 32, 0.05);
}

.product-card.warn {
  border: 1rpx solid rgba(255, 106, 0, 0.16);
}

.product-img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  color: #139445;
  font-size: 24rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #f0f8f2, #f8faf8);
  overflow: hidden;
}

.product-img image {
  width: 100%;
  height: 100%;
}

.product-img text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.product-name {
  flex: 1;
  color: #17231f;
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 900;
}

.lock {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
}

.product-spec {
  display: block;
  margin-top: 6rpx;
  color: #7e8984;
  font-size: 21rpx;
  line-height: 1.45;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.tag {
  padding: 5rpx 10rpx;
  border-radius: 7rpx;
  color: #139445;
  font-size: 19rpx;
  font-weight: 800;
  background: #edf8f0;
}

.tag.green {
  color: #139445;
}

.tag.red {
  color: #ff5a00;
  background: #fff2e8;
}

.tag.promo {
  color: #fff;
  background: linear-gradient(135deg, #ff5a00, #e11d48);
}

.product-bottom {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.price-group {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price {
  color: #ff5a00;
  font-size: 30rpx;
  font-weight: 900;
}

.original-price {
  color: #a2aaa6;
  font-size: 20rpx;
  text-decoration: line-through;
}

.stock {
  flex: 1;
  color: #139445;
  font-size: 20rpx;
}

.stock.warn {
  color: #ff5a00;
}

.cart-plus-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #ff7900;
}

.cart-plus-icon {
  width: 34rpx;
  height: 34rpx;
}

.empty {
  padding: 160rpx 0;
  color: #8b9994;
  font-size: 26rpx;
  text-align: center;
}
