<view class="page">
  <view class="card">
    <view class="row"><text>发票抬头</text><input value="{{title}}" data-field="title" bindinput="onInput" /></view>
    <view class="row"><text>纳税人识别号</text><input value="{{taxNo}}" data-field="taxNo" bindinput="onInput" /></view>
    <view class="row"><text>接收邮箱</text><input value="{{email}}" data-field="email" bindinput="onInput" /></view>
    <view class="row selectable" bindtap="onOpenOrderPanel">
      <text>关联订单</text>
      <view class="order-select">
        <text class="{{orderNo ? 'selected' : 'placeholder'}}">{{orderNo || '请选择已完成订单'}}</text>
        <text wx:if="{{!orderLocked}}" class="arrow">›</text>
      </view>
    </view>
    <view wx:if="{{orderNo}}" class="selected-order">
      <text class="selected-title">{{orderProductNames}}</text>
      <text class="selected-no">订单号：{{orderNo}}</text>
    </view>
    <view class="row"><text>开票金额</text><text class="amount">¥{{amount}}</text></view>
    <view class="row"><text>备注</text><input placeholder="选填，如需备注其他信息" value="{{remark}}" data-field="remark" bindinput="onInput" /></view>
    <view wx:if="{{statusText}}" class="status">{{statusText}}</view>
  </view>
  <view class="submit dx-orange-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">{{submitting ? '提交中...' : '提交申请'}}</view>

  <view wx:if="{{showOrderPanel}}" class="order-panel">
    <view class="panel-mask" bindtap="onCloseOrderPanel"></view>
    <view class="panel-card">
      <view class="panel-head">
        <text>选择已完成订单</text>
        <text class="panel-close" bindtap="onCloseOrderPanel">×</text>
      </view>
      <view wx:if="{{loadingOrders}}" class="panel-empty">正在读取订单...</view>
      <view wx:elif="{{!orderOptions.length}}" class="panel-empty">暂无可开票的已完成订单</view>
      <scroll-view wx:else scroll-y class="order-list">
        <view
          wx:for="{{orderOptions}}"
          wx:key="id"
          class="order-option {{orderId === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectOrder"
        >
          <view class="option-main">
            <text class="option-title">{{item.productNames}}</text>
            <text class="option-no">{{item.orderNo}}</text>
          </view>
          <text class="option-amount">¥{{item.amountText}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
