.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f8f7;
  box-sizing: border-box;
}

.card {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(30, 44, 40, 0.06);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
  border-bottom: 1rpx solid #edf0ee;
}

.row text:first-child {
  color: #17201b;
  font-size: 26rpx;
  font-weight: 900;
}

.row input {
  flex: 1;
  min-width: 0;
  color: #17201b;
  font-size: 25rpx;
  text-align: right;
}

.amount {
  color: #ff5a1f;
  font-size: 28rpx;
  font-weight: 900;
}

.status {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  color: #18a44a;
  background: #ecf8ef;
  font-size: 24rpx;
  font-weight: 800;
}

.submit {
  margin-top: 32rpx;
}

.submit.disabled {
  opacity: 0.55;
}
