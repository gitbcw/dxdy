.page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: 160rpx;
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  box-sizing: border-box;
}

.card {
  padding: 24rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.row text:first-child {
  color: #17231f;
  font-size: 26rpx;
  font-weight: 900;
}

.row input {
  flex: 1;
  min-width: 0;
  color: #17231f;
  font-size: 25rpx;
  text-align: right;
}

.selectable {
  cursor: pointer;
}

.order-select {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.order-select text {
  min-width: 0;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
  font-weight: 700;
}

.order-select .placeholder {
  color: #97a39d;
}

.order-select .selected {
  color: #17231f;
}

.order-select .arrow {
  flex: 0 0 auto;
  color: #97a39d;
  font-size: 34rpx;
  font-weight: 700;
}

.selected-order {
  margin: 18rpx 0 8rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #eef8f3;
}

.selected-title,
.selected-no {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-title {
  color: #17231f;
  font-size: 26rpx;
  font-weight: 900;
}

.selected-no {
  margin-top: 8rpx;
  color: #7d8782;
  font-size: 23rpx;
  font-weight: 700;
}

.amount {
  color: #d85b3d;
  font-size: 28rpx;
  font-weight: 900;
}

.status {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  color: #176f56;
  background: #eef8f3;
  font-size: 24rpx;
  font-weight: 800;
}

.submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  margin-top: 32rpx;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: #176f56;
}

.submit.disabled {
  opacity: 0.55;
}

.order-panel {
  position: fixed;
  inset: 0;
  z-index: 20;
}

.panel-mask {
  position: absolute;
  inset: 0;
  background: rgba(18, 31, 26, 0.42);
}

.panel-card {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 72vh;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  color: #17231f;
  font-size: 30rpx;
  font-weight: 900;
}

.panel-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f3f5f4;
  color: #97a39d;
  line-height: 56rpx;
  text-align: center;
}

.panel-empty {
  padding: 80rpx 0;
  color: #97a39d;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.order-list {
  max-height: 56vh;
}

.order-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1ee;
}

.order-option.active {
  background: #eef8f3;
}

.option-main {
  flex: 1;
  min-width: 0;
}

.option-title,
.option-no {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-title {
  color: #17231f;
  font-size: 27rpx;
  font-weight: 900;
}

.option-no {
  margin-top: 8rpx;
  color: #97a39d;
  font-size: 23rpx;
  font-weight: 700;
}

.option-amount {
  flex: 0 0 auto;
  color: #d85b3d;
  font-size: 27rpx;
  font-weight: 900;
}
