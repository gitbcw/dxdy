.page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom) + 112rpx);
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  box-sizing: border-box;
}

.address-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.address-card,
.form-panel {
  padding: 24rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.address-card.is-default {
  border-top: 8rpx solid #176f56;
}

.address-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
}

.default-badge,
.select-badge {
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 900;
}

.default-badge {
  color: #ffffff;
  background: #176f56;
}

.select-badge {
  color: #d85b3d;
  background: #fff7ed;
}

.address-name {
  color: #17231f;
  font-size: 30rpx;
  font-weight: 900;
}

.address-phone {
  color: #4d5652;
  font-size: 26rpx;
}

.address-detail {
  margin-top: 16rpx;
}

.line {
  display: block;
  margin-top: 8rpx;
  color: #5d6862;
  font-size: 24rpx;
  line-height: 1.45;
}

.hospital {
  color: #176f56;
  font-weight: 800;
}

.address-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 22rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1ee;
}

.action-text {
  color: #176f56;
  font-size: 24rpx;
  font-weight: 800;
}

.danger {
  color: #d85b3d;
}

.empty-state {
  margin-top: 160rpx;
  text-align: center;
}

.empty-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  color: #176f56;
  background: #eef8f3;
  font-size: 24rpx;
  font-weight: 900;
}

.empty-text,
.empty-hint {
  display: block;
}

.empty-text {
  margin-top: 24rpx;
  color: #17231f;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-hint {
  margin-top: 8rpx;
  color: #97a39d;
  font-size: 24rpx;
}

.bottom-btn {
  position: fixed;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: #176f56;
  box-shadow: 0 14rpx 34rpx rgba(32, 98, 76, 0.18);
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.field-row text {
  color: #17231f;
  font-size: 26rpx;
  font-weight: 800;
}

.field-row input {
  flex: 1;
  min-width: 0;
  color: #17231f;
  font-size: 26rpx;
  text-align: right;
}

.field-row picker {
  flex: 1;
  min-width: 0;
}

.picker-value {
  color: #17231f;
  font-size: 26rpx;
  text-align: right;
}

.picker-value.placeholder {
  color: #97a39d;
}

.switch-row {
  border-bottom: 0;
}

.form-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 28rpx;
}

.outline-btn,
.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.outline-btn {
  color: #176f56;
  border: 1rpx solid #cfe8dc;
  background: #ffffff;
}

.save-btn {
  color: #ffffff;
  background: #176f56;
}
