.page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  box-sizing: border-box;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.label-bar {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #176f56, #48a67c);
}

.label-bar.light-bar {
  background: linear-gradient(180deg, #176f56, #48a67c);
}

.label-text {
  font-size: 30rpx;
  font-weight: 900;
  color: #17231f;
}

.label-text.light-text {
  color: #17231f;
}

.label-count {
  margin-left: auto;
  color: #97a39d;
  font-size: 22rpx;
}

.faq-section {
  margin-bottom: 28rpx;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.faq-item {
  display: flex;
  border: 1rpx solid #edf1ee;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
  overflow: hidden;
}

.faq-left {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  flex-shrink: 0;
}

.faq-accent {
  position: absolute;
  inset: 0 auto 0 0;
  width: 0;
  border-radius: 0 4rpx 4rpx 0;
  background: #176f56;
  transition: width 0.25s ease;
}

.faq-item.is-open .faq-accent {
  width: 6rpx;
}

.faq-num {
  position: relative;
  z-index: 1;
  color: #b8c2bd;
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 800;
}

.faq-item.is-open .faq-num {
  color: #176f56;
}

.faq-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24rpx 24rpx 24rpx 0;
}

.faq-item.is-open .faq-body {
  justify-content: flex-start;
}

.faq-question {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.faq-q {
  flex: 1;
  color: #17231f;
  font-size: 28rpx;
  line-height: 1.55;
  font-weight: 800;
}

.faq-toggle {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.toggle-line {
  position: absolute;
  background: #cfd8d3;
  border-radius: 2rpx;
  transition: all 0.25s ease;
}

.toggle-h {
  top: 50%;
  right: 8rpx;
  left: 8rpx;
  height: 3rpx;
  margin-top: -1.5rpx;
}

.toggle-v {
  top: 8rpx;
  bottom: 8rpx;
  left: 50%;
  width: 3rpx;
  margin-left: -1.5rpx;
}

.faq-item.is-open .toggle-h {
  background: #176f56;
}

.faq-item.is-open .toggle-v {
  opacity: 0;
  transform: scaleY(0);
}

.faq-answer-wrap {
  max-height: 0;
  opacity: 0;
  margin-top: 0;
  padding: 0 20rpx;
  border-left: 4rpx solid transparent;
  border-radius: 14rpx;
  background: #f3f7f5;
  overflow: hidden;
  transform: translateY(-4rpx);
  transition: max-height 0.22s ease, opacity 0.18s ease, margin-top 0.18s ease, padding 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
}

.faq-item.is-open .faq-answer-wrap {
  max-height: 240rpx;
  opacity: 1;
  margin-top: 16rpx;
  padding: 20rpx;
  border-left-color: #176f56;
  transform: translateY(0);
}

.faq-answer {
  color: #5b6862;
  font-size: 26rpx;
  line-height: 1.75;
}

.contact-section {
  padding: 28rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.contact-cards {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.contact-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 18rpx;
  background: #fbfefd;
}

.contact-card.is-interactive {
  background: #ffffff;
}

.cc-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #eef8f3;
}

.cc-icon {
  color: #176f56;
  font-size: 22rpx;
  font-weight: 800;
}

.cc-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.cc-type {
  color: #7d8782;
  font-size: 22rpx;
  font-weight: 500;
}

.cc-value {
  color: #17231f;
  font-size: 28rpx;
  font-weight: 800;
}

.cc-arrow {
  color: #97a39d;
  font-size: 32rpx;
  font-weight: 300;
}

.contact-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.ca-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex: 1;
  padding: 22rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.ca-btn-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.ca-primary {
  color: #ffffff;
  background: #176f56;
}

.phone-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  margin: -12rpx 0 0 -8rpx;
  border: 3rpx solid #ffffff;
  border-radius: 3rpx 3rpx 3rpx 10rpx;
  transform: rotate(-45deg);
}

.phone-icon::before {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  width: 6rpx;
  height: 8rpx;
  margin-left: -3rpx;
  border-radius: 0 0 3rpx 3rpx;
  background: #ffffff;
}

.safety-note {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #f3f7f5;
}

.safety-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #176f56;
}

.safety-text {
  color: #7d8782;
  font-size: 22rpx;
  line-height: 1.5;
}

.footer-space {
  height: 30rpx;
}
