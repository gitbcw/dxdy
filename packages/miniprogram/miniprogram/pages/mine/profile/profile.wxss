.page {
  min-height: 100vh;
  padding: 34rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 48%, #ffffff 100%);
  box-sizing: border-box;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 46rpx 30rpx 40rpx;
  border: 1rpx solid #edf3ef;
  border-radius: 34rpx;
  background: linear-gradient(135deg, rgba(226, 248, 237, 0.98) 0%, rgba(255, 255, 255, 0.98) 62%, rgba(255, 245, 229, 0.98) 100%);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.avatar-large {
  width: 138rpx;
  height: 138rpx;
  line-height: 138rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 42rpx;
  background: linear-gradient(135deg, #176f56 0%, #41b47f 100%);
  color: #fff;
  font-size: 52rpx;
  font-weight: 900;
  text-align: center;
  box-shadow: 0 14rpx 30rpx rgba(23, 111, 86, 0.18);
  box-sizing: border-box;
}

.avatar-image {
  display: block;
}

.profile-name {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #10291f;
}

.field-list {
  margin: 24rpx 0 0;
  border: 1rpx solid #edf3ef;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
  overflow: hidden;
}

.field-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #edf3ef;
  box-sizing: border-box;
}

.field-item:last-child {
  border-bottom: none;
}

.field-item.readonly {
  opacity: 1;
}

.field-label {
  font-size: 28rpx;
  font-weight: 800;
  color: #10291f;
  flex-shrink: 0;
}

.field-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.avatar-small {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #176f56 0%, #41b47f 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(23, 111, 86, 0.16);
}

.avatar-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.38);
}

.avatar-picker-panel {
  width: 100%;
  padding: 30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.avatar-picker-title,
.avatar-picker-desc {
  display: block;
  text-align: center;
}

.avatar-picker-title {
  color: #10291f;
  font-size: 30rpx;
  font-weight: 900;
}

.avatar-picker-desc {
  margin-top: 10rpx;
  color: #68776f;
  font-size: 24rpx;
}

.wechat-avatar-button {
  margin-top: 24rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: #176f56;
  box-shadow: 0 12rpx 26rpx rgba(23, 111, 86, 0.16);
}

.wechat-avatar-button::after {
  border: none;
}

.avatar-picker-cancel {
  margin-top: 16rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  color: #68776f;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
  background: #f4faf7;
}

.field-value {
  font-size: 26rpx;
  color: #68776f;
  text-align: right;
}

.field-arrow {
  font-size: 32rpx;
  color: #a8b4ad;
}
