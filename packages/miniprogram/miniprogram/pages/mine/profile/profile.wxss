.page {
  min-height: 100vh;
  background: var(--bg-page);
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx 36rpx;
  background: linear-gradient(160deg, var(--color-primary), var(--color-primary-light));
}

.avatar-large {
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 52rpx;
  font-weight: 900;
  text-align: center;
}

.avatar-image {
  display: block;
}

.profile-name {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
}

.field-list {
  margin: 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.field-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.field-item:last-child {
  border-bottom: none;
}

.field-item.readonly {
  opacity: 0.7;
}

.field-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}

.field-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.avatar-small {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #063e46, #0a6e7c);
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
}

.avatar-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.38);
}

.avatar-picker-panel {
  width: 100%;
  padding: 30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.avatar-picker-title,
.avatar-picker-desc {
  display: block;
  text-align: center;
}

.avatar-picker-title {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 900;
}

.avatar-picker-desc {
  margin-top: 10rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.wechat-avatar-button {
  margin-top: 24rpx;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: linear-gradient(180deg, #18a34a 0%, #139445 100%);
}

.avatar-picker-cancel {
  margin-top: 16rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 16rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
  background: #f4f6f5;
}

.field-value {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: right;
}

.field-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
}
