<view class="page">
  <view class="hero">
    <view class="icon-wrap">
      <image class="icon" src="{{bellIcon}}" mode="aspectFit" />
    </view>
    <text class="title">关注公众号</text>
    <text class="desc">关注官方公众号，获取品牌动态与宠物医疗科普内容</text>
  </view>

  <view class="card account-card">
    <view class="account-header">
      <view class="account-avatar">熊</view>
      <view class="account-info">
        <text class="account-name">{{officialAccountName}}</text>
        <text class="account-id">{{officialAccountId}}</text>
      </view>
    </view>
    <view class="primary-btn" bindtap="onOpenOfficialAccount">去关注公众号</view>
  </view>

  <view class="card tips-card">
    <text class="tips-title">温馨提示</text>
    <view wx:for="{{tips}}" wx:key="index" class="tip-item">
      <text class="tip-dot">·</text>
      <text class="tip-text">{{item}}</text>
    </view>
  </view>

</view>
