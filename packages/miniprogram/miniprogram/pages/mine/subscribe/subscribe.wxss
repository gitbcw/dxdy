.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: #eaf5f3;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.icon {
  width: 64rpx;
  height: 64rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
  padding: 0 32rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.qr-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode {
  width: 400rpx;
  height: 400rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
}

.qrcode.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 30rpx;
  color: #9ca3af;
  text-align: center;
  line-height: 48rpx;
}

.qr-tip {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #9ca3af;
}

.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 28rpx;
  color: #6b7280;
}

.value {
  flex: 1;
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 500;
  text-align: right;
  margin-right: 24rpx;
}

.copy {
  font-size: 28rpx;
  color: #0a6e7c;
}

.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
  display: block;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.tip-dot {
  font-size: 32rpx;
  color: #0a6e7c;
  margin-right: 12rpx;
  line-height: 40rpx;
}

.tip-text {
  flex: 1;
  font-size: 28rpx;
  color: #4b5563;
  line-height: 44rpx;
}

.primary-btn {
  margin-top: 16rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: #0a6e7c;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  text-align: center;
}
