.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: #eaf5f3;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.icon {
  width: 64rpx;
  height: 64rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
  padding: 0 32rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.account-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.account-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.account-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #0a6e7c;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.account-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.account-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}

.account-id {
  font-size: 26rpx;
  color: #9ca3af;
}

.primary-btn {
  height: 96rpx;
  line-height: 96rpx;
  background: #0a6e7c;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  text-align: center;
}

.secondary-btn {
  margin-top: 16rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: #fff;
  color: #0a6e7c;
  font-size: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  border: 1rpx solid #0a6e7c;
  box-sizing: border-box;
}

.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
  display: block;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.tip-dot {
  font-size: 32rpx;
  color: #0a6e7c;
  margin-right: 12rpx;
  line-height: 40rpx;
}

.tip-text {
  flex: 1;
  font-size: 28rpx;
  color: #4b5563;
  line-height: 44rpx;
}
