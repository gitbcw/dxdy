.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 248rpx;
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  box-sizing: border-box;
}

.mine-loading {
  margin-top: 24rpx;
  padding: 34rpx 26rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.loading-avatar,
.loading-line {
  background: #f3f5f4;
}

.loading-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
}

.loading-line {
  width: 42%;
  height: 24rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
}

.loading-line.wide {
  width: 68%;
  margin-top: 24rpx;
}

.login-prompt {
  margin-top: 96rpx;
  padding: 42rpx 32rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(32, 98, 76, 0.1);
  text-align: center;
}

.brand {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  height: 124rpx;
  margin: 0 auto 28rpx;
  border-radius: 28rpx;
  color: #176f56;
  font-size: 25rpx;
  font-weight: 900;
  background: #eef8f3;
}

.login-title {
  display: block;
  color: #17231f;
  font-size: 36rpx;
  font-weight: 900;
}

.login-desc {
  display: block;
  margin-top: 12rpx;
  color: #7a8580;
  font-size: 25rpx;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  margin-top: 34rpx;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: #176f56;
}

.profile-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(32, 98, 76, 0.1);
}

.profile-card::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 0;
  background: rgba(255, 255, 255, 0.72);
}

.profile-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.profile-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  color: #176f56;
  font-size: 34rpx;
  font-weight: 900;
  background: #eef8f3;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  color: #17231f;
  font-size: 33rpx;
  font-weight: 900;
}

.type {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #176f56;
  background: #eef8f3;
  font-size: 21rpx;
  font-weight: 800;
}

.verify-state {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #176f56;
  background: #eef8f3;
  font-size: 22rpx;
  font-weight: 800;
}

.profile-stats {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf1ee;
}

.profile-stat {
  text-align: center;
}

.profile-stat + .profile-stat {
  border-left: 1rpx solid #edf1ee;
}

.profile-stat-label,
.profile-note {
  display: block;
  color: #7a8580;
  font-size: 22rpx;
}

.profile-stat-value {
  display: block;
  margin-top: 6rpx;
  color: #17231f;
  font-size: 31rpx;
  font-weight: 900;
}

.profile-note {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
}

.order-bar,
.cert-row,
.section {
  margin-top: 20rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.order-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 24rpx 10rpx;
}

.order-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.order-icon-wrap {
  position: relative;
}

.order-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #eef8f3;
}

.order-badge {
  position: absolute;
  top: -8rpx;
  right: -18rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #d85b3d;
  font-size: 19rpx;
  text-align: center;
}

.order-label {
  color: #3d4642;
  font-size: 23rpx;
}

.cert-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 26rpx;
}

.cert-icon,
.menu-icon {
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: #eef8f3;
}

.cert-copy {
  flex: 1;
  min-width: 0;
}

.cert-title,
.menu-title,
.section-title,
.focus-title {
  display: block;
  color: #17231f;
  font-size: 27rpx;
  font-weight: 900;
}

.cert-desc,
.menu-desc,
.focus-desc,
.focus-meta {
  display: block;
  margin-top: 6rpx;
  color: #7a8580;
  font-size: 22rpx;
  line-height: 1.45;
}

.cert-status,
.menu-value,
.arrow {
  color: #176f56;
  font-size: 24rpx;
  font-weight: 900;
}

.section {
  overflow: hidden;
}

.section-head {
  padding: 20rpx 24rpx 8rpx;
}

.focus-card,
.menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.focus-card:last-child,
.menu-item:last-child {
  border-bottom: 0;
}

.focus-card {
  align-items: flex-start;
  flex-direction: column;
}

.focus-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.focus-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #c95c3c;
  background: #fff4ef;
  font-size: 21rpx;
  font-weight: 900;
}

.focus-arrow {
  color: #176f56;
  font-size: 26rpx;
  font-weight: 900;
}

.menu-item > view:nth-child(2) {
  flex: 1;
  min-width: 0;
}

.bottom-actions {
  margin-top: 24rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.logout {
  color: #c95c3c;
  border: 1rpx solid #f0d8bf;
  background: rgba(255, 255, 255, 0.86);
}

.notice-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.48);
  box-sizing: border-box;
}

.notice-dialog {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  border-radius: 28rpx;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.22);
}

.notice-close {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 50rpx;
  line-height: 1;
  background: rgba(23, 111, 86, 0.18);
}

.notice-hero {
  position: relative;
  height: 300rpx;
  background: linear-gradient(135deg, #35cfc5 0%, #20bfa9 100%);
  overflow: hidden;
}

.notice-hero::after {
  content: '';
  position: absolute;
  left: -8%;
  right: -8%;
  bottom: -58rpx;
  height: 130rpx;
  border-radius: 50% 50% 0 0;
  background: #ffffff;
}

.notice-phone {
  position: absolute;
  left: 50%;
  bottom: 38rpx;
  z-index: 1;
  width: 220rpx;
  height: 210rpx;
  transform: translateX(-50%);
  border: 18rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 28rpx 28rpx 0 0;
  background: rgba(255, 255, 255, 0.18);
  box-sizing: border-box;
}

.notice-phone-dot {
  width: 60rpx;
  height: 8rpx;
  margin: 16rpx auto 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
}

.notice-card-line {
  width: 130rpx;
  height: 14rpx;
  margin: 16rpx auto 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.84);
}

.notice-card-line.wide {
  width: 170rpx;
}

.notice-card-line.short {
  width: 96rpx;
}

.notice-bubble {
  position: absolute;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}

.notice-bubble.left {
  left: 70rpx;
  top: 86rpx;
  color: #176f56;
  background: #fff28a;
}

.notice-bubble.right {
  right: 74rpx;
  top: 120rpx;
  background: #ff7070;
}

.notice-body {
  position: relative;
  z-index: 1;
  padding: 34rpx 44rpx 42rpx;
  text-align: center;
}

.notice-title,
.notice-desc,
.notice-tip {
  display: block;
}

.notice-title {
  color: #27332f;
  font-size: 38rpx;
  font-weight: 900;
}

.notice-desc {
  margin-top: 18rpx;
  color: #5d6964;
  font-size: 28rpx;
  line-height: 1.45;
}

.notice-tip {
  margin-top: 10rpx;
  color: #8a9691;
  font-size: 24rpx;
}

.notice-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  margin-top: 34rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  background: #35cfc5;
}

.notice-secondary {
  display: inline-flex;
  margin-top: 24rpx;
  padding-bottom: 4rpx;
  border-bottom: 1rpx solid #9aa39f;
  color: #808a85;
  font-size: 27rpx;
}
