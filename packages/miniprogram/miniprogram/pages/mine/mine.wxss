.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom) + 112rpx);
  background: #f7f8f7;
  box-sizing: border-box;
}

.mine-loading {
  margin-top: 24rpx;
  padding: 36rpx 28rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(30, 62, 44, 0.06);
}

.loading-avatar,
.loading-line {
  background: linear-gradient(90deg, #edf1ee 0%, #f7f8f7 50%, #edf1ee 100%);
}

.loading-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
}

.loading-line {
  width: 42%;
  height: 24rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
}

.loading-line.wide {
  width: 68%;
  margin-top: 24rpx;
}

.login-prompt {
  margin-top: 100rpx;
  padding: 40rpx 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(31, 45, 43, 0.08);
  text-align: center;
}

.brand {
  width: 132rpx;
  height: 132rpx;
  line-height: 132rpx;
  margin: 0 auto 28rpx;
  border-radius: 34rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  background: #18a44a;
}

.login-title {
  display: block;
  color: #171f1c;
  font-size: 36rpx;
  font-weight: 900;
}

.login-desc {
  display: block;
  margin-top: 12rpx;
  color: #7c8782;
  font-size: 25rpx;
}

.login-btn {
  margin-top: 36rpx;
}

.profile-card {
  padding: 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(100deg, #eefaf1, #ffffff);
  border: 1rpx solid #d7efdd;
  box-shadow: 0 10rpx 28rpx rgba(30, 62, 44, 0.06);
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  background: #1ba24a;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  color: #17201b;
  font-size: 32rpx;
  font-weight: 900;
}

.type {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #169545;
  background: #e2f6e7;
  font-size: 21rpx;
  font-weight: 800;
}

.verify-state {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #169545;
  background: #eaf8ee;
  font-size: 22rpx;
  font-weight: 800;
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e5efe8;
}

.profile-stat {
  text-align: center;
}

.profile-stat.tappable {
  cursor: pointer;
}

.profile-stat.tappable:active {
  opacity: 0.72;
}

.profile-stat + .profile-stat {
  border-left: 1rpx solid #e5efe8;
}

.profile-stat-label,
.profile-note {
  display: block;
  color: #7b8781;
  font-size: 22rpx;
}

.profile-stat-value {
  display: block;
  margin-top: 6rpx;
  color: #17201b;
  font-size: 30rpx;
  font-weight: 900;
}

.profile-note {
  margin-top: 18rpx;
}

.order-bar,
.cert-row,
.section {
  margin-top: 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(30, 44, 40, 0.06);
}

.order-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 24rpx 8rpx;
}

.order-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.order-icon-wrap {
  position: relative;
}

.order-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #eaf8ee;
}

.order-badge {
  position: absolute;
  top: -8rpx;
  right: -18rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #ff5a1f;
  font-size: 19rpx;
  text-align: center;
}

.order-label {
  color: #3d4642;
  font-size: 23rpx;
}

.cert-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
}

.cert-icon,
.menu-icon {
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  border-radius: 14rpx;
  background: #eaf8ee;
}

.cert-copy {
  flex: 1;
  min-width: 0;
}

.cert-title,
.menu-title,
.section-title,
.focus-title {
  display: block;
  color: #19221e;
  font-size: 27rpx;
  font-weight: 900;
}

.cert-desc,
.menu-desc,
.focus-desc,
.focus-meta {
  display: block;
  margin-top: 6rpx;
  color: #7d8782;
  font-size: 22rpx;
  line-height: 1.45;
}

.cert-status,
.menu-value,
.arrow {
  color: #18a44a;
  font-size: 23rpx;
  font-weight: 800;
}

.section {
  padding: 10rpx 0;
}

.section-head {
  padding: 18rpx 24rpx 8rpx;
}

.focus-card,
.menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #eef1ef;
}

.focus-card {
  align-items: flex-start;
  flex-direction: column;
}

.focus-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #ff5a1f;
  background: #fff1e8;
  font-size: 21rpx;
  font-weight: 900;
}

.menu-item > view:nth-child(2) {
  flex: 1;
  min-width: 0;
}

.bottom-actions {
  margin-top: 26rpx;
}

.action-btn {
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 800;
}

.logout {
  color: #ff5a1f;
  border: 1rpx solid #ff7a3d;
  background: #ffffff;
}
