.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 248rpx;
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  box-sizing: border-box;
}

.mine-loading {
  margin-top: 24rpx;
  padding: 34rpx 26rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.loading-avatar,
.loading-line {
  background: #f3f5f4;
}

.loading-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
}

.loading-line {
  width: 42%;
  height: 24rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
}

.loading-line.wide {
  width: 68%;
  margin-top: 24rpx;
}

.login-prompt {
  margin-top: 96rpx;
  padding: 42rpx 32rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(32, 98, 76, 0.1);
  text-align: center;
}

.brand {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  height: 124rpx;
  margin: 0 auto 28rpx;
  border-radius: 28rpx;
  color: #176f56;
  font-size: 25rpx;
  font-weight: 900;
  background: #eef8f3;
}

.login-title {
  display: block;
  color: #17231f;
  font-size: 36rpx;
  font-weight: 900;
}

.login-desc {
  display: block;
  margin-top: 12rpx;
  color: #7a8580;
  font-size: 25rpx;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  margin-top: 34rpx;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: #176f56;
}

.profile-card {
  padding: 30rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(32, 98, 76, 0.1);
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  color: #176f56;
  font-size: 34rpx;
  font-weight: 900;
  background: #eef8f3;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  color: #17231f;
  font-size: 33rpx;
  font-weight: 900;
}

.type {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #176f56;
  background: #eef8f3;
  font-size: 21rpx;
  font-weight: 800;
}

.verify-state {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #176f56;
  background: #eef8f3;
  font-size: 22rpx;
  font-weight: 800;
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf1ee;
}

.profile-stat {
  text-align: center;
}

.profile-stat + .profile-stat {
  border-left: 1rpx solid #edf1ee;
}

.profile-stat-label,
.profile-note {
  display: block;
  color: #7a8580;
  font-size: 22rpx;
}

.profile-stat-value {
  display: block;
  margin-top: 6rpx;
  color: #17231f;
  font-size: 31rpx;
  font-weight: 900;
}

.profile-note {
  margin-top: 18rpx;
}

.order-bar,
.cert-row,
.section {
  margin-top: 20rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.order-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 24rpx 10rpx;
}

.order-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.order-icon-wrap {
  position: relative;
}

.order-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #eef8f3;
}

.order-badge {
  position: absolute;
  top: -8rpx;
  right: -18rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #d85b3d;
  font-size: 19rpx;
  text-align: center;
}

.order-label {
  color: #3d4642;
  font-size: 23rpx;
}

.cert-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 26rpx;
}

.cert-icon,
.menu-icon {
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: #eef8f3;
}

.cert-copy {
  flex: 1;
  min-width: 0;
}

.cert-title,
.menu-title,
.section-title,
.focus-title {
  display: block;
  color: #17231f;
  font-size: 27rpx;
  font-weight: 900;
}

.cert-desc,
.menu-desc,
.focus-desc,
.focus-meta {
  display: block;
  margin-top: 6rpx;
  color: #7a8580;
  font-size: 22rpx;
  line-height: 1.45;
}

.cert-status,
.menu-value,
.arrow {
  color: #176f56;
  font-size: 24rpx;
  font-weight: 900;
}

.section {
  overflow: hidden;
}

.section-head {
  padding: 20rpx 24rpx 8rpx;
}

.focus-card,
.menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.focus-card:last-child,
.menu-item:last-child {
  border-bottom: 0;
}

.focus-card {
  align-items: flex-start;
  flex-direction: column;
}

.focus-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.focus-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #c95c3c;
  background: #fff4ef;
  font-size: 21rpx;
  font-weight: 900;
}

.focus-arrow {
  color: #176f56;
  font-size: 26rpx;
  font-weight: 900;
}

.menu-item > view:nth-child(2) {
  flex: 1;
  min-width: 0;
}

.bottom-actions {
  margin-top: 24rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.logout {
  color: #c95c3c;
  border: 1rpx solid #f0d8bf;
  background: rgba(255, 255, 255, 0.86);
}
