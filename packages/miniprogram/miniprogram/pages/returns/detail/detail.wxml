<view class="page">
  <view class="status-card">
    <view>
      <text class="status">{{statusText}}</text>
      <text class="desc">{{statusDesc}}</text>
    </view>
    <text class="copy" bindtap="onCopy">复制</text>
  </view>

  <view class="timeline-card">
    <view wx:for="{{steps}}" wx:key="title" class="step {{item.active ? 'active' : ''}}">
      <text class="step-title">{{item.title}}</text>
      <text class="step-time">{{item.time}}</text>
    </view>
  </view>

  <view class="note-card">
    <text class="note-title">商家留言</text>
    <text class="note-desc">{{note}}</text>
    <text wx:if="{{!isExchangeReturn}}" class="note-desc">预计退款金额：¥{{refundAmount}}</text>
    <text wx:else class="note-desc">换货商品将通过新的换货发货订单配送。</text>
    <text wx:if="{{record.exchangeOrderId}}" class="note-desc">换货订单：{{record.exchangeOrderId}}</text>
    <view wx:if="{{record.exchangeOrderId}}" class="logistics-submit exchange-logistics-btn" bindtap="onViewExchangeLogistics">查看换货物流</view>
  </view>

  <!-- 寄回物流填写 -->
  <view wx:if="{{showLogisticsForm}}" class="note-card">
    <text class="note-title">填写寄回物流</text>
    <text class="note-desc">请将商品寄回并填写物流信息</text>
    <view class="logistics-form">
      <input class="logistics-input" placeholder="快递公司（如 顺丰速运）" value="{{sendCompany}}" bindinput="onSendCompanyInput" />
      <input class="logistics-input" placeholder="快递单号" value="{{sendTrackingNo}}" bindinput="onSendTrackingNoInput" />
      <view class="logistics-submit dx-orange-btn" bindtap="onSubmitLogistics">提交物流信息</view>
    </view>
  </view>

  <!-- 已提交的寄回物流展示 -->
  <view wx:if="{{record.sendLogistics && record.sendLogistics.trackingNo}}" class="note-card">
    <text class="note-title">寄回物流</text>
    <text class="note-desc">{{record.sendLogistics.company}} {{record.sendLogistics.trackingNo}}</text>
  </view>
</view>
