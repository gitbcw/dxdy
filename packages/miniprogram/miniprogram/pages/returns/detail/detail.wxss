.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 48rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.status-card,
.timeline-card,
.note-card {
  width: 100%;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(22, 163, 74, 0.08);
  box-shadow: 0 10rpx 30rpx rgba(18, 35, 28, 0.06);
  box-sizing: border-box;
}

.status-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  background: linear-gradient(180deg, #f1fbf4 0%, #ffffff 100%);
}

.status,
.note-title {
  display: block;
  color: #18a44a;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
}

.desc,
.note-desc,
.step-time {
  display: block;
  margin-top: 10rpx;
  color: #7d8782;
  font-size: 25rpx;
  line-height: 1.55;
}

.copy {
  flex-shrink: 0;
  color: #18a44a;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 44rpx;
  padding: 0 8rpx;
}

.timeline-card,
.note-card {
  margin-top: 20rpx;
}

.timeline-card {
  padding: 30rpx 28rpx 8rpx;
}

.step {
  position: relative;
  min-height: 86rpx;
  padding: 0 0 28rpx 54rpx;
  box-sizing: border-box;
}

.step::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 10rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #cfd7d2;
  z-index: 1;
}

.step::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 32rpx;
  bottom: 6rpx;
  width: 2rpx;
  background: #e7ece8;
}

.step:last-child {
  min-height: auto;
  padding-bottom: 10rpx;
}

.step:last-child::after {
  display: none;
}

.step.active::before {
  background: #18a44a;
}

.step-title {
  display: block;
  color: #17201b;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.logistics-form {
  margin-top: 22rpx;
}

.logistics-input {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: #f8faf8;
  border-radius: 16rpx;
  border: 1rpx solid #dfe8e2;
  font-size: 26rpx;
  color: #17201b;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.logistics-submit {
  width: 100%;
  min-height: 92rpx;
  margin-top: 22rpx;
  font-size: 30rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.exchange-logistics-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}
