.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 156rpx;
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 40%, #ffffff 100%);
  box-sizing: border-box;
}

.card-hero {
  position: relative;
  padding: 28rpx;
  border: 1rpx solid #dceee7;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 44rpx rgba(32, 98, 76, 0.12);
  overflow: hidden;
}

.card-hero::before {
  content: '';
  position: absolute;
  inset: 0 0 auto 0;
  height: 8rpx;
  background: #176f56;
}

.card-hero.status-expired::before,
.card-hero.status-voided::before,
.card-hero.status-verified::before,
.card-hero.status-redeemed::before {
  background: #b8c2bd;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.card-status {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #176f56;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 900;
  background: #eef8f3;
}

.card-no {
  flex: 1;
  min-width: 0;
  color: #97a39d;
  font-size: 20rpx;
  line-height: 30rpx;
  font-weight: 700;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-product {
  display: block;
  margin-top: 22rpx;
  color: #17231f;
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 900;
}

.amount-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fbfefd;
}

.amount-label {
  display: block;
  color: #5b6862;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.amount-desc {
  display: block;
  margin-top: 4rpx;
  color: #97a39d;
  font-size: 20rpx;
  line-height: 28rpx;
  font-weight: 700;
}

.amount-value {
  flex-shrink: 0;
  color: #d85b3d;
  font-size: 42rpx;
  line-height: 50rpx;
  font-weight: 900;
}

.section {
  margin-top: 24rpx;
  padding: 26rpx 22rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: #17231f;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.section-subtitle {
  color: #97a39d;
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 700;
}

.history-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf1ee;
}

.history-item:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.history-dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #176f56;
  box-shadow: 0 0 0 8rpx #eef8f3;
}

.history-content {
  flex: 1;
  min-width: 0;
}

.history-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.history-action {
  flex-shrink: 0;
  color: #176f56;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.history-names {
  min-width: 0;
  color: #17231f;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-time {
  display: block;
  margin-top: 4rpx;
  color: #97a39d;
  font-size: 21rpx;
  line-height: 30rpx;
  font-weight: 700;
}

.actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #edf1ee;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -14rpx 34rpx rgba(32, 98, 76, 0.08);
  box-sizing: border-box;
}

.btn-primary,
.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 82rpx;
  margin: 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: normal;
  font-weight: 900;
  text-align: center;
}

.btn-primary {
  border: 0;
  color: #ffffff;
  background: #176f56;
}

.btn-secondary {
  border: 2rpx solid #cfe8dc;
  color: #176f56;
  background: #ffffff;
}

.panel-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(18, 31, 26, 0.42);
}

.panel {
  width: 100%;
  max-height: 80vh;
  padding: 34rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  overflow-y: auto;
}

.share-panel {
  text-align: center;
}

.panel-title {
  display: block;
  color: #17231f;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.panel-desc {
  display: block;
  margin-top: 14rpx;
  color: #5b6862;
  font-size: 24rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.qrcode-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  height: 420rpx;
  margin: 28rpx auto 24rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 26rpx;
  background: #fbfefd;
}

.share-qrcode {
  width: 360rpx;
  height: 360rpx;
}

.qrcode-loading {
  color: #97a39d;
  font-size: 25rpx;
  font-weight: 800;
}

.share-mini-btn {
  width: 100%;
}
