.page { padding: 0 24rpx env(safe-area-inset-bottom); }

.card-banner {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  color: #fff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}
.card-banner.status-expired, .card-banner.status-voided, .card-banner.status-verified { opacity: 0.6; }
.card-no { display: block; font-size: 22rpx; opacity: 0.8; font-family: monospace; }
.card-status { display: block; font-size: 28rpx; font-weight: 500; margin: 8rpx 0; }
.card-product { display: block; font-size: 34rpx; font-weight: 600; margin: 8rpx 0; }

.section { margin-top: 24rpx; background: #fff; border-radius: 12rpx; padding: 24rpx; }
.section-title { display: block; font-size: 28rpx; font-weight: 500; color: #333; margin-bottom: 16rpx; }

.history-item { padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.history-action { font-size: 24rpx; color: #1890ff; margin-right: 12rpx; }
.history-names { font-size: 26rpx; color: #333; }
.history-time { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }

.info-row { display: block; font-size: 26rpx; color: #666; line-height: 1.8; }

.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  gap: 16rpx;
}
.btn-primary {
  flex: 1;
  height: 80rpx;
  line-height: normal;
  background: #1890ff;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.btn-secondary {
  flex: 1;
  height: 80rpx;
  line-height: normal;
  background: #fff;
  color: #1890ff;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: 2rpx solid #1890ff;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

/* 面板 */
.panel-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.panel {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
}
.panel-title { display: block; font-size: 32rpx; font-weight: 500; margin-bottom: 24rpx; }
.panel-desc {
  display: block;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.share-panel {
  text-align: center;
}
.qrcode-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  height: 420rpx;
  margin: 0 auto 24rpx;
  border-radius: 18rpx;
  background: #f7f8fa;
  border: 1rpx solid #eef0f3;
}
.share-qrcode {
  width: 360rpx;
  height: 360rpx;
}
.qrcode-loading {
  color: #98a2b3;
  font-size: 26rpx;
}
.share-link-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  margin-bottom: 18rpx;
}
.share-link {
  flex: 1;
  min-width: 0;
  color: #475467;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}
.copy-link-btn {
  flex-shrink: 0;
  height: 56rpx;
  line-height: normal;
  padding: 0 20rpx;
  border-radius: 10rpx;
  border: 1rpx solid #1890ff;
  color: #1890ff;
  background: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-mini-btn {
  width: 100%;
}
.panel-search {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.panel-list { max-height: 50vh; overflow-y: auto; }
.panel-item {
  padding: 20rpx;
  margin-bottom: 8rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.panel-item.selected { background: #e6f7ff; border: 2rpx solid #1890ff; }
.panel-item .phone { font-size: 24rpx; color: #999; }
.product-name { font-size: 28rpx; color: #333; }
.product-price { font-size: 28rpx; color: #f5222d; font-weight: 500; }
