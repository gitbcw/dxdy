<view class="page" wx:if="{{card}}">
  <view class="card-hero status-{{card.status}}">
    <view class="hero-top">
      <text class="card-status">{{statusText}}</text>
      <text class="card-no">{{card.cardNo}}</text>
    </view>
    <text class="card-product">{{card.productName}}</text>
    <view class="amount-panel">
      <view>
        <text class="amount-label">抵扣金额</text>
        <text class="amount-desc">结算时可用于抵扣</text>
      </view>
      <text class="amount-value">¥{{amountText}}</text>
    </view>
  </view>

  <view wx:if="{{card.giftHistory.length > 0}}" class="section">
    <view class="section-head">
      <text class="section-title">流转记录</text>
      <text class="section-subtitle">{{card.giftHistory.length}} 条</text>
    </view>
    <view wx:for="{{card.giftHistory}}" wx:key="at" class="history-item">
      <view class="history-dot"></view>
      <view class="history-content">
        <view class="history-main">
          <text class="history-action">{{item.action === 'gift' || item.action === 'admin_gift' ? '赠送' : item.action === 'share_claim' ? '扫码认领' : '转赠'}}</text>
          <text class="history-names">{{item.fromUserName}} → {{item.toUserName}}</text>
        </view>
        <text class="history-time">{{item.at}}</text>
      </view>
    </view>
  </view>

  <view class="actions">
    <button wx:if="{{canClaim}}" class="btn-primary" bindtap="onClaimTap" loading="{{loading}}">认领卡券</button>
    <button wx:if="{{canRegift}}" class="btn-secondary" bindtap="onShowRegiftPanel" loading="{{loading}}">转赠他人</button>
  </view>

  <view wx:if="{{showRegiftPanel}}" class="panel-overlay" bindtap="onCloseRegiftPanel">
    <view class="panel share-panel" catchtap="">
      <text class="panel-title">转赠卡券</text>
      <text class="panel-desc">将二维码发给对方。对方扫码进入小程序后，未注册会先引导注册，已注册用户可直接认领。</text>
      <view class="qrcode-box">
        <image wx:if="{{shareQrcodeUrl}}" class="share-qrcode" src="{{shareQrcodeUrl}}" mode="aspectFit" />
        <view wx:else class="qrcode-loading">二维码生成中</view>
      </view>
      <button class="btn-primary share-mini-btn" open-type="share">分享给微信好友</button>
    </view>
  </view>
</view>
