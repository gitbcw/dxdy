.page {
  min-height: 100vh;
  padding-bottom: 136rpx;
  background: #f6f7f6;
  box-sizing: border-box;
}

.product-image {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 520rpx;
  margin: 0 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #f3f4f3 0%, #e8ebe8 100%);
  overflow: hidden;
}

.blood-pack {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 250rpx;
  height: 250rpx;
  border-radius: 38rpx;
  color: #139445;
  font-size: 42rpx;
  font-weight: 900;
  background: #ffffff;
  box-shadow: 0 22rpx 54rpx rgba(24, 45, 32, 0.10);
}

.blood-pack.blood {
  color: #b91c1c;
  background: linear-gradient(180deg, #fff 0%, #fff5f3 100%);
}

.product-main-image {
  width: 78%;
  height: 78%;
}

.image-count {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 20rpx;
  background: rgba(0, 0, 0, 0.34);
}

.content-card {
  margin: 18rpx 22rpx 0;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #ffffff;
}

.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.product-name {
  display: block;
  color: #17231f;
  font-size: 32rpx;
  line-height: 1.42;
  font-weight: 900;
}

.audience-tag {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #139445;
  font-size: 20rpx;
  font-weight: 800;
  background: #e9f8ee;
}

.price {
  flex-shrink: 0;
  color: #ff5a00;
  font-size: 36rpx;
  font-weight: 900;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.meta-item {
  padding: 16rpx 12rpx;
  border-radius: 14rpx;
  background: #f7faf8;
}

.meta-label {
  display: block;
  color: #89948f;
  font-size: 20rpx;
}

.meta-value {
  display: block;
  margin-top: 8rpx;
  color: #17231f;
  font-size: 22rpx;
  font-weight: 800;
}

.service-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.service-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #139445;
  font-size: 20rpx;
  font-weight: 800;
  background: #e8f8ee;
}

.permission-card {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #eaf8ef;
}

.permission-title {
  display: block;
  color: #0f7f39;
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 900;
}

.permission-desc {
  display: block;
  margin-top: 8rpx;
  color: #54815f;
  font-size: 21rpx;
  line-height: 1.5;
}

.test-link {
  margin-top: 14rpx;
  color: #ea580c;
  font-size: 23rpx;
  font-weight: 700;
}

.detail-section {
  margin: 16rpx 22rpx 0;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #17231f;
  font-size: 26rpx;
  font-weight: 800;
}

.detail-row text:last-child {
  color: #a2aaa6;
}

.detail-text {
  display: block;
  margin-top: 12rpx;
  color: #717c77;
  font-size: 23rpx;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: 136rpx 1fr 1fr;
  gap: 16rpx;
  padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(24, 45, 32, 0.08);
}

.service-btn,
.btn-cart,
.btn-buy {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.service-btn {
  color: #5f6b66;
  background: #f5f6f5;
}

.btn-cart {
  color: #ff5a00;
  border: 1rpx solid rgba(255, 106, 0, 0.35);
  background: #ffffff;
}

.btn-buy {
  color: #ffffff;
  background: linear-gradient(180deg, #ff8a1f 0%, #ff5a00 100%);
}
