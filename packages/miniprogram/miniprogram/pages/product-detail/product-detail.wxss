.page {
  min-height: 100vh;
  padding-bottom: 240rpx;
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 42%, #ffffff 100%);
  box-sizing: border-box;
}

.product-image {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 520rpx;
  margin: 0 22rpx;
  border: 1rpx solid #dceee7;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(32, 98, 76, 0.12);
  overflow: hidden;
}

.product-image::before {
  content: '';
  position: absolute;
  inset: 0 0 auto 0;
  height: 8rpx;
  background: transparent;
}

.blood-pack {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 250rpx;
  height: 250rpx;
  border-radius: 38rpx;
  color: #176f56;
  font-size: 42rpx;
  font-weight: 900;
  background: #eef8f3;
  box-shadow: 0 22rpx 54rpx rgba(24, 45, 32, 0.1);
}

.blood-pack.blood {
  color: #d85b3d;
  background: linear-gradient(180deg, #fff 0%, #fff5f2 100%);
}

.product-swiper,
.product-swiper-item {
  width: 100%;
  height: 100%;
}

.product-swiper-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-main-image {
  width: 100%;
  height: 100%;
}

.image-count {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 20rpx;
  background: rgba(23, 111, 86, 0.68);
}

.content-card {
  margin: 18rpx 22rpx 0;
  padding: 26rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.product-name {
  display: block;
  color: #17231f;
  font-size: 32rpx;
  line-height: 1.42;
  font-weight: 900;
}

.audience-tag {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #176f56;
  font-size: 20rpx;
  font-weight: 800;
  background: #eef8f3;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.promotion-tag {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #ff8a1f, #ff5a00);
}

.price-col {
  flex-shrink: 0;
  text-align: right;
}

.price {
  color: #ff5a00;
  font-size: 36rpx;
  font-weight: 900;
}

.original-price {
  display: block;
  color: #a2aaa6;
  font-size: 22rpx;
  text-decoration: line-through;
}

.promotion-bar {
  margin-top: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  background: #fff7ed;
}

.promotion-countdown {
  color: #d85b3d;
  font-size: 22rpx;
  font-weight: 700;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.meta-item {
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
  background: #f7faf8;
}

.meta-label {
  display: block;
  color: #89948f;
  font-size: 20rpx;
}

.meta-value {
  display: block;
  margin-top: 8rpx;
  color: #17231f;
  font-size: 22rpx;
  font-weight: 800;
}

.service-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.service-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #176f56;
  font-size: 20rpx;
  font-weight: 800;
  background: #eef8f3;
}

.permission-card {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #eef8f3;
}

.permission-title {
  display: block;
  color: #176f56;
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 900;
}

.permission-desc {
  display: block;
  margin-top: 8rpx;
  color: #5e8068;
  font-size: 21rpx;
  line-height: 1.5;
}

.test-link {
  margin-top: 14rpx;
  color: #d85b3d;
  font-size: 23rpx;
  font-weight: 700;
}

.detail-section {
  margin: 16rpx 22rpx 0;
  padding: 24rpx 26rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 30rpx rgba(32, 98, 76, 0.06);
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #17231f;
  font-size: 26rpx;
  font-weight: 800;
}

.detail-row text:last-child {
  color: #a2aaa6;
}

.detail-text {
  display: block;
  margin-top: 12rpx;
  color: #717c77;
  font-size: 23rpx;
  line-height: 1.6;
}

.review-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f0;
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.review-user {
  color: #17231f;
  font-size: 24rpx;
  font-weight: 700;
}

.review-stars {
  color: #f59e0b;
  font-size: 20rpx;
}

.review-content {
  display: block;
  margin-top: 8rpx;
  color: #5f6b66;
  font-size: 24rpx;
  line-height: 1.6;
}

.review-reply {
  margin-top: 8rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #f0f7ff;
  font-size: 22rpx;
  color: #4a6fa5;
}

.reply-label {
  font-weight: 700;
}

.review-date {
  display: block;
  margin-top: 6rpx;
  color: #a2aaa6;
  font-size: 20rpx;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: 136rpx 1fr 1fr;
  gap: 16rpx;
  padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -14rpx 34rpx rgba(32, 98, 76, 0.08);
}

.service-btn,
.btn-cart,
.btn-buy {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.service-btn {
  color: #5f6b66;
  background: #f5f6f5;
}

.btn-cart {
  color: #176f56;
  border: 1rpx solid rgba(23, 111, 86, 0.22);
  background: #ffffff;
}

.btn-buy {
  color: #ffffff;
  background: linear-gradient(180deg, #ff8a1f 0%, #ff5a00 100%);
}
