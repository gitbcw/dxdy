<view class="page">
  <view class="product-image">
    <image wx:if="{{productImageUrl}}" class="product-main-image" src="{{productImageUrl}}" mode="aspectFit" />
    <view wx:else class="blood-pack {{isBloodProduct ? 'blood' : ''}}">{{isBloodProduct ? '血包' : '商品'}}</view>
    <view class="image-count">1/4</view>
  </view>

  <view class="content-card">
    <view class="title-row">
      <view>
        <text class="product-name">{{productName}}</text>
        <view class="tag-row">
          <text class="audience-tag">{{isCardVoucher ? '代理商专属卡券' : isBloodProduct ? '仅限认证医院购买' : '医院/个人可购'}}</text>
          <text wx:if="{{isOnPromotion}}" class="promotion-tag">限时促销</text>
        </view>
      </view>
      <view class="price-col">
        <text class="price">¥{{price}}</text>
        <text wx:if="{{originalPrice}}" class="original-price">¥{{originalPrice}}</text>
      </view>
    </view>
    <view wx:if="{{isOnPromotion && promotionCountdown}}" class="promotion-bar">
      <text class="promotion-countdown">距结束 {{promotionCountdown}}</text>
    </view>

    <view class="meta-grid">
      <view class="meta-item">
        <text class="meta-label">规格</text>
        <text class="meta-value">{{spec}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">血型</text>
        <text class="meta-value">{{bloodType}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">库存</text>
        <text class="meta-value">{{stock}}</text>
      </view>
    </view>

    <view class="service-row">
      <text class="service-tag">冷链配送</text>
      <text class="service-tag">支持预约</text>
      <text class="service-tag">质量问题售后</text>
    </view>

    <view wx:if="{{isCardVoucher}}" class="permission-card">
      <text class="permission-title">本商品仅限代理商购买</text>
      <text class="permission-desc">购买完成后会自动生成卡券，可在代理商“我的卡券”中赠送给机构客户。</text>
    </view>

    <view wx:elif="{{isBloodProduct}}" class="permission-card">
      <text class="permission-title">本商品仅限通过医院认证的客户购买</text>
      <text class="permission-desc">认证通过后可查看机构价并提交预约购买需求。</text>
      <view class="test-link" bindtap="onTestQuery">血包检测信息查询 ></view>
    </view>
  </view>

  <view class="detail-section">
    <view class="detail-row">
      <text>商品说明</text>
      <text>></text>
    </view>
    <text class="detail-text">本品由大熊动医提供，适用于宠物医疗场景。具体参数以商品标签和检测报告为准。</text>
  </view>

  <view class="detail-section">
    <view class="detail-row">
      <text>配送说明</text>
      <text>></text>
    </view>
    <text class="detail-text">{{isBloodProduct ? '冷链配送，专人专送，按预约时间安排。' : '常规商品按订单顺序发货。'}}</text>
  </view>

  <view class="detail-section">
    <view class="detail-row">
      <text>售后规则</text>
      <text>></text>
    </view>
    <text class="detail-text">{{isBloodProduct ? '血包类商品仅支持质量问题售后。' : '签收后 7 天内可申请退换货。'}}</text>
  </view>

  <view wx:if="{{isBloodProduct}}" class="detail-section" bindtap="onTestQuery">
    <view class="detail-row">
      <text>血包检测信息</text>
      <text>></text>
    </view>
    <text class="detail-text">血包类商品支持按批次追溯检测信息，购买或收到批次编号后可扫码查询。</text>
  </view>

  <view wx:if="{{reviewCount > 0}}" class="detail-section">
    <view class="detail-row">
      <text>用户评价 ({{reviewCount}})</text>
      <text>{{averageRating}} 分</text>
    </view>
    <view wx:for="{{reviews}}" wx:key="id" class="review-item">
      <view class="review-header">
        <text class="review-user">{{item.userNickname}}</text>
        <text class="review-stars">{{item.ratingStars}}</text>
      </view>
      <text class="review-content">{{item.content}}</text>
      <view wx:if="{{item.adminReply}}" class="review-reply">
        <text class="reply-label">商家回复：</text>
        <text>{{item.adminReply}}</text>
      </view>
      <text class="review-date">{{item.dateText}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="service-btn" bindtap="onServiceTap">联系客服</view>
    <view wx:if="{{!isCardVoucher}}" class="btn-cart" bindtap="onAddCart">加入购物车</view>
    <view class="btn-buy" bindtap="onBuyNow">{{isBloodProduct ? '立即预约' : '立即购买'}}</view>
  </view>
  <floating-actions id="floatingActions" showCart="{{true}}" />
</view>
