<view class="page">
  <!-- 页面顶部 -->
  <view class="page-header">
    <view class="back-btn" bindtap="navigateBack">
      <text class="back-arrow">‹</text>
    </view>
    <text class="header-title">物流详情</text>
    <view class="header-placeholder"></view>
  </view>

  <!-- 物流状态卡 -->
  <view class="status-card">
    <image class="status-bg" src="{{coldChainImage}}" mode="aspectFill" />
    <view class="status-main">
      <view wx:if="{{orderType === 'exchange'}}" class="exchange-tag">
        <text>换货发货</text>
      </view>
      <text class="status-text">{{status}}</text>
      <text class="status-desc">{{company}} {{trackingNo}}</text>
    </view>
  </view>

  <!-- 收件信息 -->
  <view class="info-card">
    <view class="card-title">收件信息</view>
    <view class="info-row">
      <text class="info-label">收件人</text>
      <text class="info-value">{{recipient}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">联系电话</text>
      <text class="info-value">{{phone}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">收货地址</text>
      <text class="info-value">{{address}}</text>
    </view>
  </view>

  <!-- 物流信息 -->
  <view class="info-card">
    <view class="card-title">
      <text>物流信息</text>
      <view class="edit-btn" bindtap="onShowEdit">
        <text>修改物流</text>
      </view>
    </view>
    <view class="info-row">
      <text class="info-label">快递公司</text>
      <text class="info-value accent">{{company || '未录入'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">物流单号</text>
      <view class="express-no-wrap">
        <text class="info-value mono">{{trackingNo || '未录入'}}</text>
        <view wx:if="{{trackingNo}}" class="copy-btn" bindtap="onCopyTrackingNo">
          <text>复制</text>
        </view>
      </view>
    </view>
    <view class="info-row">
      <text class="info-label">发货时间</text>
      <text class="info-value">{{shipTime || '待发货'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{orderNo}}</text>
    </view>
    <view wx:if="{{orderType === 'exchange' && originalOrderId}}" class="info-row">
      <text class="info-label">原订单</text>
      <text class="info-value">{{originalOrderId}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">包装类型</text>
      <text class="info-value">{{packageType || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">冷链方式</text>
      <text class="info-value">{{coldChainMethod || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">包裹重量</text>
      <text class="info-value">{{packageWeight || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">箱内温度</text>
      <text class="info-value">{{boxTemperature || '-'}}</text>
    </view>
    <!-- 异常发货标记 -->
    <view wx:if="{{abnormalFlag}}" class="abnormal-badge">
      <text class="abnormal-tag">异常发货</text>
      <text class="abnormal-reason">{{abnormalReason}}</text>
    </view>
  </view>

  <!-- 物流轨迹 -->
  <view wx:if="{{tracks.length}}" class="info-card">
    <view class="card-title">物流轨迹</view>
    <view class="track-list">
      <view wx:for="{{tracks}}" wx:key="title" class="track-item {{item.active ? 'active' : ''}}">
        <view class="track-dot"></view>
        <view class="track-line" wx:if="{{index < tracks.length - 1}}"></view>
        <view class="track-content">
          <text class="track-title">{{item.title}}</text>
          <text class="track-time">{{item.time}}</text>
          <text wx:if="{{item.desc}}" class="track-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 修改物流面板 -->
  <view wx:if="{{showEditPanel}}" class="edit-panel">
    <view class="mask" bindtap="onClosePanel"></view>
    <view class="panel-content">
      <view class="panel-header">
        <text class="panel-title">修改物流信息</text>
        <view class="panel-close" bindtap="onClosePanel"><text>✕</text></view>
      </view>
      <view class="company-grid">
        <view
          wx:for="{{expressCompanies}}"
          wx:key="index"
          class="company-item {{selectedCompany === item ? 'company-selected' : ''}}"
          data-company="{{item}}"
          bindtap="onSelectCompany"
        >
          <text>{{item}}</text>
        </view>
      </view>
      <view class="express-input-wrap">
        <input
          class="express-input"
          type="text"
          placeholder="请输入快递单号"
          value="{{expressNo}}"
          bindinput="onExpressNoInput"
        />
      </view>
      <view class="panel-section-title">包装类型</view>
      <view class="company-grid compact">
        <view
          wx:for="{{packageTypes}}"
          wx:key="index"
          class="company-item {{packageType === item ? 'company-selected' : ''}}"
          data-value="{{item}}"
          bindtap="onPackageTypeTap"
        >
          <text>{{item}}</text>
        </view>
      </view>
      <view class="panel-section-title">冷链方式</view>
      <view class="company-grid compact">
        <view
          wx:for="{{coldChainMethods}}"
          wx:key="index"
          class="company-item {{coldChainMethod === item ? 'company-selected' : ''}}"
          data-value="{{item}}"
          bindtap="onColdChainTap"
        >
          <text>{{item}}</text>
        </view>
      </view>
      <view class="cold-input-grid">
        <view class="cold-input-wrap">
          <text>包裹重量</text>
          <input placeholder="如 5.80kg" value="{{packageWeight}}" data-field="packageWeight" bindinput="onColdFieldInput" />
        </view>
        <view class="cold-input-wrap">
          <text>箱内温度</text>
          <input placeholder="如 3.2" value="{{boxTemperature}}" data-field="boxTemperature" bindinput="onColdFieldInput" />
        </view>
      </view>
      <!-- 异常发货开关 -->
      <view class="abnormal-toggle-wrap">
        <view class="abnormal-toggle" bindtap="onAbnormalToggle">
          <view class="toggle-switch {{abnormalFlag ? 'toggle-on' : ''}}">
            <view class="toggle-dot"></view>
          </view>
          <text>标记为异常发货</text>
        </view>
      </view>
      <view wx:if="{{abnormalFlag}}" class="abnormal-form">
        <view class="panel-section-title">异常类型</view>
        <view class="company-grid compact">
          <view
            wx:for="{{abnormalTypes}}"
            wx:key="value"
            class="company-item {{abnormalType === item.value ? 'company-selected' : ''}}"
            data-value="{{item.value}}"
            bindtap="onAbnormalTypeTap"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
        <view class="reason-wrap">
          <text>异常原因 *</text>
          <textarea maxlength="200" placeholder="请描述异常情况" value="{{abnormalReason}}" bindinput="onAbnormalReasonInput" />
        </view>
      </view>
      <view class="reason-wrap">
        <text>修改原因 *</text>
        <textarea maxlength="100" placeholder="请输入修改原因，便于同步物流信息并记录操作日志" value="{{modifyReason}}" data-field="modifyReason" bindinput="onColdFieldInput" />
      </view>
      <view class="btn-submit-panel" bindtap="onSubmitEdit">
        <text>确认修改</text>
      </view>
    </view>
  </view>
</view>
