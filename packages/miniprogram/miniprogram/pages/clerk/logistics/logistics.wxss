/* logistics.wxss - 制单员物流详情/修改页 */

.page {
  min-height: 100vh;
  background: var(--bg-page);
}

/* ============ 页面顶部导航 ============ */
.page-header {
  background: linear-gradient(160deg, var(--color-primary) 0%, #0D8A9A 100%);
  padding: 32rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.header-placeholder {
  width: 56rpx;
}

/* ============ 物流状态卡 ============ */
.status-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx;
  padding: 28rpx;
  background: var(--color-primary-soft);
  border-radius: var(--radius-xl);
}

.truck-icon {
  width: 74rpx;
  height: 74rpx;
  border-radius: var(--radius-lg);
  background: #ffffff;
  flex-shrink: 0;
  overflow: hidden;
}

.status-main {
  flex: 1;
  min-width: 0;
}

.status-text {
  display: block;
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.status-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============ 信息卡片 ============ */
.info-card {
  margin: 0 20rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx dashed var(--divider-color);
}

.edit-btn {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  background: var(--color-accent-soft);
}

.edit-btn text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-accent);
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-row:not(:last-child) {
  border-bottom: 1rpx solid var(--divider-color);
}

.info-label {
  font-size: 26rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}

.info-value.accent {
  color: var(--color-accent);
  font-weight: 700;
}

.info-value.mono {
  font-family: monospace;
  letter-spacing: 1rpx;
}

.express-no-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  justify-content: flex-end;
  margin-left: 24rpx;
}

.copy-btn {
  padding: 6rpx 18rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-section);
  border: 1rpx solid var(--border-color);
  flex-shrink: 0;
}

.copy-btn text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ============ 物流轨迹 ============ */
.track-list {
  position: relative;
  padding-left: 0;
}

.track-item {
  position: relative;
  padding: 14rpx 0 14rpx 48rpx;
}

.track-dot {
  position: absolute;
  left: 6rpx;
  top: 22rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
  z-index: 2;
}

.track-item.active .track-dot {
  background: var(--color-primary);
}

.track-line {
  position: absolute;
  left: 13rpx;
  top: 42rpx;
  bottom: -14rpx;
  width: 2rpx;
  background: var(--divider-color);
}

.track-content {
  min-width: 0;
}

.track-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.track-item.active .track-title {
  color: var(--color-primary);
}

.track-time {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.track-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ============ 修改物流面板 ============ */
.edit-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.panel-content {
  position: relative;
  background: var(--bg-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 86vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.panel-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-tertiary);
  background: var(--bg-section);
  border-radius: var(--radius-full);
}

.company-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.company-grid.compact {
  margin-bottom: 18rpx;
}

.company-item {
  min-width: 200rpx;
  padding: 20rpx 28rpx;
  background: var(--bg-section);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.company-item text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.company-selected {
  background: rgba(10, 110, 124, 0.1);
  border-color: var(--color-primary);
}

.company-selected text {
  color: var(--color-primary);
  font-weight: 700;
}

.express-input-wrap {
  margin-bottom: 32rpx;
}

.express-input {
  width: 100%;
  background: var(--bg-section);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.express-input::placeholder {
  color: var(--text-tertiary);
}

.panel-section-title {
  margin: 22rpx 0 14rpx;
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 800;
}

.cold-input-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.cold-input-wrap,
.reason-wrap {
  padding: 18rpx;
  border-radius: var(--radius-md);
  background: var(--bg-section);
  border: 1rpx solid var(--border-color);
}

.cold-input-wrap text,
.reason-wrap text {
  display: block;
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 700;
}

.cold-input-wrap input {
  margin-top: 8rpx;
  color: var(--text-primary);
  font-size: 26rpx;
}

.reason-wrap {
  margin-bottom: 24rpx;
}

.reason-wrap textarea {
  width: 100%;
  min-height: 120rpx;
  margin-top: 10rpx;
  color: var(--text-primary);
  font-size: 26rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.btn-submit-panel {
  width: 100%;
  background: linear-gradient(135deg, var(--color-primary) 0%, #0D8A9A 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  padding: 24rpx 0;
  border-radius: var(--radius-xl);
  letter-spacing: 2rpx;
}

.btn-submit-panel:active {
  opacity: 0.85;
  transform: scale(0.99);
}
