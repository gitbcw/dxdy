<view class="page">
  <!-- 页面顶部：返回 + 标题 -->
  <view class="page-header">
    <view class="back-btn" bindtap="navigateBack">
      <text class="back-arrow">‹</text>
    </view>
    <text class="header-title">订单详情</text>
    <view class="header-placeholder"></view>
  </view>

  <!-- 订单内容 -->
  <view wx:if="{{order}}" class="order-content">

    <!-- 订单状态标签 -->
    <view class="status-bar">
      <view class="status-tag {{order.status === 'shipped' ? 'tag-shipped' : order.status === 'preparing' ? 'tag-preparing' : 'tag-pending'}}">
        <text>{{order.status === 'shipped' ? '已发货' : order.status === 'preparing' ? '备货中' : '待发货'}}</text>
      </view>
      <view class="status-tag {{order.type === 'exchange' ? 'tag-booking' : 'tag-normal'}}">
        <image wx:if="{{order.type === 'exchange'}}" src="{{iconRefresh}}" mode="aspectFit" style="width:20rpx;height:20rpx;" />
        <text>{{order.isUrgentBooking ? '加急预约' : order.type === 'exchange' ? '换货' : order.type === 'booking' ? '预约' : '普通'}}</text>
      </view>
    </view>

    <!-- 客户信息区 -->
    <view class="section-card">
      <view class="section-title">客户信息</view>
      <view class="info-row">
        <text class="info-label">姓名</text>
        <text class="info-value">{{order.customerName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">电话</text>
        <text class="info-value">{{order.customerPhone}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">地址</text>
        <text class="info-value">{{order.address}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">预计送达</text>
        <text class="info-value">{{order.eta || '按订单预约时间送达'}}</text>
      </view>
      <view wx:if="{{order.isUrgentBooking}}" class="info-row">
        <text class="info-label">配送方式</text>
        <text class="info-value">制单员线下加急送达</text>
      </view>
    </view>

    <!-- 商品列表 -->
    <view class="section-card">
      <view class="section-title">商品清单</view>
      <view wx:for="{{order.items}}" wx:for-item="prod" wx:key="productId" class="product-item">
        <view class="product-icon">
          <image src="{{prod.imageUrl || iconClock}}" mode="aspectFit" />
        </view>
        <view class="product-details">
          <text class="product-name">{{prod.productName}}</text>
          <text class="product-price">¥{{prod.price}}</text>
          <view class="cold-meta">
            <text wx:if="{{prod.batchNo}}">批号 {{prod.batchNo}}</text>
            <text wx:if="{{prod.validUntil}}">有效期 {{prod.validUntil}}</text>
            <text>{{prod.storageTemperature || order.temperature || '冷藏 2-6°C'}}</text>
          </view>
        </view>
        <view class="product-qty">
          <text>x{{prod.quantity}}</text>
        </view>
      </view>
      <view class="order-total">
        <text class="total-label">订单总价</text>
        <text class="total-value">¥{{order.totalAmount}}</text>
      </view>
    </view>

    <!-- 快递信息区（已发货时显示） -->
    <view wx:if="{{order.status === 'shipped' && order.expressCompany}}" class="section-card">
      <block wx:if="{{order.deliveryMode === 'direct'}}">
        <view class="section-title">加急配送信息</view>
        <view class="info-row">
          <text class="info-label">出发时间</text>
          <text class="info-value">{{order.departedAt || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">预计到达</text>
          <text class="info-value">{{order.estimatedArrivalAt || order.eta || '-'}}</text>
        </view>
      </block>
      <block wx:else>
        <view class="section-title">快递信息</view>
        <view class="info-row">
          <text class="info-label">快递公司</text>
          <text class="info-value">{{order.expressCompany}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">快递单号</text>
          <text class="info-value express-no">{{order.expressNo}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">包装/冷链</text>
          <text class="info-value">{{order.packageType || '-'}} · {{order.coldChainMethod || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">箱内温度</text>
          <text class="info-value">{{order.boxTemperature || order.temperature || '-'}}</text>
        </view>
      </block>
    </view>

    <!-- 底部按钮（待发货/备货中时显示） -->
    <view wx:if="{{order.status === 'pending' || order.status === 'preparing'}}" class="bottom-bar">
      <view wx:if="{{order.status === 'pending'}}" class="btn-scan" bindtap="onStartPreparing">
        <text>开始备货</text>
      </view>
      <view wx:if="{{!order.isUrgentBooking}}" class="btn-scan" bindtap="onScanTap">
        <text>扫码</text>
      </view>
      <view class="btn-submit" bindtap="onInputExpress">
        <text>{{order.isUrgentBooking ? '已出发' : '录入快递'}}</text>
      </view>
    </view>

  </view>

  <!-- 空状态 -->
  <view wx:elif="{{isLoading}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 快递录入面板 -->
  <view wx:if="{{showExpressPanel}}" class="express-panel">
    <view class="mask" bindtap="onClosePanel"></view>
    <view class="panel-content">
      <view class="panel-header">
        <text class="panel-title">选择快递公司</text>
        <view class="panel-close" bindtap="onClosePanel">
          <text>✕</text>
        </view>
      </view>

      <!-- 快递公司列表 -->
      <view class="company-grid">
        <view
          wx:for="{{expressCompanies}}"
          wx:key="index"
          class="company-item {{selectedCompany === item ? 'company-selected' : ''}}"
          data-company="{{item}}"
          bindtap="onSelectCompany"
        >
          <text>{{item}}</text>
        </view>
      </view>

      <!-- 单号输入 -->
      <view class="express-input-wrap">
        <input
          class="express-input"
          type="text"
          placeholder="请输入快递单号"
          value="{{expressNo}}"
          bindinput="onExpressNoInput"
        />
      </view>

      <view class="panel-section-title">包装类型</view>
      <view class="company-grid compact">
        <view
          wx:for="{{packageTypes}}"
          wx:key="index"
          class="company-item {{packageType === item ? 'company-selected' : ''}}"
          data-value="{{item}}"
          bindtap="onPackageTypeTap"
        >
          <text>{{item}}</text>
        </view>
      </view>

      <view class="panel-section-title">冷链方式</view>
      <view class="company-grid compact">
        <view
          wx:for="{{coldChainMethods}}"
          wx:key="index"
          class="company-item {{coldChainMethod === item ? 'company-selected' : ''}}"
          data-value="{{item}}"
          bindtap="onColdChainTap"
        >
          <text>{{item}}</text>
        </view>
      </view>

      <view class="cold-input-grid">
        <view class="cold-input-wrap">
          <text>包裹重量</text>
          <input placeholder="如 5.80kg" value="{{packageWeight}}" data-field="packageWeight" bindinput="onColdFieldInput" />
        </view>
        <view class="cold-input-wrap">
          <text>箱内温度</text>
          <input placeholder="如 3.2" value="{{boxTemperature}}" data-field="boxTemperature" bindinput="onColdFieldInput" />
        </view>
      </view>

      <view class="warm-tip">
        <text>温馨提示</text>
        <text>请确认液制品处于 2-6°C 冷链环境，发货前核对数量、规格、批号和有效期。</text>
      </view>

      <!-- 提交按钮 -->
      <view class="btn-submit-panel" bindtap="onSubmitExpress">
        <text>确认提交</text>
      </view>
    </view>
  </view>

  <!-- 加急线下配送面板 -->
  <view wx:if="{{showDirectPanel}}" class="express-panel">
    <view class="mask" bindtap="onClosePanel"></view>
    <view class="panel-content">
      <view class="panel-header">
        <text class="panel-title">加急配送出发</text>
        <view class="panel-close" bindtap="onClosePanel">
          <text>✕</text>
        </view>
      </view>

      <view class="warm-tip">
        <text>线下加急配送</text>
        <text>确认出发后，用户将看到制单员出发时间和预计到达时间。</text>
      </view>

      <view class="cold-input-grid">
        <view class="cold-input-wrap">
          <text>预计到达日期</text>
          <picker mode="date" value="{{etaDate}}" bindchange="onEtaDateChange">
            <view class="picker-value">{{etaDate || '请选择日期'}}</view>
          </picker>
        </view>
        <view class="cold-input-wrap">
          <text>预计到达时间</text>
          <picker mode="time" value="{{etaTime}}" bindchange="onEtaTimeChange">
            <view class="picker-value">{{etaTime || '请选择时间'}}</view>
          </picker>
        </view>
      </view>

      <view class="btn-submit-panel" bindtap="onSubmitDirectDelivery">
        <text>确认已出发</text>
      </view>
    </view>
  </view>

</view>
