.page {
  min-height: 100vh;
  padding: 22rpx;
  background: #f6f7f6;
  box-sizing: border-box;
}

.notify-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(22, 163, 74, 0.18);
  border-radius: 18rpx;
  background: #eaf8ef;
}

.bell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  background: #18a34a;
}

.notify-main {
  flex: 1;
  min-width: 0;
}

.notify-title {
  display: block;
  color: #139445;
  font-size: 30rpx;
  font-weight: 900;
}

.notify-desc {
  display: block;
  margin-top: 8rpx;
  color: #536b5a;
  font-size: 23rpx;
}

.notify-time {
  flex-shrink: 0;
  color: #7b8982;
  font-size: 21rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.summary-card {
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 45, 32, 0.05);
}

.summary-value {
  display: block;
  color: #139445;
  font-size: 32rpx;
  font-weight: 900;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  color: #17231f;
  font-size: 22rpx;
  font-weight: 800;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 66rpx;
  margin-top: 22rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.search-icon {
  color: #9ca6a1;
  font-size: 24rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
}

.filter {
  color: #17231f;
  font-size: 23rpx;
  font-weight: 800;
}

.tabs {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  overflow: hidden;
}

.tab {
  flex-shrink: 0;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  color: #68746e;
  font-size: 22rpx;
  font-weight: 700;
  background: #ffffff;
}

.tab.active {
  color: #139445;
  background: #e8f8ee;
}

.tab.urgent {
  color: #ff5a00;
  background: #fff2e8;
}

.order-list {
  margin-top: 20rpx;
}

.order-card {
  margin-bottom: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 45, 32, 0.05);
}

.order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.badge {
  display: inline-flex;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  background: #ff3b30;
}

.badge.exchange {
  background: #ff6a00;
}

.order-no {
  display: block;
  margin-top: 8rpx;
  color: #17231f;
  font-size: 29rpx;
  font-weight: 900;
}

.status {
  color: #ff5a00;
  font-size: 23rpx;
  font-weight: 900;
}

.status-preparing {
  color: #3b82f6;
}

.hospital-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
}

.pin {
  color: #18a34a;
  font-size: 20rpx;
}

.hospital {
  color: #17231f;
  font-size: 25rpx;
  font-weight: 900;
}

.address,
.booking-time {
  display: block;
  margin-top: 8rpx;
  color: #6d7872;
  font-size: 22rpx;
  line-height: 1.45;
}

.product-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #f8faf8;
}

.product-img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 14rpx;
  color: #b91c1c;
  font-size: 24rpx;
  font-weight: 900;
  background: #fff2f0;
  overflow: hidden;
}

.product-img image {
  width: 100%;
  height: 100%;
}

.product-main {
  flex: 1;
  min-width: 0;
}

.product-name {
  display: block;
  color: #17231f;
  font-size: 24rpx;
  font-weight: 900;
}

.product-spec {
  display: block;
  margin-top: 6rpx;
  color: #7d8983;
  font-size: 21rpx;
}

.cold-tag {
  flex-shrink: 0;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  color: #2f80ed;
  font-size: 19rpx;
  font-weight: 800;
  background: #eaf3ff;
}

.orange-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  margin-top: 18rpx;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  background: linear-gradient(180deg, #ff8a1f 0%, #ff5a00 100%);
}

.empty-state {
  padding: 160rpx 0;
  text-align: center;
}

.empty-text {
  display: block;
  color: #17231f;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-hint {
  display: block;
  margin-top: 10rpx;
  color: #8b9994;
  font-size: 24rpx;
}

/* 首页风格统一覆盖 */
.page {
  padding: 34rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #eef9f4 0%, #f7fbf8 48%, #ffffff 100%);
}

.notify-card,
.summary-card,
.search-row,
.order-card,
.empty-state {
  border: 1rpx solid #edf3ef;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(32, 98, 76, 0.08);
}

.notify-card {
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(226, 248, 237, 0.98) 0%, rgba(255, 255, 255, 0.98) 62%, rgba(255, 245, 229, 0.98) 100%);
}

.bell {
  width: 64rpx;
  height: 64rpx;
  background: #176f56;
  box-shadow: 0 10rpx 22rpx rgba(23, 111, 86, 0.18);
}

.notify-title,
.summary-value,
.pin {
  color: #176f56;
}

.notify-desc,
.address,
.booking-time,
.product-spec,
.empty-hint {
  color: #68776f;
}

.summary-grid {
  gap: 18rpx;
  margin-top: 22rpx;
}

.summary-card {
  padding: 24rpx 18rpx;
}

.summary-label,
.hospital,
.order-no,
.product-name,
.empty-text {
  color: #10291f;
}

.search-row {
  height: 76rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.search-icon {
  color: #9aac9f;
}

.filter {
  color: #176f56;
}

.tabs {
  gap: 16rpx;
  margin-top: 20rpx;
}

.tab {
  padding: 14rpx 22rpx;
  color: #60766c;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 18rpx rgba(32, 98, 76, 0.05);
}

.tab.active {
  color: #176f56;
  background: #e9f7ef;
}

.tab.urgent {
  color: #d85b3d;
  background: #fff2ec;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 22rpx;
}

.order-card {
  margin-bottom: 0;
  padding: 26rpx;
}

.badge {
  border-radius: 999rpx;
  background: #d85b3d;
}

.badge.exchange {
  background: #dc6a2c;
}

.status {
  padding: 6rpx 0;
  color: #d85b3d;
}

.status-preparing {
  color: #2f80ed;
}

.hospital-row {
  margin-top: 22rpx;
}

.product-row {
  border: 1rpx solid #edf3ef;
  border-radius: 22rpx;
  background: #f8fcf9;
}

.product-img {
  border-radius: 18rpx;
  background: #f1f8f4;
}

.product-img image {
  object-fit: cover;
}

.cold-tag {
  border-radius: 999rpx;
  color: #2f80ed;
  background: #edf5ff;
}

.orange-btn {
  min-height: 82rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #f1a24a 0%, #dc6a2c 100%);
  box-shadow: 0 14rpx 30rpx rgba(216, 91, 61, 0.18);
}

.empty-state {
  margin-top: 28rpx;
}
