<view class="page">
  <view class="notify-card">
    <view class="bell">铃</view>
    <view class="notify-main">
      <text class="notify-title">新任务指派</text>
      <text class="notify-desc">客服已为您指派新订单，请及时处理。</text>
    </view>
    <text class="notify-time">1 分钟前</text>
  </view>

  <view class="summary-grid">
    <view wx:for="{{summaryCards}}" wx:key="label" class="summary-card">
      <text class="summary-value">{{item.value}}</text>
      <text class="summary-label">{{item.label}}</text>
    </view>
  </view>

  <view class="search-row">
    <text class="search-icon">⌕</text>
    <input class="search-input" placeholder="搜索订单号 / 医院名称 / 客户名称" />
    <text class="filter">筛选</text>
  </view>

  <view class="tabs">
    <text class="tab active">全部 {{pendingCount}}</text>
    <text class="tab urgent">紧急 {{urgentCount}}</text>
    <text class="tab">今日预约 5</text>
    <text class="tab">待发货 9</text>
  </view>

  <view wx:if="{{isEmpty}}" class="empty-state">
    <text class="empty-text">暂无待处理订单</text>
    <text class="empty-hint">所有订单已处理完毕</text>
  </view>

  <view wx:else class="order-list">
    <view wx:for="{{orders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="onOrderTap">
      <view class="order-head">
        <view>
          <text class="badge {{item.type === 'exchange' ? 'exchange' : ''}}">{{item.badgeText}}</text>
          <text class="order-no">{{item.orderNo}}</text>
        </view>
        <text class="status">待发货</text>
      </view>

      <view class="hospital-row">
        <text class="pin">●</text>
        <text class="hospital">{{item.customerName}}</text>
      </view>
      <text class="address">{{item.address}}</text>
      <text class="booking-time">预约时间　2024-05-20 14:00</text>

      <view wx:for="{{item.items}}" wx:for-item="prod" wx:key="name" class="product-row">
        <view class="product-img">{{item.type === 'exchange' ? '换' : '血'}}</view>
        <view class="product-main">
          <text class="product-name">{{prod.name}}</text>
          <text class="product-spec">{{prod.specs}}　数量：{{prod.quantity}}</text>
        </view>
        <text class="cold-tag">冷链 2-6°C</text>
      </view>

      <view class="orange-btn">去处理</view>
    </view>
  </view>
</view>
