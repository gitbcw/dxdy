<view class="page">
  <!-- 成功图标区 -->
  <view class="success-hero">
    <image class="check-circle" src="{{successIcon}}" mode="aspectFit" />
    <text class="success-title">发货成功</text>
    <text class="order-no">订单号：{{orderNo}}</text>
  </view>

  <!-- 物流信息卡片 -->
  <view class="info-card">
    <view class="info-row">
      <text class="info-label">物流公司</text>
      <text class="info-value accent">{{expressCompany}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">物流单号</text>
      <view class="express-no-wrap">
        <text class="info-value mono">{{expressNo}}</text>
        <view class="copy-btn" bindtap="onCopyExpressNo">
          <text>复制</text>
        </view>
      </view>
    </view>
    <view class="info-row">
      <text class="info-label">包装类型</text>
      <text class="info-value">{{packageType || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">冷链方式</text>
      <text class="info-value">{{coldChainMethod || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">包裹重量</text>
      <text class="info-value">{{packageWeight || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">箱内温度</text>
      <text class="info-value accent">{{boxTemperature || '-'}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <view class="btn-primary" bindtap="onViewLogistics">
      <text>查看物流</text>
    </view>
    <view class="btn-outline" bindtap="onBackHome">
      <text>返回首页</text>
    </view>
  </view>
</view>
