<view class="page">
  <view class="wallet-head">
    <view>
      <text class="wallet-title">卡券钱包</text>
      <text class="wallet-desc">可用 {{availableCount}} 张 · 共 {{totalCount}} 张</text>
    </view>
  </view>

  <view class="tab-bar">
    <view wx:for="{{tabs}}" wx:key="key"
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}" bindtap="onTabChange">
      {{item.label}}
    </view>
  </view>

  <view class="card-list">
    <view wx:for="{{visibleCards}}" wx:key="id" class="card-item status-{{item.status}}" bindtap="onCardTap" data-id="{{item.id}}">
      <view class="card-header">
        <view class="card-title">
          <text class="card-product">{{item.productName}}</text>
        </view>
        <text class="card-status status-{{item.status}}">{{item.statusText}}</text>
      </view>

      <view class="amount-row">
        <view>
          <text class="amount-label">抵扣金额</text>
          <text class="amount-hint">结算时可用于抵扣</text>
        </view>
        <text class="amount-value">¥{{item.amountText}}</text>
      </view>

      <view class="meta-grid">
        <view wx:if="{{item.claimedAtText}}" class="meta-row">
          <text class="meta-label">领取时间</text>
          <text class="meta-value">{{item.claimedAtText}}</text>
        </view>
        <view wx:if="{{item.redeemedAtText}}" class="meta-row">
          <text class="meta-label">兑换时间</text>
          <text class="meta-value">{{item.redeemedAtText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{visibleCards.length === 0}}" class="empty">
      <text>暂无卡券</text>
    </view>
  </view>
</view>
