.page {
  min-height: 100vh;
  padding: 22rpx;
  background: #f6f7f6;
  box-sizing: border-box;
}

.profile-card,
.qrcode-card,
.link-card {
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 45, 32, 0.05);
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  background: #18a34a;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  color: #17231f;
  font-size: 30rpx;
  font-weight: 900;
}

.role {
  display: block;
  margin-top: 6rpx;
  color: #6d7872;
  font-size: 22rpx;
}

.id-pill {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #139445;
  font-size: 20rpx;
  font-weight: 900;
  background: #e8f8ee;
}

.qrcode-card {
  margin-top: 22rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid rgba(22, 163, 74, 0.16);
  text-align: center;
}

.card-title {
  display: block;
  color: #139445;
  font-size: 28rpx;
  font-weight: 900;
}

.qrcode-img {
  width: 390rpx;
  height: 390rpx;
  margin-top: 28rpx;
  border: 14rpx solid #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 12rpx 36rpx rgba(24, 45, 32, 0.08);
}

.qrcode-hint {
  display: block;
  margin-top: 18rpx;
  color: #6d7872;
  font-size: 22rpx;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 24rpx;
  border: 1rpx solid rgba(22, 163, 74, 0.12);
  border-radius: 14rpx;
  background: #f2faf4;
  overflow: hidden;
}

.stat {
  padding: 18rpx 8rpx;
  border-right: 1rpx solid rgba(22, 163, 74, 0.12);
}

.stat:last-child {
  border-right: 0;
}

.stat-label {
  display: block;
  color: #61916d;
  font-size: 20rpx;
  font-weight: 700;
}

.stat-value {
  display: block;
  margin-top: 6rpx;
  color: #17231f;
  font-size: 27rpx;
  font-weight: 900;
}

.link-card {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 22rpx;
}

.link-label {
  color: #69756f;
  font-size: 23rpx;
}

.link-text {
  min-width: 0;
  color: #17231f;
  font-size: 23rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.copy-btn {
  color: #139445;
  font-size: 23rpx;
  font-weight: 900;
}

.bottom-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(24, 45, 32, 0.08);
}

.ghost-btn,
.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.ghost-btn {
  color: #ff5a00;
  border: 1rpx solid rgba(255, 106, 0, 0.35);
  background: #ffffff;
}

.share-btn {
  color: #ffffff;
  border: none;
  background: linear-gradient(180deg, #ff8a1f 0%, #ff5a00 100%);
}

.share-btn::after {
  border: none;
}
