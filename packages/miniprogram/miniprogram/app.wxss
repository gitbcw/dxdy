/**app.wxss - 大熊动医定稿 UI Theme**/
/**Design: warm veterinary commerce, green trust + orange action**/

page {
  font-family: 'PingFang SC', 'SF Pro Display', -apple-system, sans-serif;
  font-size: 28rpx;
  color: #17231f;
  background: #f6f7f6;
}

/* ============ 色彩系统 ============ */
page {
  /* 主色系 - 定稿绿色 */
  --color-primary: #16a34a;
  --color-primary-light: #37c267;
  --color-primary-dark: #0b7f36;
  --color-primary-soft: #eaf8ef;

  /* 强调色 - 操作橙 */
  --color-accent: #ff6a00;
  --color-accent-light: #ff8a1f;
  --color-accent-dark: #e95300;
  --color-accent-soft: #fff3e8;

  /* 背景色 */
  --bg-page: #f6f7f6;
  --bg-card: #ffffff;
  --bg-section: #f3f6f4;
  --bg-hover: #eef7f0;

  /* 文字色 */
  --text-primary: #17231f;
  --text-secondary: #5d6964;
  --text-tertiary: #9aa39f;
  --text-inverse: #ffffff;

  /* 状态色 */
  --color-success: #16a34a;
  --color-warning: #f59e0b;
  --color-error: #ef4444;
  --color-info: #2f80ed;

  /* 价格色 */
  --color-price: #ff5a00;
  --color-price-light: #ff8a1f;

  /* 边框与分割 */
  --border-color: #e7ece8;
  --divider-color: #eff2f0;

  /* 阴影 - 简洁内敛 */
  --shadow-xs: 0 2rpx 6rpx rgba(28, 43, 36, 0.04);
  --shadow-sm: 0 8rpx 22rpx rgba(28, 43, 36, 0.06);
  --shadow-md: 0 14rpx 36rpx rgba(28, 43, 36, 0.08);
  --shadow-lg: 0 24rpx 56rpx rgba(28, 43, 36, 0.10);
  --shadow-xl: 0 32rpx 80rpx rgba(28, 43, 36, 0.12);

  /* 圆角 - 几何感 */
  --radius-sm: 8rpx;
  --radius-md: 14rpx;
  --radius-lg: 20rpx;
  --radius-xl: 28rpx;
  --radius-full: 9999rpx;

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-2xl: 48rpx;
}

/* ============ 全局页面容器 ============ */
.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ============ 通用组件 ============ */

/* 通用卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.card-soft {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--border-color);
}

/* 渐变背景 */
.gradient-primary {
  background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
}

.gradient-accent {
  background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-light) 100%);
}

/* 通用按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s ease;
}

.btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-primary {
  background: var(--color-primary);
  color: var(--text-inverse);
  box-shadow: var(--shadow-sm);
}

.btn-primary:active {
  background: var(--color-primary-dark);
  box-shadow: var(--shadow-md);
}

.btn-accent {
  background: linear-gradient(180deg, var(--color-accent-light) 0%, var(--color-accent) 100%);
  color: var(--text-inverse);
  box-shadow: 0 12rpx 28rpx rgba(255, 106, 0, 0.22);
}

.btn-outline {
  background: transparent;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
}

.btn-ghost {
  background: var(--bg-section);
  color: var(--text-primary);
}

/* 通用输入框 */
.input {
  background: var(--bg-section);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  transition: all 0.2s ease;
}

.input:focus {
  border-color: var(--color-primary);
  background: var(--bg-card);
  box-shadow: 0 0 0 4rpx rgba(10, 110, 124, 0.08);
}

.input::placeholder {
  color: var(--text-tertiary);
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  font-weight: 500;
}

.tag-primary {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.tag-accent {
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.tag-success {
  background: var(--color-primary-soft);
  color: var(--color-success);
}

.tag-warning {
  background: #fff7df;
  color: #d97706;
}

.dx-card {
  background: #ffffff;
  border: 1rpx solid rgba(22, 163, 74, 0.10);
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
}

.dx-orange-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  background: linear-gradient(180deg, #ff8a1f 0%, #ff5a00 100%);
  box-shadow: 0 12rpx 28rpx rgba(255, 106, 0, 0.22);
}

.dx-ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  border: 1rpx solid rgba(22, 163, 74, 0.35);
  border-radius: 18rpx;
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 800;
  background: #ffffff;
}

.dx-status-green {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.dx-status-orange {
  color: var(--color-accent);
  background: var(--color-accent-soft);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-tertiary);
}

.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
  /* 使用线性图标替代emoji */
}

.empty-state .icon::before {
  content: '📋';
  font-family: initial;
}

.empty-state .text {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.empty-state .hint {
  font-size: 26rpx;
  margin-top: 8rpx;
  opacity: 0.7;
}

/* ============ 动画 ============ */

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-16rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(16rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 动画类 - 克制、专业 */
.anim-fade-in { animation: fadeIn 0.3s ease forwards; }
.anim-fade-in-up { animation: fadeInUp 0.35s ease forwards; }
.anim-fade-in-down { animation: fadeInDown 0.3s ease forwards; }
.anim-slide-in-left { animation: slideInLeft 0.3s ease forwards; }
.anim-slide-in-right { animation: slideInRight 0.3s ease forwards; }
.anim-scale-in { animation: scaleIn 0.3s ease forwards; }

/* 交错动画延迟 - 更克制的延迟 */
.delay-1 { animation-delay: 0.05s; }
.delay-2 { animation-delay: 0.1s; }
.delay-3 { animation-delay: 0.15s; }
.delay-4 { animation-delay: 0.2s; }
.delay-5 { animation-delay: 0.25s; }
.delay-6 { animation-delay: 0.3s; }

/* ============ 分割线 ============ */

.divider {
  height: 1rpx;
  background: var(--divider-color);
}

.divider-soft {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--border-color), transparent);
}

/* ============ 工具类 ============ */

/* 文字省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Flex */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.gap-sm { gap: var(--space-sm); }
.gap-md { gap: var(--space-md); }
.gap-lg { gap: var(--space-lg); }
