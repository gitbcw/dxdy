.floating-actions {
  position: fixed;
  right: 22rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.float-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border: 1rpx solid rgba(255, 106, 0, 0.18);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 32rpx rgba(24, 45, 32, 0.16);
}

.float-btn.service {
  border-color: rgba(22, 163, 74, 0.18);
}

.float-icon {
  width: 54rpx;
  height: 54rpx;
}

.float-badge {
  position: absolute;
  top: -6rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 32rpx;
  font-weight: 900;
  text-align: center;
  background: #ef4444;
  box-sizing: border-box;
}
